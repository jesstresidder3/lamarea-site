---
/*
  Base layout for every page.

  <Base title="Places to Pause" description="..." headerTone="solid" jsonLd={schema}>
    ...page sections...
  </Base>

  Props
  - title, description: page title (the site name is appended) and meta description
  - canonical: path or URL, defaults to the current path
  - image, imageAlt: Open Graph image (path under public/)
  - ogType: 'website' (default) or 'article'
  - jsonLd: page schema, one object or an array. Organization is always included.
  - headerTone: 'over-media' when the page opens on a full-bleed hero (Hero, or MediaBand with `hero`):
    the header starts transparent with salt text and becomes the compact sand strip once the element
    marked data-hero has passed. 'solid' otherwise (sand strip, content starts below it). Default
    'solid'. The header never hides (build spec section 12).
  - noindex: true for the styleguide, thank-you and utility pages
  - stickyCta: kept for compatibility. Salt and Sun has no phone sticky bar: "Plan your day" lives in
    the header at every width (redesign direction, Phone)
  - dayTone: true on home, where the page ground drifts from morning salt to dusk sand on scroll

  Slots: default (inside <main>), 'head' (extra head tags), 'before-footer'.

  Serif body variant (build spec section 7): add ?body=serif to any URL to set body copy in the
  display serif at 17px; it persists for the session. ?body=sans switches back.
*/
import '../styles/base.css';
import Seo from '../components/layout/Seo.astro';
import Header from '../components/layout/Header.astro';
import Menu from '../components/layout/Menu.astro';
import Footer from '../components/layout/Footer.astro';
import Logo from '../components/layout/Logo.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  headerTone?: 'over-media' | 'solid' | 'immersive';
  noindex?: boolean;
  stickyCta?: boolean;
  mediaNotes?: 'on' | 'off';
  dayTone?: boolean;
  class?: string;
}

const {
  title,
  description,
  canonical,
  image,
  imageAlt,
  ogType,
  jsonLd,
  headerTone = 'solid',
  noindex = false,
  stickyCta = true,
  // Off by default so the site reads as a visitor sees it. Add ?notes=on to any URL to show
  // what belongs in each empty photo frame.
  mediaNotes = 'off',
  dayTone = false,
  class: bodyClass,
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<!doctype html>
<html lang="en-AU" data-media-notes={mediaNotes} data-header-tone={headerTone}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>if (/[?&]notes=on\b/.test(location.search)) document.documentElement.dataset.mediaNotes = 'on';</script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f8f3e4" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/hv-muse-regular.woff2" as="font" type="font/woff2" crossorigin />
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      imageAlt={imageAlt}
      ogType={ogType}
      noindex={noindex}
      jsonLd={jsonLd}
    />
    <script is:inline>
      // Serif body variant for the walkthrough with Belle. Runs before paint so nothing flashes.
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        // Motion gate: inner page titles wait for their line reveal, with a failsafe.
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.classList.add('mo');
          setTimeout(function () { root.classList.add('mo-fallback'); }, 2500);
        }
        // Arriving through the sand wipe: the panel starts over the page and lifts away (motion.css).
        try {
          if (sessionStorage.getItem('lm-wipe') === '1') { root.classList.add('wipe-in'); sessionStorage.removeItem('lm-wipe'); }
        } catch (e) {}
        try {
          var q = new URLSearchParams(location.search).get('body');
          if (q === 'serif' || q === 'sans') sessionStorage.setItem('lm-body', q);
          if (sessionStorage.getItem('lm-body') === 'serif') root.setAttribute('data-body', 'serif');
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body class:list={[bodyClass, dayTone && 'tone-day']}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header tone={headerTone === 'immersive' ? 'over-media' : headerTone} current={path} />
    <Menu current={path} />
    <main id="main" tabindex="-1" class:list={['site-main', `site-main--${headerTone}`]}>
      <slot />
    </main>
    <slot name="before-footer" />
    <Footer />
    <div class="page-wipe" aria-hidden="true"><Logo variant="lm" height="clamp(2.5rem, 5vw, 3.5rem)" class="page-wipe__mark" /></div>
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
