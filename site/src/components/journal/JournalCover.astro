---
/*
  JournalCover (L4 rebuild, 28-09-2026; calmed for Jess's J1 and G1 the same day).
  The journal opens with the latest story's photograph full bleed, and only the journal's name sits on
  it: the eyebrow on a small sand glass panel and the masthead on a sand glass title panel in sage
  (.on-media-panel, .on-media-panel--title, utilities.css), lower left. Everything else moves off the
  photograph onto sand beneath it: Belle's intro on the left, the latest story as one quiet link on the
  right (label, title, date and reading time). The photograph carries the site grade from Media.astro,
  so there is no filter, shade or text shadow here.

  Motion follows the P1 opener: the photograph washes up from the bottom edge and settles, the
  masthead rises in after it, the band beneath fades in. Reduced motion: static.
  P7: a story with no photograph gets a type-led cover on sand.

  <JournalCover post={featured} minutes={minutesOf(featured)} masthead="Wellness journal and recipes" />
*/
import Media from '../media/Media.astro';
import { media } from '../../data/media';
import { formatDate, plain } from '../../lib/text';
import type { Post } from '../../lib/content';

interface Props { post: Post; minutes?: number; masthead: string; eyebrow?: string; intro?: string }
const { post, minutes, masthead, eyebrow, intro } = Astro.props;
const d = post.data;
const hasPhoto = Boolean(media(d.hero).src);
// The cover carries the title's first clause only; the story page carries the whole title.
const coverTitle = plain(d.title).split(':')[0].trim();
---
<section class:list={['jcov', !hasPhoto && 'jcov--type']} aria-labelledby="jcov-masthead">
  <div class="jcov__frame">
    {hasPhoto && <div class="jcov__media" aria-hidden="true"><Media media={d.hero} aspect="fill" priority sizes="100vw" /></div>}
    <div class="jcov__words">
      {eyebrow && <p class:list={['jcov__eyebrow', hasPhoto && 'on-media-panel']}>{eyebrow}</p>}
      <h1 class:list={['jcov__masthead', hasPhoto && 'on-media-panel on-media-panel--title']} id="jcov-masthead">{masthead}</h1>
    </div>
  </div>

  <div class="jcov__band">
    <div class="wrap jcov__grid">
      {intro && <p class="jcov__intro">{intro}</p>}
      <a class="jcov__story" href={`/journal/${post.id}`}>
        <span class="jcov__k">The latest story</span>
        <span class="jcov__title">{coverTitle}</span>
        <span class="jcov__meta">
          <span><time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date)}</time>{minutes ? `, ${minutes} minute read` : ''}</span>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .jcov { position: relative; background: transparent; }
  .jcov__frame { position: relative; height: 78svh; min-height: 30rem; max-height: 56rem; overflow: hidden; background: var(--sand-40); }
  .jcov__media { position: absolute; inset: 0; }
  .jcov__words {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: clamp(1.75rem, 6svh, 3.5rem);
    z-index: 1;
    display: grid;
    justify-items: start;
    gap: 0.6rem;
  }
  .jcov__eyebrow { margin: 0; font-family: var(--font-editorial); font-style: italic; font-size: 1.125rem; line-height: 1.2; padding: 0.45rem 0.9rem 0.5rem; }
  .jcov__masthead { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: clamp(2.1rem, 1rem + 3.4vw, 4rem); line-height: 1.05; max-width: 13em; text-wrap: balance; }

  .jcov__band { padding: clamp(2.5rem, 5vw, 4.5rem) 0 clamp(1rem, 2vw, 1.5rem); }
  .jcov__grid { display: grid; gap: 2rem clamp(2rem, 6vw, 7.5rem); align-items: start; }
  @media (min-width: 900px) { .jcov__grid { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); } }
  .jcov__intro { margin: 0; max-width: 34rem; font-family: var(--font-serif); font-size: var(--fs-lead); line-height: 1.5; color: var(--sage-100); }
  .jcov__story { display: grid; gap: 0.55rem; padding-top: 1.1rem; border-top: 1px solid var(--rule); color: var(--sage-100); text-decoration: none; max-width: 30rem; }
  .jcov__k { font-family: var(--font-ui); font-size: var(--fs-label); letter-spacing: var(--track-label); color: var(--muted); }
  .jcov__title { font-family: var(--font-serif); font-size: clamp(1.35rem, 1.15rem + 0.6vw, 1.7rem); line-height: 1.22; color: var(--heading); text-wrap: balance; }
  .jcov__meta { display: flex; align-items: baseline; gap: 0.75rem; font-family: var(--font-editorial); font-style: italic; font-size: var(--fs-caption); color: var(--sage-80); }
  .jcov__meta::before { content: ''; width: 1.5rem; height: 1px; background: currentColor; opacity: 0.6; translate: 0 -0.3em; }
  .jcov__story:focus-visible { outline: 1.5px solid var(--focus); outline-offset: 6px; }
  @media (hover: hover) { .jcov__story:hover .jcov__title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; text-decoration-color: var(--sage-40); } }

  @media (max-width: 699px) {
    .jcov__frame { height: 70svh; min-height: 26rem; }
    .jcov__eyebrow { font-size: 1rem; }
  }

  /* No photograph: the masthead sits on sand in sage, no panels */
  .jcov--type .jcov__frame { height: auto; min-height: 0; max-height: none; background: transparent; padding: calc(var(--header-h) + clamp(2rem, 6svh, 4rem)) 0 0; }
  .jcov--type .jcov__words { position: static; padding: 0 var(--gutter); }
  .jcov--type .jcov__masthead { color: var(--heading); }
  .jcov--type .jcov__eyebrow { padding: 0; color: var(--sage-80); }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.mo) .jcov__frame { animation: jcov-tide 1400ms var(--ease-tide) both; }
    :global(html.mo) .jcov__media { animation: jcov-settle 2600ms var(--ease-settle) both; }
    :global(html.mo) .jcov__masthead { animation: jcov-rise 1300ms var(--ease-settle) 500ms both; }
    :global(html.mo) :is(.jcov__eyebrow, .jcov__band) { animation: jcov-fade 1100ms var(--ease-settle) 900ms both; }
  }
  @keyframes jcov-tide { from { clip-path: inset(100% 0 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes jcov-settle { from { scale: 1.06; } to { scale: 1; } }
  @keyframes jcov-rise { from { opacity: 0; translate: 0 0.4em; } to { opacity: 1; translate: 0 0; } }
  @keyframes jcov-fade { from { opacity: 0; } to { opacity: 1; } }
</style>
