---
/*
  The 8 hour day as a sticky split screen (Salt and Sun, signature features 6, 7 and 8).

  Belle's one real example day in her four beats, Arrive, Move, Nourish and Restore (data/day.ts).
  900px and wider: the left half sticks and holds the photograph for the current beat; each new
  photograph slides in from the right (Belle, T33: "It keeps, like, coming out from the right hand
  side"). The right half scrolls Belle's timetable. A hand-drawn wave line in sage 40 runs down the
  timetable and draws itself as you scroll, with each beat's time sitting on it (the tide line, in
  place of the old dotted stepper). The beat changes as its block crosses the centre of the screen.
  A soft tint over the photographs warms from morning salt at 7am to dusk sand at 5pm.
  Every line and every time is Belle's published schedule. Nothing is drafted here.

  Below 900px, or with reduced motion: a stack, photograph then timetable per beat, line drawn in full.
  Behaviour: src/scripts/pinned-day.ts.

  <PinnedDay />
  <PinnedDay seeFullDay={false} heading="The day in four parts" />
*/
import Media from '../media/Media.astro';
import ArrowLink from '../base/ArrowLink.astro';
import Eyebrow from '../base/Eyebrow.astro';
import { emphasis, withParams, numeral } from '../base/text';
import { day } from '../../data/day';
import { cta } from '../../data/settings';

interface Props {
  heading?: string;
  eyebrow?: string;
  seeFullDay?: boolean;
  /** false leaves the "Plan your day" pill out, for pages whose closing band carries it (home). */
  plan?: boolean;
  params?: Record<string, string | number | undefined>;
  id?: string;
}
const {
  heading = day.heading,
  eyebrow = 'The 8 hour day',
  seeFullDay = true,
  plan = true,
  params = { format: 'full-day' },
  id = 'the-day',
} = Astro.props;
const beats = day.beats;
const planHref = withParams(cta.plan.href, params);
// Beat tints, morning to dusk, all from Belle's palette (salt 100 to sand 100).
const tints = ['#e9e5d6', '#ece3c9', '#ead9b2', '#e6d6a4'];
---
<section class="dy" id={id} aria-labelledby={`${id}-heading`} data-pinned-day>
  <header class="wrap dy__head">
    <Eyebrow>{eyebrow}</Eyebrow>
    <h2 class="dy__heading" id={`${id}-heading`} set:html={emphasis(heading)} />
    <div class="dy__head-meta">
      <p class="dy__example">{day.example}</p>
      <p class="dy__note">{day.note}</p>
    </div>
  </header>

  <div class="dy__split">
    <div class="dy__stage" aria-hidden="true">
      <div class="dy__frame" data-dy-frame>
        {beats.map((b, i) => (
          <div class:list={['dy__photo', i === 0 && 'is-active']} data-dy-photo={i}>
            <Media media={b.media} aspect="fill" sizes="50vw" />
          </div>
        ))}
        <span class="dy__tint" data-dy-tint style={`--tint:${tints[0]}`}></span>
      </div>
      <p class="dy__stage-caption"><span data-dy-cap-name>{beats[0].name}</span>, <span data-dy-cap-time>{beats[0].railTime}</span></p>
    </div>

    <div class="dy__times">
      <svg class="dy__tide" viewBox="0 0 40 1000" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path class="dy__tide-base" d="M20 0 C 30 30, 30 70, 20 100 S 10 170, 20 200 S 30 270, 20 300 S 10 370, 20 400 S 30 470, 20 500 S 10 570, 20 600 S 30 670, 20 700 S 10 770, 20 800 S 30 870, 20 900 S 10 970, 20 1000" pathLength="1" />
        <path class="dy__tide-draw" data-dy-line d="M20 0 C 30 30, 30 70, 20 100 S 10 170, 20 200 S 30 270, 20 300 S 10 370, 20 400 S 30 470, 20 500 S 10 570, 20 600 S 30 670, 20 700 S 10 770, 20 800 S 30 870, 20 900 S 10 970, 20 1000" pathLength="1" />
      </svg>

      {beats.map((b, i) => (
        <article class="dy__beat" id={`${id}-${b.id}`} data-dy-beat={i} data-name={b.name} data-time={b.railTime} data-tint={tints[i]} aria-labelledby={`${id}-${b.id}-title`}>
          <div class="dy__beat-photo" aria-hidden="true"><Media media={b.media} aspect="4 / 5" sizes="92vw" /></div>
          <p class="dy__beat-time"><span class="dy__dot" aria-hidden="true"></span>{b.railTime}</p>
          <h3 class="dy__beat-name" id={`${id}-${b.id}-title`}><span class="dy__beat-num" aria-hidden="true">{numeral(i + 1)}</span>{b.name}</h3>
          <ol class="dy__steps" role="list">
            {b.steps.map((s) => (
              <li class="dy__step">
                <span class="dy__time">{s.time}</span>
                <span class="dy__what">
                  {s.display.map((line, j) => <span class:list={['dy__line', j > 0 && 'dy__line--sub']}>{line}</span>)}
                  {s.items && (
                    <span class="dy__items">
                      {s.items.map((it) => <span class="dy__item">{it}</span>)}
                    </span>
                  )}
                </span>
              </li>
            ))}
          </ol>
          {i === beats.length - 1 && (
            <div class="dy__end">
              <p class="dy__end-time"><span class="dy__dot" aria-hidden="true"></span>{day.railEnd}</p>
              <div class="dy__actions">
                {plan && <a class="btn-filled btn-filled--large" href={planHref} data-magnetic>{cta.plan.label}</a>}
                {seeFullDay && <ArrowLink href={cta.seeFullDay.href} label={cta.seeFullDay.label} />}
              </div>
              {plan && <p class="dy__call">{cta.callNote}</p>}
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import '../../scripts/pinned-day';
</script>

<style>
  .dy { position: relative; padding-block: var(--section-y); }

  .dy__head { display: grid; gap: 0; margin-bottom: clamp(3rem, 6vw, 6rem); }
  .dy__heading { margin: 0; font-size: var(--fs-section); line-height: 1.02; max-width: 11em; }
  .dy__head-meta { display: grid; gap: 0.35rem; margin-top: clamp(1.5rem, 3vw, 2.5rem); max-width: 30rem; }
  .dy__example { margin: 0; font-family: var(--font-ui); font-size: var(--fs-small); letter-spacing: 0.04em; color: var(--sage-80); }
  .dy__note { margin: 0; font-family: var(--font-editorial); font-style: italic; font-size: 1.1875rem; line-height: 1.45; color: var(--sage-100); }

  /* Phones and reduced motion: a stack. */
  .dy__split { position: relative; }
  .dy__stage { display: none; }
  .dy__times { position: relative; padding-inline: var(--gutter) var(--gutter); padding-left: calc(var(--gutter) + 2.25rem); }
  .dy__tide { position: absolute; left: calc(var(--gutter) - 0.35rem); top: 0; bottom: 0; width: 1.75rem; height: 100%; overflow: visible; }
  .dy__tide path { fill: none; vector-effect: non-scaling-stroke; stroke-linecap: round; }
  .dy__tide-base { stroke: color-mix(in srgb, var(--sage-40) 30%, transparent); stroke-width: 1; }
  .dy__tide-draw { stroke: var(--sage-40); stroke-width: 1.25; stroke-dasharray: 1; stroke-dashoffset: 0; }

  .dy__beat { position: relative; padding-bottom: clamp(3.5rem, 8vw, 6rem); }
  .dy__beat-photo { margin: 0 0 1.75rem; }
  .dy__beat-photo :global(.media) { border-radius: 0; }

  .dy__beat-time, .dy__end-time {
    position: relative;
    margin: 0 0 0.75rem;
    font-family: var(--font-editorial);
    font-size: 1.375rem;
    font-variant-numeric: oldstyle-nums;
    line-height: 1.2;
    color: var(--sage-80);
  }
  .dy__dot {
    position: absolute;
    left: calc(-2.25rem - 0.35rem + 0.875rem - 4px);
    top: 0.55em;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--page-tone, var(--sand-30));
    border: 1px solid var(--sage-40);
    transition: background-color 600ms var(--ease-settle), border-color 600ms var(--ease-settle);
  }
  .dy__beat.is-active .dy__dot, .dy__beat.is-past .dy__dot { background: var(--sand-100); border-color: var(--sage-60); }

  .dy__beat-name {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin: 0 0 1.75rem;
    font-size: var(--fs-place);
    line-height: 1;
  }
  .dy__beat-num { font-family: var(--font-ui); font-size: var(--fs-label); letter-spacing: 0.12em; color: var(--sage-80); translate: 0 -0.9em; }

  .dy__steps { margin: 0; padding: 0; list-style: none; display: grid; gap: 1.1rem; max-width: 34rem; }
  .dy__step { display: grid; grid-template-columns: 4.75rem minmax(0, 1fr); gap: 0 1rem; }
  .dy__time {
    font-family: var(--font-editorial);
    font-size: 1.125rem;
    line-height: 1.4;
    font-variant-numeric: oldstyle-nums;
    color: var(--sage-80);
  }
  .dy__what { display: grid; gap: 0.2rem; font-size: 0.96875rem; line-height: 1.6; color: var(--sage-100); }
  .dy__line--sub { font-size: var(--fs-small); color: var(--sage-80); }
  .dy__items { display: grid; gap: 0.1rem; margin-top: 0.35rem; font-size: var(--fs-small); color: var(--sage-80); }
  .dy__item::before { content: ''; display: inline-block; width: 0.9rem; height: 1px; margin: 0 0.6rem 0.25em 0; background: var(--sage-40); vertical-align: middle; }

  .dy__end { margin-top: clamp(3rem, 6vw, 5rem); }
  .dy__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2.25rem; margin-top: 1.5rem; }
  .dy__call { margin: 1.25rem 0 0; font-size: var(--fs-small); color: var(--sage-80); max-width: 26rem; }

  /* 900px and up with motion: the sticky split. */
  @media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
    .dy__split {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(3rem, 6vw, 7rem);
      padding-right: var(--gutter);
    }
    .dy__stage {
      display: block;
      position: sticky;
      top: calc(var(--header-compact) + 3svh);
      height: calc(100svh - var(--header-compact) - 9svh);
      align-self: start;
    }
    .dy__frame { position: relative; height: calc(100% - 2.75rem); overflow: hidden; background: var(--sand-40); }
    .dy__photo {
      position: absolute;
      inset: 0;
      clip-path: inset(0 0 0 100%);
      transition: clip-path 1100ms var(--ease-tide);
    }
    .dy__photo :global(img), .dy__photo :global(video) { scale: 1.08; transition: scale 1600ms var(--ease-settle); }
    .dy__photo.is-active { clip-path: inset(0 0 0 0); z-index: 1; }
    .dy__photo.is-active :global(img), .dy__photo.is-active :global(video) { scale: 1; }
    .dy__photo.is-leaving { clip-path: inset(0 0 0 0); z-index: 0; }
    .dy__tint {
      position: absolute;
      inset: 0;
      z-index: 2;
      background: var(--tint);
      mix-blend-mode: soft-light;
      opacity: 0.55;
      transition: background-color 900ms var(--ease-settle);
      pointer-events: none;
    }
    .dy__stage-caption {
      margin: 0.85rem 0 0;
      font-family: var(--font-editorial);
      font-style: italic;
      font-size: var(--fs-caption);
      font-variant-numeric: oldstyle-nums;
      color: var(--sage-80);
    }

    .dy__times { padding: 0 0 0 3.5rem; }
    .dy__tide { left: 0; width: 2rem; }
    .dy__dot { left: calc(-3.5rem + 1rem - 4px); }
    .dy__beat { min-height: 88svh; padding-block: 12svh; display: grid; align-content: center; }
    .dy__beat:first-of-type { padding-top: 4svh; align-content: start; min-height: 80svh; }
    .dy__head { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); column-gap: 4rem; align-items: end; }
    .dy__head :global(.eyebrow) { grid-column: 1 / -1; }
    .dy__head-meta { margin: 0 0 0.6rem; }
    .dy__beat-photo { display: none; }
    /* Each beat's words slide in from the right as they arrive, then stay put. */
    :global(html.js) .dy__beat > :not(.dy__beat-photo) { transition: opacity 1000ms var(--ease-settle), translate 1200ms var(--ease-settle); }
    :global(html.js) .dy__beat:not(.is-in) > :not(.dy__beat-photo) { opacity: 0; translate: 4rem 0; }
    :global(html.js) .dy__beat.is-in > :nth-child(3) { transition-delay: 80ms; }
    :global(html.js) .dy__beat.is-in > :nth-child(4) { transition-delay: 160ms; }
    :global(html.js) .dy__beat.is-in > :nth-child(5) { transition-delay: 240ms; }
  }
</style>
