---
/*
  Site header (build spec section 3 as revised by section 12, visual study B5).
  Logo centred. Left: Private groups, Corporate, The 8 hour day. Right: Experiences, Places to Pause,
  then Menu and the one filled "Plan your day". Everything else lives in the menu.
  Over a full-bleed hero it is transparent with salt text; after the hero it becomes a compact sand
  strip with sage text and a hairline, and it stays (it never hides, like Aman's).
  Below 1180px the links fold into the menu: logo left, "Plan your day" and Menu right.
  Phones (under 760px): logo and Menu only; "Plan your day" lives in the sticky bottom bar.
  The funnel (/enquire and /enquire/thank-you) gets a minimal header: the logo and one quiet exit link,
  no navigation, no Menu and no second "Plan your day" (plan/11 4.23 section 1).
  Behaviour: src/scripts/header.ts. Used by layouts/Base.astro only.
*/
import Logo from './Logo.astro';
import { navLeft, navRight, cta } from '../../data/settings';

interface Props {
  tone?: 'over-media' | 'solid';
  current?: string;
}
const { tone = 'solid', current = '/' } = Astro.props;

const isCurrent = (href: string) => current === href || (href !== '/' && current.startsWith(href + '/'));
const minimal = current.startsWith('/enquire');
---
<header class:list={['site-header', minimal && 'site-header--minimal']} data-site-header data-state={tone === 'over-media' ? 'over' : 'solid'}>
  <nav class="hdr" aria-label={minimal ? 'Site' : 'Primary'}>
    {minimal ? <span class="hdr__spacer" aria-hidden="true"></span> : (
      <ul class="hdr__links hdr__links--left" role="list">
        {navLeft.map((l) => (
          <li><a class="hdr__link" href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    )}

    <a class="hdr__logo" href="/" aria-label="La maréa, home" aria-current={current === '/' ? 'page' : undefined}>
      <Logo variant="primary" height="var(--logo-h)" label="La maréa" />
    </a>

    {minimal ? (
      <div class="hdr__right hdr__right--minimal">
        <a class="hdr__link hdr__exit" href="/">Back to La maréa</a>
      </div>
    ) : (
    <div class="hdr__right">
      <ul class="hdr__links hdr__links--right" role="list">
        {navRight.map((l) => (
          <li><a class="hdr__link" href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
      <div class="hdr__actions">
        <button class="menu-toggle" type="button" data-menu-open aria-controls="site-menu" aria-expanded="false" aria-haspopup="dialog">
          <span class="menu-toggle__label">Menu</span>
          <span class="menu-toggle__lines" aria-hidden="true"><span></span><span></span></span>
        </button>
        <a class="btn-filled hdr__cta" href={cta.plan.href} aria-current={current.startsWith('/enquire') ? 'page' : undefined}>{cta.plan.label}</a>
      </div>
    </div>
    )}
  </nav>
</header>

<script>
  import '../../scripts/header';
</script>

<style>
  .site-header {
    --logo-h: clamp(1.375rem, 1.1rem + 0.9vw, 2rem);
    --hdr-ink: var(--sage-80);
    --hdr-gutter: clamp(1.25rem, 2.6vw, 2.5rem);
    --hdr-h: var(--header-h);
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-header);
    height: var(--hdr-h);
    padding-right: var(--sbw, 0px);
    color: var(--hdr-ink);
    background-color: color-mix(in srgb, var(--sand-30) 97%, transparent);
    border-bottom: 1px solid var(--sage-20);
    transition:
      height var(--dur) var(--ease-soft),
      background-color var(--dur) var(--ease-soft),
      border-color var(--dur) var(--ease-soft),
      color var(--dur) var(--ease-soft);
  }
  /* Compact strip once the page has moved (after the hero on over-media pages). */
  .site-header.is-compact {
    --hdr-h: var(--header-compact);
    --logo-h: clamp(1.25rem, 1.05rem + 0.6vw, 1.625rem);
  }
  /* Over the hero: transparent, salt text. A soft gradient at the very top keeps the words legible on
     bright sky without darkening the footage (no full-frame scrim, build spec section 12). */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 -40% 0;
    background: linear-gradient(to bottom, rgb(35 32 14 / 0.22), rgb(35 32 14 / 0));
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur) var(--ease-soft);
  }
  .site-header[data-state='over'] {
    --hdr-ink: var(--salt-25);
    --focus: var(--focus-on-dark);
    background-color: transparent;
    border-bottom-color: transparent;
  }
  .site-header[data-state='over']::before { opacity: 1; }
  /* While the page's hero still shows its light placeholder, the header keeps sage ink over it and
     drops the top gradient (QA M3). Belle's footage brings back the salt state above. */
  :global(html:has([data-hero] .media--placeholder)) .site-header[data-state='over'] { --hdr-ink: var(--sage-100); --focus: var(--sage-80); }
  :global(html:has([data-hero] .media--placeholder)) .site-header[data-state='over']::before { opacity: 0; }

  .hdr {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 100%;
    max-width: 1920px;
    margin-inline: auto;
    padding-inline: var(--hdr-gutter);
  }
  .hdr__logo {
    margin-right: auto;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: inherit;
  }
  .hdr__logo :global(.lm-logo) { transition: height var(--dur) var(--ease-soft); }
  .hdr__links { display: none; margin: 0; padding: 0; list-style: none; }
  .hdr__right, .hdr__actions { display: flex; align-items: center; gap: clamp(0.75rem, 1.4vw, 1.5rem); }

  /* Menu control: a quiet word and two hairlines. 44px target. */
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 2.75rem;
    min-width: 2.75rem;
    padding: 0 0.25rem;
    border: 0;
    background: none;
    color: inherit;
    font-family: var(--font-ui);
    font-size: var(--fs-nav);
    letter-spacing: var(--track-nav);
    -webkit-tap-highlight-color: transparent;
  }
  .menu-toggle__lines { display: grid; gap: 6px; width: 22px; justify-items: end; }
  .menu-toggle__lines span {
    display: block;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform-origin: right center;
    transition: transform var(--dur-fast) var(--ease-soft);
  }
  .menu-toggle__lines span:last-child { width: 70%; }
  @media (hover: hover) {
    .menu-toggle:hover .menu-toggle__lines span:last-child { transform: scaleX(1.43); }
  }
  .menu-toggle:active .menu-toggle__lines span:last-child { transform: scaleX(1.43); }

  .hdr__cta { min-height: 2.5rem; padding-inline: 1rem; }

  /* Minimal funnel header: the logo and one exit link. */
  .hdr__spacer { display: none; }
  .hdr__right--minimal { justify-content: flex-end; }

  /* Links: a hairline draws in from the left on hover; the current page keeps a quieter one. */
  .hdr__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: inherit;
    font-family: var(--font-ui);
    font-size: var(--fs-nav);
    letter-spacing: var(--track-nav);
    text-decoration: none;
    white-space: nowrap;
  }
  .hdr__link::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: 0.7rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--dur-fast) var(--ease-soft);
  }
  .hdr__link[aria-current='page']::after { transform: scaleX(1); opacity: 0.55; }
  @media (hover: hover) {
    .hdr__link:hover::after { transform: scaleX(1); opacity: 1; }
  }

  /* Phones: logo and Menu only. "Plan your day" is the sticky bottom bar. */
  @media (max-width: 759px) {
    .hdr__cta { display: none; }
  }

  /* Wide: logo centred, three links hugging it on the left, two on the right, then Menu and the
     one filled element at the far right. */
  @media (min-width: 1180px) {
    .hdr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      gap: clamp(1.75rem, 2.4vw, 3rem);
    }
    .hdr__links { display: flex; gap: clamp(1.1rem, 1.6vw, 2rem); }
    .hdr__links--left { justify-content: flex-end; }
    .hdr__logo { margin: 0; }
    .hdr__right { justify-content: space-between; min-width: 0; }
    .hdr__spacer { display: block; }
    .hdr__right--minimal { justify-content: flex-end; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header, .site-header::before, .hdr__link::after, .menu-toggle__lines span, .hdr__logo :global(.lm-logo) { transition: none; }
  }
</style>
