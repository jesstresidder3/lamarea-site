---
/*
  Site header, Salt and Sun (redesign direction, Header).
  Rebuild round 1 (28-09-2026, art review): three things only, at every width. Menu (the lines and
  the word) at the far left, the La maréa wordmark centred, the "Plan your day" pill at the far right.
  The open menu carries every link, so the header no longer reads as a nav bar before the photograph.
  Over a full-bleed opening (home, or any page whose <main> starts with a P1 PageOpener) the header is
  clear with salt ink at the top of the page.
  Always sage ink on light ground: no type is ever set over a photograph, so there is no transparent
  salt-text state any more. At the top of a page the header is clear over salt; once the page moves
  it becomes a salt strip with a hairline, hides on scroll down and returns on scroll up (500ms).
  Phones: Menu, the wordmark and a compact "Plan your day" pill. There is no sticky bottom bar.
  The funnel (/enquire) keeps a minimal header: the wordmark and one quiet exit link.
  Behaviour: src/scripts/header.ts.
*/
import Logo from './Logo.astro';
import { cta } from '../../data/settings';

interface Props {
  tone?: 'over-media' | 'solid';
  current?: string;
}
const { current = '/' } = Astro.props;

const minimal = current.startsWith('/enquire');
---
<header class:list={['site-header', minimal && 'site-header--minimal']} data-site-header data-state="top">
  <nav class="hdr" aria-label={minimal ? 'Site' : 'Primary'}>
    <div class="hdr__side hdr__side--left">
      {!minimal && (
        <button class="menu-toggle" type="button" data-menu-open aria-controls="site-menu" aria-expanded="false" aria-haspopup="dialog">
          <span class="menu-toggle__lines" aria-hidden="true"><span></span><span></span></span>
          <span class="menu-toggle__label">Menu</span>
        </button>
      )}
    </div>

    <a class="hdr__logo" href="/" aria-label="La maréa, home" aria-current={current === '/' ? 'page' : undefined}>
      <Logo variant="primary" height="var(--logo-h)" label="La maréa" />
    </a>

    <div class="hdr__side hdr__side--right">
      {minimal ? (
        <a class="hdr__link hdr__exit" href="/">Back to La maréa</a>
      ) : (
        <>
          <a class="btn-filled hdr__cta" href={cta.plan.href} data-magnetic aria-current={current.startsWith('/enquire') ? 'page' : undefined}>{cta.plan.label}</a>
        </>
      )}
    </div>
  </nav>
</header>

<script>
  import '../../scripts/header';
</script>

<style>
  .site-header {
    --logo-h: clamp(1.25rem, 1rem + 0.9vw, 1.9rem);
    --hdr-gutter: clamp(1rem, 3vw, 3rem);
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-header);
    height: var(--header-h);
    padding-right: var(--sbw, 0px);
    color: var(--sage-80);
    background-color: transparent;
    border-bottom: 1px solid transparent;
    transition:
      translate 600ms var(--ease-tide),
      height 500ms var(--ease-settle),
      background-color 500ms var(--ease-settle),
      border-color 500ms var(--ease-settle);
  }
  .site-header[data-state='strip'],
  .site-header[data-state='hidden'] {
    height: var(--header-compact);
    --logo-h: clamp(1.125rem, 0.95rem + 0.6vw, 1.5rem);
    background-color: color-mix(in srgb, var(--salt-25) 90%, transparent);
    border-bottom-color: color-mix(in srgb, var(--sage-40) 28%, transparent);
    backdrop-filter: blur(10px) saturate(1.05);
    -webkit-backdrop-filter: blur(10px) saturate(1.05);
  }
  .site-header[data-state='hidden'] { translate: 0 -105%; }
  .site-header:focus-within { translate: 0 0; }

  .hdr {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    height: 100%;
    max-width: 1920px;
    margin-inline: auto;
    padding-inline: var(--hdr-gutter);
  }
  .hdr__side { display: flex; align-items: center; gap: clamp(1.1rem, 1.8vw, 2.25rem); min-width: 0; }
  .hdr__side--right { justify-content: flex-end; }
  .hdr__logo {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--sage-80);
  }
  .hdr__logo :global(.lm-logo) { transition: height 500ms var(--ease-settle); }
  .hdr__links { display: none; margin: 0; padding: 0; list-style: none; gap: clamp(1.1rem, 1.8vw, 2.25rem); }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    min-width: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font-family: var(--font-ui);
    font-size: var(--fs-nav);
    letter-spacing: var(--track-nav);
    -webkit-tap-highlight-color: transparent;
  }
  .menu-toggle__lines { display: grid; gap: 6px; width: 24px; }
  .menu-toggle__lines span {
    display: block;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform-origin: left center;
    transition: transform 400ms var(--ease-settle);
  }
  .menu-toggle__lines span:last-child { width: 62%; }
  @media (hover: hover) {
    .menu-toggle:hover .menu-toggle__lines span:last-child { transform: scaleX(1.6); }
  }

  .hdr__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: inherit;
    font-family: var(--font-ui);
    font-size: var(--fs-nav);
    letter-spacing: var(--track-nav);
    text-decoration: none;
    white-space: nowrap;
  }
  .hdr__link::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: 0.72rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 400ms var(--ease-settle);
  }
  .hdr__link[aria-current='page']::after { transform: scaleX(1); opacity: 0.45; }
  @media (hover: hover) {
    .hdr__link:hover::after { transform: scaleX(1); opacity: 1; }
  }

  .hdr__cta { min-height: 2.5rem; padding-inline: 1.15rem; }
  .hdr__cta::after { left: 1.15rem; right: 1.15rem; }

  /* Phones: the word Menu stays beside the lines (the IA decision), the pill gets smaller. */
  @media (max-width: 419px) {
    .menu-toggle { gap: 0.55rem; font-size: 0.75rem; }
    .menu-toggle__lines { width: 20px; }
    .hdr__cta { min-height: 2.375rem; padding-inline: 0.85rem; font-size: 0.75rem; letter-spacing: 0.05em; }
    .hdr__cta::after { left: 0.85rem; right: 0.85rem; }
  }


  /* Home opens full bleed under the header (headerTone 'immersive'): at the very top the header is
     clear, with salt ink over the photograph. The pill stays sand, as everywhere. */
  :global(html[data-header-tone='immersive']) .site-header[data-state='top'],
  :global(html[data-header-tone='immersive']) .site-header[data-state='top'] .hdr__logo,
  :global(html:has(main > [data-page-opener]:first-child)) .site-header[data-state='top'],
  :global(html:has(main > [data-page-opener]:first-child)) .site-header[data-state='top'] .hdr__logo {
    color: var(--on-image);
    text-shadow: 0 1px 14px rgb(20 50 64 / 0.3);
  }
  :global(html[data-header-tone='immersive']) .site-header[data-state='top'],
  :global(html:has(main > [data-page-opener]:first-child)) .site-header[data-state='top'] {
    background: linear-gradient(to bottom, rgb(20 50 64 / 0.18), rgb(20 50 64 / 0));
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header, .hdr__link::after, .menu-toggle__lines span, .hdr__logo :global(.lm-logo) { transition: none; }
  }
</style>
