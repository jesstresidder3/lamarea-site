---
/*
  Full-screen menu with photo previews, Salt and Sun (signature feature 14).
  A salt sheet wipes down from the top (800ms tide ease). The links sit in the left column in
  HV Muse, one list; hovering or focusing a link crossfades its photograph into a large arch on the
  right. Contact and the one "Plan your day" pill sit at the foot. Locks scroll without layout shift,
  traps focus, closes on Escape, returns focus to the Menu control. Behaviour: src/scripts/menu.ts.

  Data (settings.ts, owned by the UX builder): `menuTree` (items with optional `children` and `media`),
  otherwise `menuPrimary` as the large links and `menuGroups` as the quieter list. Links without a
  `media` slot preview their page's opening photograph (PREVIEW below).
*/
import Logo from './Logo.astro';
import Media from '../media/Media.astro';
import * as settings from '../../data/settings';
import type { NavLink } from '../../data/settings';

type Item = NavLink & { children?: NavLink[] };
const s = settings as unknown as Record<string, unknown>;
const { cta, contact, social } = settings;

interface Props { current?: string }
const { current = '/' } = Astro.props;
const isCurrent = (href: string) => current === href || (href !== '/' && current.startsWith(href + '/'));

const tree = (Array.isArray(s.menuTree) ? s.menuTree : Array.isArray(s.menuList) ? s.menuList : null) as Item[] | null;
// A photograph for every link, so the arch always has something to show. The UX data can set `media`
// on any item; otherwise the page's own opening photograph is used.
const PREVIEW: Record<string, string> = {
  '/': 'menu-default',
  '/retreats': 'menu-the-day',
  '/private-groups': 'menu-private-groups',
  '/corporate': 'menu-corporate',
  '/experiences/full-day-retreat': 'day-hero',
  '/experiences': 'experiences-hero',
  '/food': 'food-hero',
  '/places': 'places-hero',
  '/our-story': 'story-hero',
  '/philosophy': 'philosophy-hero',
  '/team': 'team-hero',
  '/journal': 'journal-poke-bowl',
  '/faqs': 'faqs-intro',
  '/gift-cards': 'giftcards-intro',
};
const withMedia = <T extends NavLink>(l: T): T => ({ ...l, media: l.media ?? PREVIEW[l.href.split('#')[0]] ?? 'menu-default' });
const list: Item[] = (tree ?? (settings.menuPrimary as Item[])).map((l) => ({ ...withMedia(l), children: l.children?.map(withMedia) }));
const secondary: NavLink[] = tree ? [] : (settings.menuGroups ?? []).flatMap((g) => g.links);

const figures = Array.from(new Set(['menu-default', ...list.flatMap((l) => [l.media, ...(l.children ?? []).map((c) => c.media)]).filter(Boolean)])) as string[];
let n = 0;
---
<div class="menu" id="site-menu" role="dialog" aria-modal="true" aria-label="Site menu" data-menu data-state="closed" inert>
  <div class="menu__sheet">
    <div class="menu__top">
      <button class="menu__close" type="button" data-menu-close>
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d="M2 2l12 12M14 2L2 14" /></svg>
        <span>Close</span>
      </button>
      <a class="menu__home" href="/" aria-label="La maréa, home"><Logo variant="primary" height="clamp(1.25rem, 1rem + 0.9vw, 1.9rem)" label="La maréa" /></a>
      <span aria-hidden="true"></span>
    </div>

    <nav class="menu__nav" aria-label="Menu">
      <ul class="menu__list" role="list">
        {list.map((l) => (
          <li class="menu__item" style={`--i:${n++}`}>
            <a class="menu__link" href={l.href} data-menu-media={l.media} aria-current={isCurrent(l.href) ? 'page' : undefined}>
              <span class="menu__link-text">{l.label}</span>
            </a>
            {l.children && l.children.length > 0 && (
              <ul class="menu__children" role="list">
                {l.children.map((c) => (
                  <li><a class="menu__child" href={c.href} data-menu-media={c.media} aria-current={isCurrent(c.href) ? 'page' : undefined}>{c.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>

      {secondary.length > 0 && (
        <ul class="menu__secondary" role="list" style={`--i:${n++}`}>
          {secondary.map((l) => (
            <li><a class="menu__child" href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
          ))}
        </ul>
      )}

      <div class="menu__foot" style={`--i:${n++}`}>
        <a class="btn-filled menu__cta" href={cta.plan.href}>{cta.plan.label}</a>
        <ul class="menu__contact" role="list" aria-label="Contact">
          {contact.emails.map((e) => <li><a href={`mailto:${e.address}`}>{e.address}</a></li>)}
          <li><a href={social.instagram.url} target="_blank" rel="noopener">Instagram<span class="visually-hidden"> (opens in a new tab)</span></a></li>
        </ul>
      </div>
    </nav>

    <div class="menu__media" aria-hidden="true">
      <div class="menu__arch">
        {figures.map((slot, i) => (
          <div class:list={['menu__figure', i === 0 && 'is-active']} data-menu-figure={slot}>
            <Media media={slot} aspect="fill" sizes="40vw" />
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  import '../../scripts/menu';
</script>

<style>
  .menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-menu);
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0s linear 800ms;
  }
  .menu[data-state='open'] { visibility: visible; pointer-events: auto; transition: visibility 0s; }
  .menu__sheet {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--salt-25);
    color: var(--sage-100);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 800ms var(--ease-tide);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr;
  }
  .menu[data-state='open'] .menu__sheet { clip-path: inset(0 0 0 0); transition: clip-path 800ms var(--ease-tide); }

  .menu__top {
    position: sticky;
    top: 0;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    height: var(--header-h);
    padding-inline: clamp(1rem, 3vw, 3rem);
    background: var(--salt-25);
    color: var(--sage-80);
  }
  .menu__home { display: inline-flex; align-items: center; min-height: 2.75rem; color: inherit; }
  .menu__close {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font-family: var(--font-ui);
    font-size: var(--fs-nav);
    letter-spacing: var(--track-nav);
  }
  .menu__close svg { width: 15px; height: 15px; transition: rotate 500ms var(--ease-settle); }
  .menu__close path { fill: none; stroke: currentColor; stroke-width: 1; vector-effect: non-scaling-stroke; stroke-linecap: round; }
  @media (hover: hover) { .menu__close:hover svg { rotate: 90deg; } }

  .menu__nav {
    display: grid;
    align-content: start;
    gap: clamp(2rem, 5vh, 3.5rem);
    padding: clamp(1.5rem, 5vh, 3rem) var(--gutter) clamp(2.5rem, 6vh, 4rem);
  }
  .menu__list { margin: 0; padding: 0; list-style: none; display: grid; gap: 0; }
  .menu__link { min-height: 3rem; }
  .menu__item, .menu__secondary, .menu__foot {
    opacity: 0;
    translate: 0 1.25rem;
    transition: opacity 600ms var(--ease-settle), translate 900ms var(--ease-settle);
  }
  .menu[data-state='open'] :is(.menu__item, .menu__secondary, .menu__foot) {
    opacity: 1;
    translate: 0 0;
    transition-delay: calc(280ms + var(--i, 0) * 60ms);
  }
  .menu__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--sage-80);
    text-decoration: none;
  }
  .menu__link-text {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 1.2rem + 1.9vw, 2.875rem);
    line-height: 1.12;
    letter-spacing: 0.005em;
    transition: translate 500ms var(--ease-settle), color 400ms var(--ease-settle);
  }
  .menu__link[aria-current='page'] .menu__link-text { font-style: italic; }
  @media (hover: hover) {
    .menu__link:hover .menu__link-text { translate: 0.5rem 0; color: var(--sage-100); }
    .menu__list:hover .menu__link:not(:hover) .menu__link-text { color: var(--sage-60); }
  }
  .menu__link:focus-visible .menu__link-text { translate: 0.5rem 0; }

  .menu__children, .menu__secondary {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.75rem;
  }
  .menu__children { padding: 0 0 0.5rem 0.15rem; }
  .menu__secondary { max-width: 34rem; padding-top: 1.25rem; border-top: 1px solid var(--rule); }
  .menu__child {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-family: var(--font-ui);
    font-size: var(--fs-small);
    letter-spacing: 0.02em;
    color: var(--sage-100);
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 calc(100% - 0.7rem) / 0% 1px no-repeat;
    transition: background-size 400ms var(--ease-settle);
  }
  .menu__child[aria-current='page'] { background-size: 100% 1px; }
  @media (hover: hover) { .menu__child:hover { background-size: 100% 1px; } }

  .menu__foot { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; }
  .menu__contact { display: flex; flex-wrap: wrap; gap: 0 1.5rem; margin: 0; padding: 0; list-style: none; }
  .menu__contact a {
    display: inline-flex; align-items: center; min-height: 2.75rem;
    font-family: var(--font-ui); font-size: var(--fs-small); color: var(--sage-80);
    text-decoration: none; overflow-wrap: anywhere;
  }
  @media (hover: hover) { .menu__contact a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.3em; } }

  .menu__media { display: none; }

  @media (min-width: 1024px) {
    .menu__sheet { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); grid-template-rows: auto 1fr; }
    .menu__top { grid-column: 1 / -1; }
    .menu__nav { align-content: center; padding-block: 2vh 5vh; padding-right: 2rem; }
    .menu__media {
      display: grid;
      place-items: center;
      padding: 2vh var(--gutter) 6vh 0;
    }
    .menu__arch {
      position: relative;
      width: min(100%, 34rem);
      height: min(72svh, 44rem);
      border-radius: var(--arch);
      overflow: hidden;
      background: var(--sand-40);
      clip-path: inset(100% 0 0 0 round 999px 999px 0 0);
      transition: clip-path 1100ms var(--ease-tide) 200ms;
    }
    .menu[data-state='open'] .menu__arch { clip-path: inset(0 0 0 0 round 999px 999px 0 0); }
    .menu__figure {
      position: absolute;
      inset: 0;
      opacity: 0;
      scale: 1.06;
      transition: opacity 500ms var(--ease-settle), scale 1400ms var(--ease-settle);
    }
    .menu__figure.is-active { opacity: 1; scale: 1; }
  }
  @media (min-width: 1024px) and (max-height: 720px) {
    .menu__nav { align-content: start; }
    .menu__link-text { font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.5rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu, .menu[data-state='open'] { transition: none; }
    .menu__sheet, .menu[data-state='open'] .menu__sheet { transition: none; clip-path: none; }
    .menu__item, .menu__secondary, .menu__foot { opacity: 1; translate: none; transition: none; }
    .menu__figure, .menu__link-text, .menu__child, .menu__close svg { transition: none; }
    .menu__arch, .menu[data-state='open'] .menu__arch { transition: none; clip-path: none; }
  }
</style>
