---
/*
  In our guests' words (Salt and Sun). One review at a time, in Cormorant italic, centred, with the
  guest line beneath and a small counter. Reviews are verbatim; long ones are trimmed to about 55 words
  with "Read the full review" opening the rest in place. No photographs on the quotes (the old food
  photos were unrelated to what guests wrote). Arrows and the keyboard arrows move between reviews;
  nothing advances on its own. Reduced motion: the change is instant.
*/
import { trimWords, monthYear } from '../../lib/text';
import type { Testimonial } from '../../lib/content';

interface Props { items: Testimonial[]; heading?: string; headingDraft?: boolean; id?: string; max?: number }
const { items, heading = 'In our guests’ words', headingDraft = true, id = 'guests', max = 8 } = Astro.props;
const list = items.slice(0, max);
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="gw" id={id} aria-labelledby={`${id}-heading`} data-gw>
  <div class="wrap gw__inner">
    <h2 class="gw__heading" id={`${id}-heading`} data-draft={headingDraft ? '' : undefined}>{heading}</h2>
    <div class="gw__stage" aria-live="polite">
      {list.map((t, i) => {
        const d = t.data;
        const { short, trimmed } = trimWords(d.quote!.replace(/\s*\n+\s*/g, ' '), 55);
        return (
          <figure class:list={['gw__quote', i === 0 && 'is-on']} data-gw-quote={i} aria-hidden={i === 0 ? undefined : 'true'}>
            <span class="gw__mark" aria-hidden="true">“</span>
            <blockquote>
              <p data-gw-short>{short}</p>
              {trimmed && <p class="gw__full" data-gw-full hidden>{d.quote!.replace(/\s*\n+\s*/g, ' ')}</p>}
            </blockquote>
            {trimmed && <button type="button" class="gw__more text-link" data-gw-more aria-expanded="false" tabindex={i === 0 ? undefined : -1}>Read the full review</button>}
            <figcaption class="gw__by">
              <span data-draft>{d.descriptor}</span>
              {d.source_type === 'google' && d.date && <span class="gw__src">Google review, {monthYear(d.date)}</span>}
            </figcaption>
          </figure>
        );
      })}
    </div>
    {list.length > 1 && (
      <div class="gw__nav">
        <button type="button" class="gw__arrow" data-gw-prev aria-label="Previous review">
          <svg viewBox="0 0 40 12" width="40" height="12" aria-hidden="true" focusable="false"><path d="M39.5 6H1M6 1L1 6l5 5" /></svg>
        </button>
        <p class="gw__count"><span data-gw-now>01</span><span class="gw__count-rest"> / {pad(list.length)}</span></p>
        <button type="button" class="gw__arrow" data-gw-next aria-label="Next review">
          <svg viewBox="0 0 40 12" width="40" height="12" aria-hidden="true" focusable="false"><path d="M0.5 6H39M34 1l5 5-5 5" /></svg>
        </button>
      </div>
    )}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-gw]').forEach((root) => {
    const quotes = Array.from(root.querySelectorAll<HTMLElement>('[data-gw-quote]'));
    const now = root.querySelector<HTMLElement>('[data-gw-now]');
    let i = 0;
    const show = (n: number) => {
      i = (n + quotes.length) % quotes.length;
      quotes.forEach((q, k) => {
        const on = k === i;
        q.classList.toggle('is-on', on);
        q.toggleAttribute('aria-hidden', !on);
        q.querySelectorAll<HTMLElement>('button').forEach((b) => (on ? b.removeAttribute('tabindex') : b.setAttribute('tabindex', '-1')));
      });
      if (now) now.textContent = String(i + 1).padStart(2, '0');
    };
    root.querySelector('[data-gw-prev]')?.addEventListener('click', () => show(i - 1));
    root.querySelector('[data-gw-next]')?.addEventListener('click', () => show(i + 1));
    root.addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement).closest('.gw__nav') && (e.key === 'ArrowLeft' || e.key === 'ArrowRight')) {
        e.preventDefault();
        show(i + (e.key === 'ArrowRight' ? 1 : -1));
      }
    });
    root.querySelectorAll<HTMLButtonElement>('[data-gw-more]').forEach((b) => {
      b.addEventListener('click', () => {
        const q = b.closest('[data-gw-quote]')!;
        const full = q.querySelector<HTMLElement>('[data-gw-full]');
        const short = q.querySelector<HTMLElement>('[data-gw-short]');
        const open = b.getAttribute('aria-expanded') !== 'true';
        b.setAttribute('aria-expanded', String(open));
        if (full) full.hidden = !open;
        if (short) short.hidden = open;
        b.textContent = open ? 'Show less' : 'Read the full review';
      });
    });
  });
</script>

<style>
  .gw { padding-block: var(--section-y); }
  .gw__inner { display: grid; justify-items: center; text-align: center; }
  .gw__heading {
    margin: 0 0 clamp(2.5rem, 5vw, 4rem);
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: clamp(1.1875rem, 1.1rem + 0.3vw, 1.375rem);
    line-height: 1.3;
    letter-spacing: 0;
    color: var(--sage-80);
  }
  .gw__stage { display: grid; width: 100%; max-width: 54rem; }
  .gw__quote {
    grid-area: 1 / 1;
    margin: 0;
    display: grid;
    justify-items: center;
    opacity: 0;
    visibility: hidden;
    translate: 0 1rem;
    transition: opacity 900ms var(--ease-settle), translate 1100ms var(--ease-settle), visibility 0s linear 900ms;
  }
  .gw__quote.is-on { opacity: 1; visibility: visible; translate: 0 0; transition: opacity 900ms var(--ease-settle) 150ms, translate 1100ms var(--ease-settle) 150ms, visibility 0s; }
  .gw__mark { font-family: var(--font-display); font-size: clamp(4rem, 3rem + 3vw, 6.5rem); line-height: 0.6; height: 0.45em; color: var(--sage-40); }
  .gw__quote blockquote { margin: 0; }
  .gw__quote blockquote p {
    margin: 0 auto;
    max-width: 34em;
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: var(--fs-quote);
    line-height: 1.34;
    color: var(--sage-100);
    text-wrap: balance;
  }
  .gw__full { font-size: clamp(1.25rem, 1rem + 0.8vw, 1.625rem) !important; }
  .gw__more { margin-top: 1.25rem; border: 0; background: none; padding: 0 0 0.15em; font-family: var(--font-ui); font-size: var(--fs-small); letter-spacing: 0.04em; min-height: 2.75rem; }
  .gw__by { display: grid; gap: 0.25rem; margin-top: clamp(1.5rem, 3vw, 2.25rem); font-family: var(--font-ui); font-size: var(--fs-small); letter-spacing: 0.06em; color: var(--sage-80); }
  .gw__src { font-size: var(--fs-label); letter-spacing: 0.08em; }

  .gw__nav { display: flex; align-items: center; gap: 1.5rem; margin-top: clamp(2rem, 4vw, 3rem); }
  .gw__count { margin: 0; font-family: var(--font-editorial); font-size: 1.25rem; font-variant-numeric: oldstyle-nums; color: var(--sage-80); }
  .gw__count-rest { color: var(--sage-60); }
  .gw__arrow {
    display: grid; place-items: center;
    width: 3.25rem; height: 3.25rem;
    border: 1px solid color-mix(in srgb, var(--sage-40) 60%, transparent);
    border-radius: 50%;
    background: transparent;
    color: var(--sage-80);
    transition: background-color 400ms var(--ease-settle);
  }
  .gw__arrow svg { width: 1.5rem; overflow: visible; }
  .gw__arrow path { fill: none; stroke: currentColor; stroke-width: 1; vector-effect: non-scaling-stroke; stroke-linecap: round; stroke-linejoin: round; }
  @media (hover: hover) { .gw__arrow:hover { background: var(--sand-60); } }

  @media (prefers-reduced-motion: reduce) {
    .gw__quote, .gw__quote.is-on { transition: none; translate: none; }
  }
</style>
