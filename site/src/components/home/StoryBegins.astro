---
/*
  Home, the story begins (rebuild round 1, 28-09-2026). The Fleurieu coast beat Belle put first in her
  story (T48) and named for the home page (T55): her drone footage along the cliffs, the white beach
  and the emerald water under a clear sky, full bleed. It opens from an inset frame to full bleed as it
  rises and the footage settles from 1.08 to 1 as it passes (the zoom Belle loved on The Tailor, T53,
  data-widen in scripts/motion.ts). Her line opens the story in salt over a soft local shade, broken
  across three indents like the opening: "La maréa was created as an invitation to pause." (her note in
  the Encounter Bay guide, p.5, and on /our-story), then the next sentence of the same note beneath it.
  The 8 hour day's heading then rises over the footage's lower edge (PinnedDay overlap), so the two
  sections hand over rather than stack.
  Swap the clip for DJI_0781 in slots-foundation.ts ('home-fleurieu-video') once it is downloaded.
  Reduced motion: a static full-bleed frame with the words in place.
*/
import Media from '../media/Media.astro';
import Caption from '../base/Caption.astro';

const lines = ['La maréa was created', 'as an invitation', 'to pause.'];
const next = 'Not to step away from ambition, but to support it more sustainably.';
---
<section class="sb" aria-labelledby="sb-heading" data-sb data-no-blind>
  <div class="sb__frame" data-widen="6">
    <Media media="home-fleurieu-video" aspect="fill" sizes="100vw" />
    <span class="sb__shade" aria-hidden="true"></span>
    <div class="sb__words">
      <h2 class="sb__heading" id="sb-heading" data-no-split>
        {lines.map((l, i) => <span class={`sb__line sb__line--${i + 1}`}><span class="sb__line-in">{l}</span></span>)}
      </h2>
      <p class="sb__next">{next}</p>
    </div>
    <Caption tone="salt" align="end" class="sb__caption">The <span class="place">Fleurieu Peninsula</span>, South Australia</Caption>
  </div>
</section>

<script>
  // The words rise in once the frame is well on screen.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-sb]').forEach((el) => {
    if (reduce) { el.classList.add('is-in'); return; }
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { el.classList.add('is-in'); io.disconnect(); }
    }, { rootMargin: '0px 0px -35% 0px' });
    io.observe(el);
  });
</script>

<style>
  .sb { position: relative; }
  .sb__frame {
    position: relative;
    height: 108svh;
    min-height: 36rem;
    overflow: hidden;
    color: var(--on-image);
    background: var(--sand-40);
  }
  .sb__frame :global(:is(img, video)) { filter: saturate(0.92) brightness(1.03); }
  /* The shade sits only in the lower left, where the words are. */
  .sb__shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(90% 75% at 0% 78%, rgb(20 50 64 / 0.44), rgb(20 50 64 / 0.18) 46%, rgb(20 50 64 / 0) 72%);
  }
  .sb__words {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: calc(22vh + clamp(2rem, 5vh, 3.5rem));
    z-index: 2;
  }
  .sb__heading {
    margin: 0;
    display: grid;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.4rem, 0.9rem + 4.2vw, 5.25rem);
    line-height: 1;
    letter-spacing: 0.004em;
    color: inherit;
    text-shadow: 0 2px 30px rgb(20 50 64 / 0.32);
  }
  .sb__line { display: block; overflow: hidden; padding-bottom: 0.06em; }
  .sb__line-in { display: inline-block; }
  .sb__line--2 { padding-left: 1.4em; }
  .sb__line--3 { padding-left: 0.55em; }
  .sb__next {
    margin: clamp(1.25rem, 2.5vw, 2rem) 0 0 calc(0.55 * clamp(2.4rem, 0.9rem + 4.2vw, 5.25rem));
    max-width: 24rem;
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: clamp(1.1875rem, 1.05rem + 0.5vw, 1.5rem);
    line-height: 1.4;
    text-shadow: 0 1px 18px rgb(20 50 64 / 0.55);
  }
  .sb :global(.sb__caption) { position: absolute; right: var(--gutter); top: clamp(1.5rem, 5vh, 3rem); z-index: 2; margin: 0; }
  .sb :global(.sb__caption .place) { font-style: italic; }

  @media (max-width: 699px) {
    .sb__frame { height: 92svh; }
    .sb__heading { font-size: clamp(2.1rem, 1rem + 5.4vw, 2.75rem); }
    .sb__line--2 { padding-left: 0.6em; }
    .sb__line--3 { padding-left: 0.25em; }
    .sb__next { margin-left: 0; }
    .sb__words { bottom: calc(14vh + 1.5rem); }
    .sb__shade { background: linear-gradient(to top, rgb(20 50 64 / 0.5), rgb(20 50 64 / 0.2) 45%, rgb(20 50 64 / 0) 70%); }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .sb .sb__line-in { translate: 0 105%; transition: translate 1300ms var(--ease-settle); }
    :global(html.js) .sb .sb__line--2 .sb__line-in { transition-delay: 120ms; }
    :global(html.js) .sb .sb__line--3 .sb__line-in { transition-delay: 240ms; }
    :global(html.js) .sb .sb__next { opacity: 0; transition: opacity 1200ms var(--ease-settle) 600ms; }
    :global(html.js) .sb.is-in .sb__line-in { translate: 0 0; }
    :global(html.js) .sb.is-in .sb__next { opacity: 1; }
  }
</style>
