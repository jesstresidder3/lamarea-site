---
/*
  Statement (page builder D). One of Belle's own sentences set large in the serif, with a small
  label as the section heading in the left third, so her words carry the section without a drafted
  headline above them. Used for the Collective's "What it is".

  <Statement label="What it is" text="A private space for those who’ve already..." />

  Props: label (the h2, set as a small tracked label), text, draft (marks the text as drafted),
  source (optional small attribution line), id
*/
interface Props {
  label: string;
  text: string;
  draft?: boolean;
  source?: string;
  id?: string;
}
const { label, text, draft = false, source, id = `statement-${Math.random().toString(36).slice(2, 7)}` } = Astro.props;
---
<div class="statement">
  <h2 class="statement__label" id={id}>{label}</h2>
  <div class="statement__body">
    <p class="statement__text" data-draft={draft ? '' : undefined}>{text}</p>
    {source && <p class="statement__source">{source}</p>}
  </div>
</div>

<style>
  .statement { display: grid; gap: 1.25rem; }
  .statement__label {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--fs-label);
    line-height: var(--lh-label);
    letter-spacing: var(--track-label);
    color: var(--muted);
  }
  .statement__text {
    margin: 0;
    max-width: 24em;
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 1.25rem + 1.4vw, 2.5rem);
    line-height: 1.28;
    letter-spacing: 0.002em;
    color: var(--sage-80);
    text-wrap: pretty;
  }
  .statement__source { margin: 1.25rem 0 0; font-family: var(--font-ui); font-size: var(--fs-label); letter-spacing: 0.06em; color: var(--sage-80); }
  @media (min-width: 900px) {
    .statement { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: clamp(2rem, 6vw, 7.5rem); align-items: baseline; }
  }
</style>
