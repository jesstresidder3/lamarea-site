---
/*
  ClosingTide (lane L2). Superseded by the shared P5 ending, base/ClosingTide.astro, which carries the
  main action pair ("Plan your day" plus "Contact us", G4), the sand glass panel over the photograph
  (G1) and no subtext under the buttons (G5). This file now hands its props straight to that one, so
  any page that still imports it gets the same ending as the rest of the site. Nothing imports it
  today (28-09-2026); new pages should import base/ClosingTide.astro directly.

  Props: media (slot id), line, lineDraft, params (funnel prefill), caption (unused), link
*/
import BaseClosingTide from '../../base/ClosingTide.astro';

interface Props {
  media: string;
  line: string;
  lineDraft?: boolean;
  params?: Record<string, string | number | undefined>;
  note?: string;
  caption?: string;
  link?: { label: string; href: string };
}
const { media, line, lineDraft = false, params, link } = Astro.props;
---
<BaseClosingTide media={media} line={line} lineDraft={lineDraft} params={params} link={link} />
