---
/*
  Home moment 2, an invitation to pause (build spec 12, pre-build review B1 and item 5).
  Belle's "Restore. Reconnect. Realign." as the display line, then about 40 words in her own words,
  transformation included, then the drafted sub-line that moved here from the hero.

  Sources, verbatim:
  - "Restore. Reconnect. Realign." Belle's wording ideas, transcript 14-09-2026 (set in sentence case)
  - "La maréa was created as an invitation to pause." Encounter Bay retreat guide p.5, "A note from Belle"
  - "By combining luxurious, heartfelt hospitality with holistic, science-backed wellness practices,
    we create transformative experiences that nourish mind, body, and soul." lamarea.com.au/philosophy
  Drafted (data-draft): the sub-line, creative brief section G.

  Sand, air, a one third to two thirds split. The lm submark is Belle's own mark from the style guide.
*/
import Logo from '../../layout/Logo.astro';
import Reveal from '../../base/Reveal.astro';
---
<section class="invite" aria-labelledby="invite-heading">
  <div class="wrap invite__grid">
    <Reveal class="invite__head">
      <Logo variant="lm" height="2.25rem" class="invite__mark" />
      <h2 class="invite__heading" id="invite-heading">
        <span>Restore.</span> <span>Reconnect.</span> <span>Realign.</span>
      </h2>
    </Reveal>
    <Reveal class="invite__body" delay={120}>
      <p class="invite__lead">La maréa was created as an invitation to pause.</p>
      <p class="invite__text">By combining luxurious, heartfelt hospitality with holistic, science-backed wellness practices, we create transformative experiences that nourish mind, body, and soul.</p>
      <p class="invite__sub" data-draft>Wellness experiences in beautiful locations on the Fleurieu Peninsula, hosted at luxury partner accommodation. 8 hour retreats for private groups and corporate teams, south of Adelaide.</p>
    </Reveal>
  </div>
</section>

<style>
  .invite { padding-block: clamp(4.5rem, 11vw, 10rem); background: var(--sand-30); }
  .invite__grid { display: grid; gap: clamp(2rem, 4vw, 3rem); align-items: start; }
  .invite :global(.invite__mark) { color: var(--sage-40); margin-bottom: clamp(1.5rem, 3vw, 2.25rem); }
  .invite__heading { margin: 0; font-size: var(--fs-h2); line-height: 1.12; }
  .invite__heading span { display: block; }

  .invite__lead {
    margin: 0 0 1.25rem;
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.9rem);
    line-height: 1.3;
    color: var(--sage-80);
    max-width: 22em;
    text-wrap: balance;
  }
  .invite__text { margin: 0; max-width: 31rem; }
  .invite__sub {
    margin: clamp(1.75rem, 3vw, 2.5rem) 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--sage-20);
    max-width: 31rem;
    font-family: var(--font-ui);
    font-size: var(--fs-small);
    letter-spacing: 0.04em;
    color: var(--sage-80);
  }

  @media (min-width: 900px) {
    .invite__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); }
    .invite :global(.invite__body) { padding-top: calc(2.25rem + clamp(1.5rem, 3vw, 2.25rem)); }
  }
</style>
