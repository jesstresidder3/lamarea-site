---
/*
  PageOpener (lane L2, rebuild 28-09-2026). The buyers' path opens the way home does: one photograph
  or clip edge to edge under a clear header, the title layered over it in salt type at magazine
  indents, a soft shade only where the words sit, and an optional row of plain facts on its lower edge.

  The two audience pages carry on from the home opening, where the scene parts into an arch (private
  groups, left) and a frame (corporate teams, right). Here the page opens inside that same shape, in
  the same place, and the shape widens to full bleed like the tide coming in:
    shape="arch"   starts as the arch on the left, as the visitor last saw it on home
    shape="frame"  starts as the frame on the right
    shape="tide"   rises from the lower edge (every other page)
  As the visitor scrolls on, the photograph eases in a little closer and the title drifts up slower
  than the page. Reduced motion: everything at rest, full bleed, no zoom.

  Props
  - media: slot id (image or video). mobileMedia: optional slot for phones (a portrait cut)
  - eyebrow, lines (the H1, one string per line, *Place* marks a place name), indents (em per line)
  - line: the audience line under the title (Belle's words), lineDraft when drafted
  - titleDraft: marks the H1 as drafted
  - place: 'top-left' (default) | 'top-right' | 'bottom-left', where the title sits over the photo
  - zoom: extra scale on the photograph for a tighter crop (Belle asked to zoom the table up)
  - facts: [{ label, value, href?, draft? }] set on the lower edge
  - caption: a small Cormorant caption naming the place in the photograph
  - height: 'screen' (default) | 'tall'
*/
import Media from '../../media/Media.astro';
import { emphasis } from '../../base/text';
import Caption from '../../base/Caption.astro';

interface Fact { label: string; value: string; href?: string; draft?: boolean }
interface Props {
  media: string;
  mobileMedia?: string;
  eyebrow?: string;
  lines: string[];
  indents?: number[];
  line?: string;
  lineDraft?: boolean;
  titleDraft?: boolean;
  place?: 'top-left' | 'top-right' | 'bottom-left';
  /** 'strong' deepens the local shade for bright, busy footage. */
  shade?: 'soft' | 'strong';
  /** Phones: 'top' (default) or 'bottom', so the words can sit over a calm part of the portrait crop. */
  phonePlace?: 'top' | 'bottom';
  shape?: 'arch' | 'frame' | 'tide';
  zoom?: number;
  facts?: Fact[];
  caption?: string;
  height?: 'screen' | 'tall';
  drift?: boolean;
  id?: string;
}
const {
  media,
  mobileMedia,
  eyebrow,
  lines,
  indents = [],
  line,
  lineDraft = false,
  titleDraft = false,
  place = 'top-left',
  phonePlace = 'top',
  shade = 'soft',
  shape = 'tide',
  zoom = 1,
  facts = [],
  caption,
  height = 'screen',
  drift = false,
  id = 'po',
} = Astro.props;
---
<section
  class:list={['po', `po--${shape}`, `po--${place}`, `po--phone-${phonePlace}`, `po--shade-${shade}`, `po--${height}`, facts.length && 'po--facts', drift && 'po--drift']}
  aria-labelledby={`${id}-title`}
  data-po
  data-page-opener
  data-no-split
  data-no-blind
  style={`--po-zoom:${zoom}`}
>
  <div class="po__stage" data-hero>
    <div class="po__clip">
      <div class:list={['po__media', mobileMedia && 'po__media--wide']} data-po-media><Media media={media} aspect="fill" priority sizes="100vw" /></div>
      {mobileMedia && <div class="po__media po__media--phone" data-po-media><Media media={mobileMedia} aspect="fill" sizes="100vw" showNote={false} /></div>}
      <span class="po__shade" aria-hidden="true"></span>
    </div>

    <div class="po__title">
      {eyebrow && <p class="po__eyebrow on-media-panel">{eyebrow}</p>}
      <h1 class="po__heading" id={`${id}-title`} data-draft={titleDraft ? '' : undefined}>
        {lines.map((l, i) => (
          <span class="po__line" data-po-line={i} style={indents[i] ? `--indent:${indents[i]}em` : undefined}>
            <span class="po__line-in on-media-panel on-media-panel--title" style={`--d:${i}`} set:html={emphasis(l)} />
          </span>
        ))}
      </h1>
      {line && <p class="po__aud on-media-panel" data-draft={lineDraft ? '' : undefined}>{line}</p>}
      {Astro.slots.has('default') && <div class="po__more"><slot /></div>}
    </div>

    {caption && <Caption tone="salt" align="end" class="po__caption">{caption}</Caption>}
  </div>

  {facts.length > 0 && (
    <dl class="po__facts" style={`--cols:${facts.length}`}>
      {facts.map((f, i) => (
        <div class="po__fact" style={`--d:${i}`}>
          <dt>{f.label}</dt>
          <dd data-draft={f.draft ? '' : undefined}>{f.href ? <a href={f.href}>{f.value}</a> : f.value}</dd>
        </div>
      ))}
    </dl>
  )}
</section>

<style>
  .po { position: relative; background: var(--sand-30); }
  .po__stage { position: relative; height: 100svh; min-height: 36rem; }
  .po--tall .po__stage { height: 88svh; min-height: 32rem; }
  .po__clip { position: absolute; inset: 0; overflow: hidden; background: var(--sand-40); }
  .po__media { position: absolute; inset: 0; }
  .po__media :global(:is(img, video)) { scale: var(--po-zoom); }
  .po__media--phone { display: none; }

  /* G1 (28-09-2026): no scrim. The title lines, eyebrow and sentence sit on the shared sand glass
     panels (.on-media-panel, utilities.css) with sage ink, so the photograph keeps its own light. */
  .po__shade { display: none; }
  .po__title {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: calc(var(--header-h) + clamp(2rem, 9svh, 7rem)) var(--gutter) 0;
    color: var(--on-image);
    z-index: 2;
    pointer-events: none;
  }
  .po--top-right .po__title { align-items: flex-end; text-align: right; }
  .po--bottom-left .po__title { justify-content: flex-end; padding-bottom: clamp(3rem, 12svh, 8rem); }
  .po--facts.po--bottom-left .po__title { padding-bottom: clamp(7rem, 20svh, 11rem); }
  .po__title :global(a) { pointer-events: auto; }
  .po__more { margin-top: clamp(1.5rem, 3svh, 2.25rem); }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .po__more { animation: po-fade 1000ms var(--ease-settle) 1400ms both; }
  }
  /* drift: a very slow 3 per cent ease in, for pages that hold on the opener (404). */
  @media (prefers-reduced-motion: no-preference) {
    .po--drift .po__media { animation: po-drift-in 20s var(--ease-tide) 2s infinite alternate both !important; }
  }
  @keyframes po-drift-in { from { scale: 1; } to { scale: 1.03; } }

  .po__eyebrow {
    margin: 0 0 1.25rem;
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: 1.1875rem;
    padding: 0.3rem 0.8rem;
  }
  .po__heading {
    margin: 0;
    display: grid;
    justify-items: inherit;
    font-size: clamp(2.6rem, 1rem + 4.6vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: 0.004em;
    color: inherit;
  }
  .po--top-right .po__heading { justify-items: end; }
  .po__line { display: block; padding-left: var(--indent, 0); padding-bottom: 0.08em; }
  .po--top-right .po__line { padding-left: 0; padding-right: var(--indent, 0); }
  /* Each line has its own sand glass panel (G1), stepping with the indents and lifting with its line. */
  .po__line-in { display: inline-block; padding: 0.08em 0.32em 0.14em; }
  .po__heading :global(.place) { font-family: var(--font-editorial); font-style: italic; font-size: 1.06em; }
  .po__aud {
    margin: clamp(1.25rem, 3svh, 2rem) 0 0;
    max-width: 24rem;
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: clamp(1.2rem, 1.05rem + 0.5vw, 1.5rem);
    line-height: 1.35;
    padding: 0.7rem 1rem;
  }
  .po :global(.po__caption) {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(1.75rem, 5svh, 3.25rem);
    z-index: 2;
    margin: 0;
    max-width: 20rem;
  }
  .po--facts :global(.po__caption) { bottom: auto; top: calc(100% - clamp(8.5rem, 16svh, 10rem)); }
  .po--top-right :global(.po__caption) { right: auto; left: var(--gutter); }

  /* Facts: a salt strip along the lower edge on wide screens, a sand list beneath on phones. */
  .po__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0.75rem var(--gutter) 0;
    background: var(--sand-30);
  }
  .po__fact { padding: 0.9rem 0.75rem 0.9rem 0; border-bottom: 1px solid var(--sage-20); }
  .po__fact dt { font-family: var(--font-ui); font-size: var(--fs-label); letter-spacing: var(--track-label); color: var(--sage-80); }
  .po__fact dd { margin: 0.3rem 0 0; font-family: var(--font-display); font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.3rem); line-height: 1.25; color: var(--sage-100); }
  .po__fact dd a { color: inherit; text-decoration: underline; text-decoration-color: color-mix(in srgb, currentColor 35%, transparent); text-underline-offset: 0.22em; }
  .po__fact:last-child:nth-child(odd) { grid-column: 1 / -1; }

  @media (min-width: 900px) {
    .po__facts {
      position: absolute;
      left: var(--gutter);
      right: var(--gutter);
      bottom: 0;
      z-index: 3;
      grid-template-columns: repeat(var(--cols, 5), minmax(0, 1fr));
      grid-auto-flow: column;
      padding: 1.1rem 1.75rem 1.2rem;
      background: color-mix(in srgb, var(--salt-25) 92%, transparent);
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
    }
    .po__fact { padding: 0 1.25rem; border-bottom: 0; border-left: 1px solid var(--sage-20); }
    .po__fact:first-child { padding-left: 0; border-left: 0; }
    .po__fact:last-child:nth-child(odd) { grid-column: auto; }
    .po--facts :global(.po__caption) { top: calc(var(--header-h) + 1.25rem); bottom: auto; }
  }

  @media (max-width: 899px) {
    .po__stage { height: 86svh; min-height: 30rem; }
    .po__title { padding-top: calc(var(--header-h) + clamp(1.5rem, 6svh, 3rem)); }
    .po--top-right .po__title { align-items: flex-start; text-align: left; }
    .po--top-right .po__heading { justify-items: start; }
    .po--top-right .po__line { padding-right: 0; padding-left: var(--indent, 0); }
    .po__heading { font-size: clamp(2.35rem, 1.2rem + 5.4vw, 3.4rem); }
    .po__line { padding-left: calc(var(--indent, 0) * 0.6); }
    .po__media--wide:has(+ .po__media--phone) { display: none; }
    .po__media--phone { display: block; }
    .po :global(.po__caption) { left: var(--gutter); right: auto; bottom: 1.25rem; justify-content: flex-start; text-align: left; }
    .po--phone-bottom .po__title { justify-content: flex-end; padding-bottom: clamp(2rem, 6svh, 3rem); }
    .po--top-right :global(.po__caption) { left: var(--gutter); }
    .po--facts :global(.po__caption) { top: auto; bottom: 1rem; left: auto; right: var(--gutter); font-size: 0.875rem; }
  }

  /* ---------- Motion: the shape widens to full bleed, lines rise, facts settle ---------- */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .po__clip { animation: po-open 1400ms var(--ease-tide) both; }
    :global(html.js) .po__media :global(:is(img, video)) { animation: po-settle 2600ms var(--ease-settle) both; }
    :global(html.js) .po__line-in { animation: po-rise 1300ms var(--ease-settle) calc(500ms + var(--d) * 140ms) both; }
    :global(html.js) :is(.po--arch, .po--frame) .po__line-in { animation-delay: calc(820ms + var(--d) * 140ms); }
    :global(html.js) :is(.po__eyebrow, .po__aud) , :global(html.js) .po :global(.po__caption) { animation: po-fade 1000ms var(--ease-settle) 1250ms both; }
    :global(html.js) .po__eyebrow { animation-delay: 700ms; }
    :global(html.js) .po__fact { animation: po-fact 900ms var(--ease-settle) calc(1350ms + var(--d) * 90ms) both; }

    /* Scroll motion is shared with base/PageOpener (scripts/page-opener.ts): the lines lift at
       different speeds and the photograph settles as the opener leaves. */
  }
  @keyframes po-settle { from { scale: calc(var(--po-zoom) * 1.06); } to { scale: var(--po-zoom); } }
  @keyframes po-rise { from { opacity: 0; translate: 0 0.45em; } to { opacity: 1; translate: 0 0; } }
  @keyframes po-fade { from { opacity: 0; translate: 0 10px; } to { opacity: 1; translate: 0 0; } }
  @keyframes po-fact { from { opacity: 0; translate: 0 14px; } to { opacity: 1; translate: 0 0; } }

  /* Each shape starts where the visitor last saw it on home. */
  @keyframes po-open {
    from { clip-path: inset(100% 0% 0% 0%); }
    to { clip-path: inset(0% 0% 0% 0% round 0px); }
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .po--arch .po__clip { animation-name: po-open-arch; animation-duration: 2000ms; }
    :global(html.js) .po--frame .po__clip { animation-name: po-open-frame; animation-duration: 2000ms; }
  }
  @keyframes po-open-arch {
    0% { clip-path: inset(18% 56% 0% 10% round 40vw 40vw 0px 0px); }
    100% { clip-path: inset(0% 0% 0% 0% round 0px 0px 0px 0px); }
  }
  @keyframes po-open-frame {
    0% { clip-path: inset(20% 10% 14% 52% round 0px); }
    100% { clip-path: inset(0% 0% 0% 0% round 0px); }
  }
  @media (max-width: 899px) {
    @keyframes po-open-arch {
      0% { clip-path: inset(22% 12% 0% 12% round 50vw 50vw 0px 0px); }
      100% { clip-path: inset(0% 0% 0% 0% round 0px 0px 0px 0px); }
    }
    @keyframes po-open-frame {
      0% { clip-path: inset(22% 12% 14% 12% round 0px); }
      100% { clip-path: inset(0% 0% 0% 0% round 0px); }
    }
  }
</style>

<script>
  import '../../../scripts/page-opener';
</script>
