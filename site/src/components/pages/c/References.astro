---
/*
  The references under a research post, in small type and grouped as Belle published them
  (plan/11 4.19 section 5). Numbered within each group, as on the live post.
*/
interface Props { groups: { group: string; entries: string[] }[] }
const { groups } = Astro.props;
const total = groups.reduce((n, g) => n + g.entries.length, 0);
---
<section class="refs" aria-labelledby="refs-heading">
  <h2 class="refs__h" id="refs-heading">References ({total})</h2>
  <div class="refs__groups">
    {groups.map((g) => (
      <div class="refs__group">
        <h3 class="refs__group-title">{g.group}</h3>
        <ol class="refs__list">{g.entries.map((e) => <li>{e}</li>)}</ol>
      </div>
    ))}
  </div>
</section>

<style>
  .refs { margin-top: clamp(3rem, 6vw, 5rem); padding-top: 1.5rem; border-top: 1px solid var(--rule); }
  .refs__h { margin: 0 0 1.5rem; font-family: var(--font-ui); font-size: var(--fs-label); letter-spacing: var(--track-label); line-height: var(--lh-label); color: var(--muted); }
  .refs__groups { display: grid; gap: 1.75rem 3rem; }
  @media (min-width: 1100px) { .refs__groups { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .refs__group-title { margin: 0 0 0.6rem; font-family: var(--font-serif); font-size: 1.1rem; line-height: 1.3; color: var(--heading); }
  .refs__list { margin: 0; padding-left: 1.2rem; font-size: 0.78rem; line-height: 1.55; color: var(--sage-80); overflow-wrap: anywhere; }
  .refs__list li + li { margin-top: 0.45rem; }
  .refs__list li::marker { color: var(--sage-60); }
</style>
