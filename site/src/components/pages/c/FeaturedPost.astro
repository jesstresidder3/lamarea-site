---
/*
  The featured story at the top of the wellness journal (plan/11 4.18 section 4): the photograph
  large with the title over it in the serif (Belle: "an image with... some simple wording", BD-70),
  and beside it the category, date, read time, the post's own opening lines and the author.
*/
import Media from '../../media/Media.astro';
import ArrowLink from '../../base/ArrowLink.astro';
import { formatDate, plain } from '../../../lib/text';
import type { Post } from '../../../lib/content';

interface Props { post: Post; minutes: number; author?: { name: string; href?: string } | null }
const { post, minutes, author } = Astro.props;
const d = post.data;
const href = `/journal/${post.id}`;
---
<article class="featured">
  <a class="featured__card lift-host" data-cursor="Read" href={href} aria-labelledby={`featured-${post.id}`}>
    <span class="featured__media lift-img"><Media media={d.hero} aspect="fill" priority notePosition="top-right" /></span>
    <span class="featured__text">
      <span class="featured__chip">{d.category}</span>
      <span class="featured__title" id={`featured-${post.id}`}>{plain(d.title)}</span>
    </span>
  </a>
  <div class="featured__aside">
    <p class="featured__label">The latest story</p>
    <p class="featured__meta">
      <time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date)}</time>
      <span aria-hidden="true">·</span>
      <span>{minutes} minute read</span>
    </p>
    <p class="featured__excerpt">{d.excerpt}</p>
    {author && (
      <p class="featured__author">By {author.href ? <a class="text-link" href={author.href}>{author.name}</a> : author.name}</p>
    )}
    <ArrowLink href={href} label="Read the story" aria-describedby={`featured-${post.id}`} />
  </div>
</article>

<style>
  /* Salt and Sun: the title sits on sand beneath the photograph, never over it (a magazine cover). */
  .featured { display: grid; gap: var(--space-l) clamp(2rem, 5vw, 5.5rem); align-items: end; }
  .featured__card { display: grid; gap: 1.25rem; color: var(--sage-80); text-decoration: none; }
  .featured__media { position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden; background: var(--sand-40); }
  .featured__card:focus-visible { outline: 1.5px solid var(--focus); outline-offset: 4px; }
  .featured__text { display: grid; gap: 0.75rem; justify-items: start; }
  .featured__chip { font-family: var(--font-editorial); font-style: italic; font-size: 1.125rem; line-height: 1.2; color: var(--sage-80); }
  .featured__title { max-width: 20em; font-family: var(--font-display); font-size: clamp(1.625rem, 1.1rem + 1.6vw, 2.75rem); line-height: 1.12; text-wrap: balance; color: var(--sage-80); }
  .featured__card :global(.ph-note) { max-width: min(22rem, 70%); }

  .featured__aside { display: grid; justify-items: start; gap: 0; max-width: 28rem; }
  .featured__label { margin: 0 0 1rem; font-family: var(--font-editorial); font-style: italic; font-size: 1.125rem; color: var(--sage-80); }
  .featured__meta { display: flex; gap: 0.6rem; margin: 0 0 1.25rem; font-family: var(--font-ui); font-size: var(--fs-small); letter-spacing: 0.04em; color: var(--sage-80); }
  .featured__excerpt { margin: 0 0 1.25rem; font-size: var(--fs-lead); line-height: 1.6; color: var(--sage-100); }
  .featured__author { margin: 0 0 0.75rem; font-size: var(--fs-small); color: var(--sage-80); }

  @media (min-width: 900px) {
    .featured { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); }
    .featured__media { aspect-ratio: 3 / 2; }
  }
</style>
