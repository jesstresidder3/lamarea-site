---
/*
  Belle’s ten pillar icons, large, appearing one after another as the philosophy page opens ("as soon
  as people come to the philosophy page, yeah, I’d really love those sort of brand pillars to pop up",
  BD-37; "these need to be bigger and... more luxurious", BD-29). Each is a link that opens its pillar
  in the FlexShowcase below (the showcase reads the hash). Owner: page builder B, lane L4 rebuild.

  L4 rebuild, 28-09-2026: no longer a toolbar of ten small icons. The ten are set as a contents page
  in two columns of five: numeral, the icon at about 72px, the name in HV Muse. Each row slides in
  from the right in turn as it reaches the screen (Belle's Tailor motion). Phones: one column.
  Reduced motion: at rest.

  <PillarIcons pillars={pillars} />
*/
import Icon from '../../base/Icon.astro';
import { pad2 } from '../../../lib/text';
import type { Pillar } from '../../../lib/content';

interface Props { pillars: Pillar[]; label?: string; class?: string }
const { pillars, label = 'Our ten pillars', class: className } = Astro.props;
---
<nav class:list={['picons', className]} aria-label={label}>
  <ol class="picons__list" role="list">
    {pillars.map((p, i) => (
      <li class="picons__item" style={`--k:${i % 5}`}>
        <a class="picons__link" href={`#${p.id}`}>
          <span class="picons__num" aria-hidden="true">{pad2(i + 1)}</span>
          <Icon name={p.data.icon.replace(/\.svg$/, '')} size="clamp(2.75rem, 1.8rem + 2.6vw, 4.5rem)" class="picons__icon" />
          <span class="picons__name">{p.data.long_name ?? p.data.name}</span>
          <svg class="picons__arrow" width="22" height="10" viewBox="0 0 22 10" aria-hidden="true" focusable="false"><line x1="0.5" y1="5" x2="21.25" y2="5" /><polyline points="16.25,0.5 21.25,5 16.25,9.5" /></svg>
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .picons { width: 100%; }
  .picons__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-auto-flow: row;
    column-gap: clamp(2rem, 6vw, 6rem);
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }
  @media (min-width: 900px) {
    .picons__list { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(5, auto); grid-auto-flow: column; }
  }
  .picons__item { min-width: 0; border-bottom: 1px solid var(--rule); overflow-x: clip; }
  .picons__link {
    display: grid;
    grid-template-columns: 2.25rem auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(0.9rem, 2vw, 1.75rem);
    min-height: 2.75rem;
    padding: clamp(0.9rem, 1.8vw, 1.35rem) 0;
    color: var(--sage-80);
    text-decoration: none;
  }
  .picons__num { font-family: var(--font-ui); font-size: var(--fs-label); letter-spacing: var(--track-label); color: var(--muted); }
  .picons__link :global(.picons__icon) { color: var(--sage-60); transition: color var(--dur-fast) var(--ease-soft); }
  .picons__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.45rem, 1rem + 1.4vw, 2.35rem);
    line-height: 1.08;
    color: var(--heading);
    text-wrap: balance;
  }
  .picons__arrow { overflow: visible; color: var(--sage-60); opacity: 0; transform: translateX(-8px); transition: opacity var(--dur-fast) var(--ease-soft), transform 600ms var(--ease-settle); }
  .picons__arrow :is(line, polyline) { fill: none; stroke: currentColor; stroke-width: 1; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  @media (hover: hover) {
    .picons__link:hover :global(.picons__icon) { color: var(--sage-100); }
    .picons__link:hover .picons__arrow { opacity: 1; transform: none; }
  }
  .picons__link:focus-visible { outline-offset: 2px; }
  .picons__link:focus-visible .picons__arrow { opacity: 1; transform: none; }

  /* Each row slides in from the right as it reaches the screen, staggered down each column. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .picons__link {
        animation: picon-in linear both;
        animation-timeline: view();
        animation-range: entry 5% entry 80%;
      }
    }
    @supports not (animation-timeline: view()) {
      .picons__item { animation: picon-in 1000ms var(--ease-settle) both; animation-delay: calc(250ms + var(--k) * 120ms); }
    }
  }
  @keyframes picon-in {
    from { opacity: 0; transform: translateX(12%); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .picons__link :global(.picons__icon), .picons__arrow { transition: none; }
  }
  @media (max-width: 599px) {
    .picons__link { grid-template-columns: 1.75rem auto minmax(0, 1fr); }
    .picons__arrow { display: none; }
  }
</style>
