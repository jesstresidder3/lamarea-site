---
/*
  Small sentence-case tracked label above a heading (never uppercase, orchestration brief rule).
  <Eyebrow>Fleurieu Peninsula, South Australia</Eyebrow>
  <Eyebrow icon="personalisation">Your day, shaped around you</Eyebrow>
  Props: as (default 'p'), icon (one of Belle's icon names, shown before the label), tone ('light' on media),
  draft (marks drafted copy), class.
*/
import Icon from './Icon.astro';

interface Props {
  as?: 'p' | 'span' | 'div' | 'h2' | 'h3';
  icon?: string;
  tone?: 'default' | 'light';
  draft?: boolean;
  class?: string;
}
const { as: Tag = 'p', icon, tone = 'default', draft = false, class: className } = Astro.props;
---
<Tag class:list={['eyebrow', `eyebrow--${tone}`, className]} data-draft={draft ? '' : undefined}>
  {icon && <Icon name={icon} size="1.5rem" class="eyebrow__icon" />}
  <span><slot /></span>
</Tag>

<style>
  /* Salt and Sun: the small tracked label becomes a quiet editorial kicker in Cormorant italic, so a
     section is announced by its heading and this reads like a magazine standfirst, not a UI label. */
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0 0 1.1rem;
    font-family: var(--font-editorial);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.25rem);
    line-height: 1.35;
    letter-spacing: 0.005em;
    color: var(--sage-80);
    max-width: none;
  }
  .eyebrow--light { color: var(--sage-80); }
  .eyebrow :global(.eyebrow__icon) { color: var(--sage-40); }
</style>
