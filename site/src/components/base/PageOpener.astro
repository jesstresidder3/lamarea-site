---
/*
  P1 PageOpener, the inner-page opener (art review 27-09-2026, shared pattern P1).
  The home Opening, simplified for inner pages. A full-bleed photograph or drone clip (100svh on
  desktop, at least 38rem; 88svh on phones), the page title in HV Muse salt ink broken by hand into
  two or three lines at three indents on a sand glass title panel (G1), the
  page's one-line sentence bottom left and a P3 caption bottom right.

  Words on media (G1, 28-09-2026): each title line sits on its own sand glass title panel
  (.on-media-panel--title, sage ink), the eyebrow, sentence and slot on a sand glass panel
  (.on-media-panel), and the caption is a P3 salt caption (sand glass too). See utilities.css and build/notes/shared-edits.md.

  Motion: the frame washes up from the bottom edge like the tide (clip inset(100% 0 0 0) to inset(0),
  1400ms, --ease-tide) while the photo settles; the lines rise in after it. On scroll the three lines
  lift at speeds 0.9, 0.75 and 0.6 while the photo settles from 1.06 to 1 (scripts/page-opener.ts).
  Reduced motion: a static full-bleed opener, nothing moves.

  The header runs transparent with salt ink over it automatically (Base detects a PageOpener as the
  first thing in <main>), so pages do not need to pass headerTone.

  <PageOpener
    media="experiences-opener"                       media slot id (image or video)
    lines={['The', 'experiences']}                   the h1, one string per line, *Place* in italic
    sub="Luxury South Australian wellness experiences, curated to form La maréa."
    caption="Naiko Deep Creek, Fleurieu Peninsula"
    shadeAt="top-left"
  />

  Props
  - media: media slot id (required). A video slot plays muted on loop while on screen
  - lines: string[] of two or three lines. Asterisks mark place names only (emphasis())
  - sub: the page's one sentence (Jost, salt), bottom left. Optional
  - subDraft: true marks the sentence as drafted (data-draft)
  - caption: P3 caption bottom right (a place or moment the site already states). Optional
  - eyebrow: a small line above the title (for example the parent page). Optional
  - shadeAt: where the words and the shade sit, 'top-left' (default) or 'bottom-left'
  - height: 'screen' (default) or 'tall' (80svh, for pages where the next section should peek in)
  - position: object-position override for the crop, for example '50% 30%'
  - level: heading level, 1 (default)
  - id: heading id (defaults to 'page-title')
  - slot "after": extra content under the sentence (for example an ArrowLink), bottom left
*/
import Media from '../media/Media.astro';
import Caption from './Caption.astro';
import { emphasis } from './text';

interface Props {
  media: string;
  lines: string[];
  sub?: string;
  subDraft?: boolean;
  caption?: string;
  eyebrow?: string;
  shadeAt?: 'top-left' | 'bottom-left';
  height?: 'screen' | 'tall';
  position?: string;
  level?: 1 | 2;
  id?: string;
  class?: string;
}
const {
  media,
  lines,
  sub,
  subDraft = false,
  caption,
  eyebrow,
  shadeAt = 'top-left',
  height = 'screen',
  position,
  level = 1,
  id = 'page-title',
  class: className,
} = Astro.props;
const H = `h${level}` as 'h1' | 'h2';
const hasAfter = Astro.slots.has('after');
---
<section
  class:list={['po', `po--${shadeAt}`, `po--${height}`, className]}
  aria-labelledby={id}
  data-page-opener
  data-no-split
  data-no-blind
>
  <div class="po__frame" data-hero data-po-frame>
    <div class="po__media" data-po-media style={position ? `--po-pos: ${position}` : undefined}>
      <Media media={media} aspect="fill" priority sizes="(max-width: 699px) 340vw, 100vw" />
    </div>
    <span class="po__shade" aria-hidden="true"></span>
  </div>

  <div class="po__words">
    {eyebrow && <p class="po__eyebrow on-media-panel">{eyebrow}</p>}
    <H class="po__title" id={id}>
      {lines.map((l, i) => (
        <span class={`po__line po__line--${i + 1}`} data-po-line={i}><span class="po__line-in on-media-panel on-media-panel--title" set:html={emphasis(l)} /></span>
      ))}
    </H>
  </div>

  {(sub || hasAfter) && (
    <div class="po__foot on-media-panel">
      {sub && <p class="po__sub" data-draft={subDraft ? '' : undefined}>{sub}</p>}
      {hasAfter && <div class="po__after"><slot name="after" /></div>}
    </div>
  )}
  {caption && <Caption tone="salt" align="end" class="po__caption">{caption}</Caption>}
</section>

<script>
  import '../../scripts/page-opener';
</script>

<style>
  .po {
    position: relative;
    height: 100svh;
    min-height: 38rem;
    overflow: hidden;
    color: var(--on-image);
    background: var(--sand-40);
  }
  .po--tall { height: 82svh; min-height: 32rem; }
  .po__frame { position: absolute; inset: 0; overflow: hidden; }
  .po__media { position: absolute; inset: 0; }
  .po__media[style] :global(:is(img, video)) { object-position: var(--po-pos) !important; }

  /* G1 (28-09-2026): no scrim any more. The title and the small words sit on sand glass panels and
     the header over the opener is a sand glass strip, so the photograph keeps its own light. */
  .po__shade { display: none; }

  .po__words {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    z-index: 2;
    pointer-events: none;
  }
  .po--top-left .po__words { top: calc(var(--header-h) + clamp(2rem, 10svh, 7rem)); }
  .po--bottom-left .po__words { bottom: clamp(7.5rem, 20svh, 12rem); }
  .po__eyebrow {
    width: fit-content;
    margin: 0 0 1.5rem;
    padding: 0.3rem 0.8rem;
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: 1.1875rem;
  }
  .po__title {
    margin: 0;
    display: grid;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.75rem, 1rem + 4.4vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: 0.004em;
  }
  .po__line { display: block; }
  /* Each line has its own sand glass panel (G1), stepping with the indents and lifting with its line. */
  .po__line-in { display: inline-block; padding: 0.08em 0.32em 0.14em; color: var(--sage-80); }
  .po__line--2 { padding-left: 1.3em; }
  .po__line--3 { padding-left: 0.5em; }
  .po__title :global(.place) { font-family: var(--font-editorial); font-style: italic; font-size: 1.06em; }

  .po__foot {
    position: absolute;
    left: var(--gutter);
    bottom: clamp(1.75rem, 5svh, 3.25rem);
    z-index: 2;
    display: grid;
    gap: 1rem;
    max-width: 26rem;
  }
  .po__sub {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    line-height: 1.6;
    letter-spacing: 0.03em;
  }
  .po :global(.po__caption) {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(1.75rem, 5svh, 3.25rem);
    z-index: 2;
    margin: 0;
    max-width: 20rem;
  }

  @media (max-width: 699px) {
    .po { height: 88svh; min-height: 34rem; }
    .po--tall { height: 76svh; }
    .po__title { font-size: clamp(2.35rem, 1rem + 6.2vw, 2.9rem); line-height: 1.02; }
    .po__line--2 { padding-left: 0.6em; }
    .po__line--3 { padding-left: 0.2em; }
    .po--top-left .po__words { top: calc(var(--header-h) + 5svh); }
    .po__foot { right: auto; bottom: 4rem; max-width: calc(100% - 2 * var(--gutter)); }
    .po :global(.po__caption) { left: var(--gutter); right: auto; bottom: 1.25rem; justify-content: flex-start; text-align: left; }
  }

  /* Arrival: the tide washes the photograph in from the bottom edge, then the lines rise. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.mo) .po__frame { animation: po-tide 1400ms var(--ease-tide) both; }
    :global(html.mo) .po__media { animation: po-settle 2600ms var(--ease-settle) both; }
    :global(html.mo) .po__line-in { animation: po-rise 1300ms var(--ease-settle) both; }
    :global(html.mo) .po__line--1 .po__line-in { animation-delay: 500ms; }
    :global(html.mo) .po__line--2 .po__line-in { animation-delay: 640ms; }
    :global(html.mo) .po__line--3 .po__line-in { animation-delay: 780ms; }
    :global(html.mo) :is(.po__eyebrow, .po__foot, .po__caption) { animation: po-fade 1100ms var(--ease-settle) 1050ms both; }
  }
  @keyframes po-tide { from { clip-path: inset(100% 0 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes po-settle { from { scale: 1.06; } to { scale: 1; } }
  @keyframes po-rise { from { opacity: 0; translate: 0 0.45em; } to { opacity: 1; translate: 0 0; } }
  @keyframes po-fade { from { opacity: 0; } to { opacity: 1; } }
</style>
