---
/*
  An accessible data table (plan/11 base: table), for the hour by hour day and similar facts.
  Hairline rows, labels in the tracked label style, no zebra stripes. Below `stackBelow` pixels each
  row becomes a small block with its column labels, so nothing scrolls sideways or crops.
  A null or empty cell renders a marked "To confirm with Belle" placeholder.

  <DataTable caption="An example day at Beresford Estate, 12 guests"
    columns={[{ key: 'time', label: 'Time' }, { key: 'what', label: 'What happens' }]}
    rows={hourByHour} note="(Note we can curate a personalised retreat to suit your group)" />

  Props
  - caption (required, the table's name), captionHidden (keep it for screen readers only)
  - columns: { key, label, align?: 'start' | 'end', nowrap? }[]; the first column is the row header
  - rows: Record<string, string | null>[]
  - note: a small line under the table (source, or Belle's own note)
  - stackBelow: 520 (default) or 640; tables with three or more columns should use 640
*/
interface Column { key: string; label: string; align?: 'start' | 'end'; nowrap?: boolean }
interface Props {
  caption: string;
  captionHidden?: boolean;
  columns: Column[];
  rows: Record<string, string | null | undefined>[];
  note?: string;
  stackBelow?: 520 | 640;
  class?: string;
}
const { caption, captionHidden = false, columns, rows, note, stackBelow = 520, class: className } = Astro.props;
---
<div class:list={['dtable', `dtable--stack-${stackBelow}`, className]}>
  <table>
    <caption class:list={[captionHidden && 'visually-hidden']}>{caption}</caption>
    <thead>
      <tr>
        {columns.map((c) => <th scope="col" class:list={[c.align === 'end' && 'is-end']}>{c.label}</th>)}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          {columns.map((c, i) => {
            const value = row[c.key];
            const Cell = i === 0 ? 'th' : 'td';
            return (
              <Cell scope={i === 0 ? 'row' : undefined} data-label={c.label} class:list={[c.align === 'end' && 'is-end', c.nowrap && 'is-nowrap']}>
                {value ? value : <span class="placeholder-line" data-draft>To confirm with Belle</span>}
              </Cell>
            );
          })}
        </tr>
      ))}
    </tbody>
  </table>
  {note && <p class="dtable__note">{note}</p>}
</div>

<style>
  .dtable { width: 100%; }
  table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums lining-nums; }
  caption {
    caption-side: top;
    text-align: left;
    padding-bottom: 1.25rem;
    font-family: var(--font-serif);
    font-size: var(--fs-h4);
    line-height: 1.3;
    color: var(--heading);
  }
  th, td { text-align: left; vertical-align: top; }
  thead th {
    padding: 0 1.5rem 0.75rem 0;
    font-family: var(--font-ui);
    font-weight: 400;
    font-size: var(--fs-label);
    letter-spacing: var(--track-label);
    color: var(--muted);
    border-bottom: 1px solid var(--sage-40);
  }
  tbody th, tbody td {
    padding: 1rem 1.5rem 1rem 0;
    border-bottom: 1px solid var(--sage-20);
    font-weight: 400;
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  tbody th { font-family: var(--font-ui); color: var(--sage-80); letter-spacing: 0.02em; }
  tbody tr > :first-child { width: 1%; white-space: nowrap; padding-right: clamp(1.5rem, 4vw, 4rem); }
  th:last-child, td:last-child { padding-right: 0; }
  .is-end { text-align: right; }
  .is-nowrap { white-space: nowrap; }
  .dtable__note { margin: 1rem 0 0; font-size: var(--fs-small); color: var(--sage-80); }

  @media (max-width: 519px) {
    .dtable--stack-520 thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .dtable--stack-520 tbody tr { display: block; padding: 1rem 0; border-bottom: 1px solid var(--sage-20); }
    .dtable--stack-520 tbody th, .dtable--stack-520 tbody td { display: block; width: auto; padding: 0; border: 0; white-space: normal; }
    .dtable--stack-520 tbody th { margin-bottom: 0.3rem; font-size: var(--fs-label); letter-spacing: var(--track-label); }
  }
  @media (max-width: 639px) {
    .dtable--stack-640 thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .dtable--stack-640 tbody tr { display: block; padding: 1rem 0; border-bottom: 1px solid var(--sage-20); }
    .dtable--stack-640 tbody th, .dtable--stack-640 tbody td { display: block; width: auto; padding: 0.15rem 0; border: 0; white-space: normal; }
    .dtable--stack-640 tbody td::before {
      content: attr(data-label);
      display: block;
      font-family: var(--font-ui);
      font-size: var(--fs-label);
      letter-spacing: var(--track-label);
      color: var(--muted);
    }
  }
</style>
