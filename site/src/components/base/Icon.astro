---
/*
  One of Belle's ten pillar line icons from the style guide, inlined so colour follows `color`.
  <Icon name="personalisation" size="40px" />
  Names match the files in src/assets/brand/icons, and the pillar ids in content-seed/pillars.json
  also work (sleep-and-recovery, wellness-education, luxury-and-heartfelt-hospitality).
  Decorative by default. Pass `label` when the icon carries meaning on its own.
  The paths live once in /icons/<name>.svg (src/pages/icons/[name].svg.ts) and are drawn here with
  <use>, so repeated icons do not weigh down the HTML (QA m15). The hairline is set on the <svg>.
*/
const files = import.meta.glob('../../assets/brand/icons/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;

const aliases: Record<string, string> = {
  'sleep-and-recovery': 'sleep-recovery',
  'wellness-education': 'evidence-based-education',
  'luxury-and-heartfelt-hospitality': 'luxury',
};

interface Props {
  name: string;
  size?: string;
  label?: string;
  class?: string;
}

const { name, size = '2.5rem', label, class: className } = Astro.props;
const file = aliases[name] ?? name;
const svg = files[`../../assets/brand/icons/${file}.svg`];
if (!svg) throw new Error(`Icon "${name}" is not one of Belle's ten icons`);
---
<span
  class:list={['lm-icon', className]}
  style={`width:${size};height:${size}`}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
><svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" style="stroke-width:var(--icon-stroke)"><use href={`/icons/${file}.svg#i`} /></svg></span>
