---
/*
  Accordion on native <details> with `name`, so one row opens at a time (register L3).
  A small chevron that turns on open, never a plus (Belle, BD-92). The height eases over 600ms with
  ::details-content and interpolate-size where supported, and a max-height fallback elsewhere
  (src/scripts/accordion.ts). Keyboard and screen reader behaviour is the browser's own.

  <Accordion items={faqs.map((f) => ({ title: f.question, paragraphs: f.answer_paragraphs }))} />

  Props
  - items: { title, body? (HTML string), paragraphs? (string[]), open?, id?, draft? }[]
  - name: the group name for single-open (default: one generated per accordion; pass multiple for
    independent rows)
  - multiple: allow several rows open together
  - titleTag: 'span' (default) or 'h3' when the rows should appear in the heading outline
  - size: 'default' (Cormorant titles) or 'compact' (Jost titles, for dense lists such as a menu)
*/
interface Item {
  title: string;
  body?: string;
  paragraphs?: string[];
  open?: boolean;
  id?: string;
  draft?: boolean;
}
interface Props {
  items: Item[];
  name?: string;
  multiple?: boolean;
  titleTag?: 'span' | 'h3' | 'h4';
  size?: 'default' | 'compact';
  class?: string;
}
const { items, name = `acc-${Math.random().toString(36).slice(2, 8)}`, multiple = false, titleTag: T = 'span', size = 'default', class: className } = Astro.props;
---
<div class:list={['acc', `acc--${size}`, className]} data-accordion>
  {items.map((item) => (
    <details class="acc__item" name={multiple ? undefined : name} open={item.open} id={item.id}>
      <summary class="acc__summary">
        <T class="acc__title" data-draft={item.draft ? '' : undefined}>{item.title}</T>
        <svg class="acc__chevron" viewBox="0 0 14 8" width="14" height="8" aria-hidden="true" focusable="false"><path d="M1 1l6 6 6-6" /></svg>
      </summary>
      <div class="acc__panel">
        <div class="acc__body">
          {item.body && <Fragment set:html={item.body} />}
          {item.paragraphs?.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </details>
  ))}
</div>

<script>
  import '../../scripts/accordion';
</script>

<style>
  .acc { interpolate-size: allow-keywords; border-top: 1px solid var(--sage-20); }
  .acc__item { border-bottom: 1px solid var(--sage-20); }
  .acc__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 2.75rem;
    padding-block: 1.15rem;
    list-style: none;
    cursor: pointer;
    color: var(--sage-80);
    -webkit-tap-highlight-color: transparent;
  }
  .acc__summary::-webkit-details-marker { display: none; }
  .acc__summary::marker { content: ''; }
  .acc__title {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.2rem, 1.1rem + 0.4vw, 1.45rem);
    line-height: 1.3;
    letter-spacing: 0.005em;
    color: inherit;
    text-wrap: pretty;
  }
  .acc--compact .acc__title { font-family: var(--font-ui); font-size: var(--fs-body); letter-spacing: 0.02em; }
  .acc__chevron { flex: none; width: 12px; height: 7px; transition: transform var(--dur-step) var(--ease-soft); }
  .acc__chevron path { fill: none; stroke: currentColor; stroke-width: 1; vector-effect: non-scaling-stroke; stroke-linecap: round; stroke-linejoin: round; }
  .acc__item[open] > .acc__summary .acc__chevron { transform: rotate(180deg); }
  @media (hover: hover) {
    .acc__summary:hover { color: var(--sage-100); }
  }

  .acc__body { padding: 0 0 1.5rem; max-width: 40rem; }
  .acc__body :global(p) { margin: 0 0 0.9em; }
  .acc__body :global(p:last-child) { margin-bottom: 0; }
  .acc__body :global(ul) { margin: 0 0 0.9em; padding-left: 1.1rem; }

  /* Height transition where the browser can animate details content. */
  .acc__item::details-content {
    block-size: 0;
    overflow-y: clip;
    transition: block-size var(--dur-step) var(--ease-soft), content-visibility var(--dur-step) allow-discrete;
  }
  .acc__item[open]::details-content { block-size: auto; }

  /* Fallback (set by scripts/accordion.ts): max-height on the panel. */
  :global(.acc-fallback) .acc__panel { overflow: hidden; transition: max-height var(--dur-step) var(--ease-soft); }

  @media (prefers-reduced-motion: reduce) {
    .acc__item::details-content { transition: none; }
    .acc__chevron { transition: none; }
    :global(.acc-fallback) .acc__panel { transition: none; }
  }
</style>
