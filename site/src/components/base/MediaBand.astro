---
/*
  Full-bleed media band with an optional soft parallax, and text over it or beneath it.

  <MediaBand media="sg-band" height="band" heading="Where the coast meets the vines" text="below" />
  <MediaBand media="day-hero" height="screen" hero heading="An 8 hour immersive wellness retreat on the *Fleurieu Peninsula*" level={1} text="over" />

  Props
  - media: media slot id (required)
  - height: 'screen' (100svh), 'tall' (86svh), 'band' (a wide band, default) or 'auto' (the slot's aspect)
  - parallax: soft vertical drift bound to scroll (default true). CSS scroll-driven where supported,
    IntersectionObserver plus rAF fallback, none under reduced motion. Where scroll-driven animation
    is supported, photos also scale: a page-opening band zooms in as it leaves, other bands settle
    from 1.08 to 1 as they cross the screen
  - text: 'over' (salt text on the media, a local bottom gradient behind it only), 'below' (text on
    sand beneath the band) or 'none' (default)
  - eyebrow, heading, level (2), body, link { label, href }, align ('left' | 'centre')
  - hero: true when this band opens the page. Marks the media for the header's transparent state,
    loads the media eagerly and lets Base's headerTone="over-media" work
  - caption: a short label under the band (for example a place name)
  - draft: { heading?, body? }
*/
import Media from '../media/Media.astro';
import Eyebrow from './Eyebrow.astro';
import ArrowLink from './ArrowLink.astro';
import { emphasis } from './text';

interface Props {
  media: string;
  height?: 'screen' | 'tall' | 'band' | 'auto';
  parallax?: boolean;
  text?: 'over' | 'below' | 'none';
  eyebrow?: string;
  heading?: string;
  level?: 1 | 2 | 3;
  body?: string;
  link?: { label: string; href: string };
  align?: 'left' | 'centre';
  hero?: boolean;
  caption?: string;
  draft?: { heading?: boolean; body?: boolean };
  id?: string;
  class?: string;
}

const {
  media,
  height = 'band',
  parallax = true,
  text = 'none',
  eyebrow,
  heading,
  level = 2,
  body,
  link,
  align = 'left',
  hero = false,
  caption,
  draft = {},
  id,
  class: className,
} = Astro.props;
const H = `h${level}` as 'h1' | 'h2' | 'h3';
const hasText = text !== 'none' && (heading || body || eyebrow);
---
<section id={id} class:list={['band', `band--${height}`, `band--text-${text}`, `band--${align}`, hero && 'band--hero', className]}>
  {hasText && text === 'over' && hero && (
    <div class="wrap band__head">
      <div class="band__head-main">
        {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
        {heading && <H class="band__heading band__heading--hero" data-title-wait data-draft={draft.heading ? '' : undefined} set:html={emphasis(heading)} />}
      </div>
      {(body || link) && (
        <div class="band__head-aside">
          {body && <p class="band__body" data-draft={draft.body ? '' : undefined}>{body}</p>}
          {link && <ArrowLink href={link.href} label={link.label} class="band__link" />}
        </div>
      )}
    </div>
  )}
  <div class="band__frame" data-hero={hero ? '' : undefined} data-widen={hero ? '' : undefined}>
    <div class:list={['band__media', parallax && !hero && 'band__media--parallax']} data-speed={parallax && !hero ? '0.85' : undefined}>
      <Media media={media} aspect="fill" priority={hero} notePosition="bottom-left" />
    </div>
  </div>
  {caption && <p class="wrap band__caption">{caption}</p>}
  {hasText && (text === 'below' || (text === 'over' && !hero)) && (
    <div class="wrap band__below">
      <div class="band__below-inner">
        {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
        {heading && <H class="band__heading" data-draft={draft.heading ? '' : undefined} set:html={emphasis(heading)} />}
        {body && <p class="band__body" data-draft={draft.body ? '' : undefined}>{body}</p>}
        {link && <ArrowLink href={link.href} label={link.label} class="band__link" />}
      </div>
    </div>
  )}
</section>

<script>
  import '../../scripts/reveal';
</script>

<style>
  /* Salt and Sun: no words on photographs. A page-opening band sets its title on sand above the
     photograph, and the photograph opens from an inset frame to full bleed as the page scrolls
     (data-widen, scripts/motion.ts). Any other band keeps its words on sand beneath it. */
  .band { position: relative; }
  .band__frame { position: relative; overflow: hidden; background: var(--sand-40); }
  .band--screen .band__frame { height: 92svh; min-height: 30rem; }
  .band--tall .band__frame { height: 80svh; min-height: 26rem; }
  .band--band .band__frame { height: clamp(22rem, 36vw + 8rem, 46rem); }
  .band--auto .band__frame { aspect-ratio: 21 / 9; min-height: 18rem; }
  .band--hero .band__frame { height: clamp(24rem, 72svh, 52rem); min-height: 0; }

  .band__media { position: absolute; inset: 0; }

  .band__head {
    display: grid;
    gap: 1.75rem 3rem;
    padding-top: clamp(2.5rem, 9svh, 7rem);
    padding-bottom: clamp(2.5rem, 6svh, 4.5rem);
    align-items: end;
  }
  .band__heading--hero {
    margin: 0;
    font-size: var(--fs-h1);
    line-height: 1.04;
    max-width: 14em;
  }
  .band__head-aside { max-width: 26rem; }
  .band__head-aside .band__body { margin: 0; font-size: var(--fs-lead); line-height: 1.6; }
  .band__head-aside :global(.band__link) { margin-top: 1.25rem; }
  @media (min-width: 900px) {
    .band__head { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); }
    .band--centre .band__head { grid-template-columns: minmax(0, 1fr); justify-items: center; text-align: center; }
    .band--centre .band__head :global(.eyebrow) { justify-content: center; }
  }

  /* Empty slots for visitors: a band that is only a photograph steps aside until the photograph
     exists, and a hero keeps only its title. */
  :global(html:not([data-media-notes='on'])) .band__frame:has(.band__media .media--placeholder) { display: none; }

  .band__caption {
    margin: 0 auto;
    padding-top: 0.8rem;
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: var(--fs-caption);
    letter-spacing: 0.005em;
    color: var(--sage-80);
    max-width: var(--wrap-max);
  }
  .band__below { padding-top: var(--space-l); }
  .band__below-inner { max-width: 40rem; }
  .band--centre .band__below-inner { margin-inline: auto; text-align: center; }
  .band--centre .band__below-inner :global(.eyebrow) { justify-content: center; }
  .band__below .band__heading { margin: 0; }
  .band__below .band__body { margin-top: 1.25rem; }
  .band :global(.band__link) { margin-top: 1.5rem; }
</style>
