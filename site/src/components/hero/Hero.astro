---
/*
  Home, section 1: the framed horizon (Salt and Sun, signature feature 2).
  The words sit on salt, never on the photograph. Belle's positioning line is centred in HV Muse at
  up to 88px, with the product in one small line beneath it. The brightest summer aerial sits below
  as an inset window (84vw wide at 1440) that opens to full bleed over the first 60 per cent of a
  screen of scroll while the photo settles from 1.08 to 1, and the headline drifts up and fades.
  The two doors sit under the frame, aligned to its left and right edges.
  Until Belle's summer drone clip (DJI_0604) arrives, the still carries a 20 second 3 per cent drift.
  Phones: headline at 40px on salt, the frame full width at 62svh, doors beneath.
  Reduced motion: the frame renders full width, nothing moves.

  <Hero />
*/
import Media from '../media/Media.astro';
import { emphasis } from '../base/text';

interface Door { label: string; href: string }
interface Props {
  media?: string;
  heading?: string;
  sub?: string;
  doors?: Door[];
}
const {
  media = 'home-hero',
  heading = 'Luxury coastal wellness retreats on the *Fleurieu Peninsula*',
  // Drafted in the earlier build (Invitation sub-line), kept word for word and still marked draft.
  sub = '8 hour retreats for private groups and corporate teams, south of Adelaide.',
  doors = [
    { label: 'Private groups and retreats', href: '/private-groups' },
    { label: 'Corporate teams', href: '/corporate' },
  ],
} = Astro.props;
---
<section class="hero" aria-labelledby="hero-heading" data-no-split>
  <div class="hero__top" data-hero-top>
    <h1 class="hero__title" id="hero-heading" set:html={emphasis(heading)} />
    <p class="hero__sub" data-draft>{sub}</p>
  </div>

  <div class="hero__frame" data-hero data-widen="8">
    <div class="hero__media">
      <Media media={media} aspect="fill" priority notePosition="top-right" />
    </div>
  </div>

  <nav class="hero__doors" aria-label="Choose your path">
    {doors.map((d) => (
      <a class="hero__door" href={d.href}>
        <span class="hero__door-label">{d.label}</span>
        <svg class="hero__door-arrow" viewBox="0 0 28 10" width="28" height="10" aria-hidden="true" focusable="false">
          <line x1="0.5" y1="5" x2="27.25" y2="5" />
          <polyline points="22.5,1 27.25,5 22.5,9" />
        </svg>
      </a>
    ))}
  </nav>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-rows: auto auto auto;
    background: transparent;
  }

  .hero__top {
    display: grid;
    justify-items: center;
    text-align: center;
    padding: clamp(1.75rem, 5svh, 3.5rem) var(--gutter) clamp(1.75rem, 4.5svh, 3rem);
  }
  .hero__title {
    margin: 0;
    font-size: var(--fs-display);
    line-height: 1.02;
    letter-spacing: 0.005em;
    color: var(--sage-80);
    max-width: 17em;
  }
  .hero__title :global(.place) { display: inline-block; }
  .hero__sub {
    margin: clamp(1rem, 2.4svh, 1.6rem) 0 0;
    max-width: 40rem;
    font-family: var(--font-ui);
    font-size: var(--fs-small);
    letter-spacing: 0.06em;
    line-height: 1.6;
    color: var(--sage-100);
  }

  .hero__frame {
    position: relative;
    height: 62svh;
    min-height: 20rem;
    overflow: hidden;
    background: var(--sand-40);
  }
  .hero__media { position: absolute; inset: 0; }

  .hero__doors {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1rem;
    padding: 0.35rem var(--gutter) 0;
  }
  .hero__door {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    min-height: 3rem;
    color: var(--sage-80);
    text-decoration: none;
    font-family: var(--font-ui);
    font-size: var(--fs-small);
    letter-spacing: 0.04em;
    line-height: 1.3;
  }
  .hero__door:last-child { justify-self: end; text-align: right; }
  .hero__door-label {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0% 1px no-repeat;
    padding-bottom: 0.2em;
    transition: background-size 450ms var(--ease-settle);
  }
  .hero__door-arrow { flex: none; overflow: visible; }
  .hero__door-arrow :is(line, polyline) {
    fill: none; stroke: currentColor; stroke-width: 1; vector-effect: non-scaling-stroke;
    stroke-linecap: round; stroke-linejoin: round;
    transition: translate 450ms var(--ease-settle);
  }
  @media (hover: hover) {
    .hero__door:hover .hero__door-label { background-size: 100% 1px; }
    .hero__door:hover .hero__door-arrow polyline { translate: 4px 0; }
  }
  .hero__door:focus-visible .hero__door-label { background-size: 100% 1px; }

  /* 700px and up: the first screen holds the line, the framed window and the doors. */
  @media (min-width: 700px) {
    .hero {
      height: calc(100svh - var(--header-h));
      min-height: 36rem;
      grid-template-rows: auto minmax(0, 1fr) auto;
    }
    .hero__frame { height: auto; min-height: 0; }
    .hero__doors { padding-inline: 8vw; }
    .hero__door { font-size: 0.875rem; letter-spacing: 0.06em; min-height: 3.75rem; }
  }
  @media (max-width: 699px) {
    .hero__doors { grid-template-columns: minmax(0, 1fr); gap: 0; padding-top: 0.5rem; }
    .hero__door, .hero__door:last-child { justify-self: stretch; text-align: left; justify-content: space-between; border-bottom: 1px solid var(--rule); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__title { animation: hero-rise 1400ms var(--ease-settle) 250ms both; }
    .hero__sub { animation: hero-rise 1200ms var(--ease-settle) 550ms both; }
    .hero__frame { animation: hero-open 1600ms var(--ease-tide) 150ms both; }
    .hero__door { animation: hero-fade 1000ms var(--ease-settle) 1100ms both; }
    /* A slow breath on the still until the drone clip arrives: 3 per cent over 20 seconds. */
    .hero__media { transform-origin: 50% 60%; animation: hero-drift 20s ease-in-out infinite alternate; }
  }
  @keyframes hero-rise { from { opacity: 0; translate: 0 28px; } to { opacity: 1; translate: 0 0; } }
  @keyframes hero-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes hero-open { from { opacity: 0; translate: 0 40px; } to { opacity: 1; translate: 0 0; } }
  @keyframes hero-drift { from { transform: scale(1) translate3d(0, 0, 0); } to { transform: scale(1.03) translate3d(-0.6%, -0.4%, 0); } }
</style>

<script>
  // As the frame opens, the headline drifts up 40px and fades (redesign direction, the home hero).
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const top = document.querySelector<HTMLElement>('[data-hero-top]');
  if (top && !reduce && window.matchMedia('(min-width: 700px)').matches) {
    gsap.to(top, {
      y: -40,
      opacity: 0,
      ease: 'none',
      scrollTrigger: { trigger: document.body, start: 0, end: () => `+=${window.innerHeight * 0.55}`, scrub: 0.6 },
    });
  }
</script>
