---
/*
  Private groups (page builder A), plan/11 4.2 with build spec 12. Same layout as /corporate in
  different language (pages/_parts/AudiencePage.astro, UX build 27-09-2026: five sections, no
  timeline, one "Plan your day").

  Belle's words, verbatim:
  - "Birthdays, milestone celebrations, sister weekends, family resets or simply time with people who
    matter." lamarea.com.au/luxury-retreats, Private Group Retreats
  - "Intimate, privately curated retreats for friends, families and aligned groups seeking meaningful
    time away together. Each experience is tailored to your group and hosted across our luxury coastal
    and vineyard partner properties." lamarea.com.au home, Private Group Retreats
  - "Guided by our personalisation pillar, each retreat location is carefully matched to the group and
    the retreat intention." lamarea.com.au/accommodation-partners
  - FAQ answers: lamarea.com.au/faqs (faqs collection)
  Drafted, marked: the H1, section headings and the closing line. The guide line went on 28-09-2026 (Jess P3).
  Group size: no single number publishes (the live page says 6 to 10, the guide 10 to 14); sizes vary
  by venue (decision 14).
*/
import Base from '../layouts/Base.astro';
import AudiencePage from './_parts/AudiencePage.astro';
import { getVenues, getFaqs, getTestimonials } from '../lib/content';
import { faqJsonLd } from '../components/base/schema';
import { site } from '../data/settings';

const venues = await getVenues();
// Interstate groups need the airport transfer answer more than the packing list (audience review 27-09).
const order = ['faq-06', 'faq-12', 'faq-02', 'faq-03', 'faq-09'];
const faqs = (await getFaqs()).filter((f) => order.includes(f.id));
faqs.sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));

// Reviews from groups of friends and women's retreats, never the corporate mornings.
const reviews = (await getTestimonials()).filter(
  (t) => t.data.group_type !== 'corporate' && (t.data.featured_on.includes('private') || ['sunset_retreat', 'womens_retreat'].includes(t.data.format)),
);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Private group wellness retreats',
    serviceType: '8 hour wellness retreat for private groups',
    provider: { '@type': 'Organization', name: site.name, url: site.url },
    areaServed: { '@type': 'Place', name: 'Fleurieu Peninsula, South Australia' },
    audience: { '@type': 'Audience', audienceType: 'Private groups of friends and family' },
  },
  faqJsonLd(faqs.map((f) => ({ question: f.data.question, answer: f.data.answer.join(' ') }))),
];
---
<Base
  title="Private group retreats, Fleurieu Peninsula"
  description="Private group retreats on the Fleurieu Peninsula, South Australia: the 8 hour immersive retreat for friends and family, with transport from Adelaide."
  headerTone="immersive"
  jsonLd={jsonLd}
>
  <AudiencePage
    audience="private"
    crumb="For private groups"
    opener={{
      media: 'a-private-opener-film',
      eyebrow: 'For private groups',
      lines: ['Private group', 'retreats'],
      indents: [0, 1.6],
      line: 'Birthdays, milestone celebrations, sister weekends, family resets or simply time with people who matter.',
      place: 'top-left',
      phonePlace: 'bottom',
      who: 'Friends, families and aligned groups',
    }}
    who={{
      statement: 'Intimate, privately curated retreats for friends, families and aligned groups seeking meaningful time away together.',
      paragraphs: ['Each experience is tailored to your group and hosted across our luxury coastal and vineyard partner properties.'],
      large: 'a-private-walk',
      detail: 'a-detail-oil-bread',
      shape: 'arch',
      aside: { text: 'Looking for a weekend away?', label: 'See shorter retreats and weekends', href: '/retreats#shorter' },
    }}
    includes={[
      'Energising group vinyasa yoga flow or mat pilates',
      'Individual restorative massage therapy',
      'Guided group contrast therapy experience',
      'Shared private chef curated Mediterranean-inspired lunch',
      'Luxury private return group transport from Adelaide',
    ]}
    venues={{
      heading: 'Places to Pause for your group',
      intro: 'Guided by our personalisation pillar, each retreat location is carefully matched to the group and the retreat intention.',
      items: venues,
    }}
    proof={{ heading: 'In our guests’ words', items: reviews, media: 'a-quotes-private' }}
    questions={{ faqs, after: { label: 'Where is the Fleurieu Peninsula?', href: '/fleurieu-peninsula-retreats' } }}
    close={{ media: 'a-close-cliffs', caption: 'The Fleurieu coast' }}
  />
</Base>
