---
/*
  404 (page builder D, plan/11 4.25). One line and three paths, Private groups, Corporate and
  Plan your day, over a calm image slot. The image sits in a frame inset from the page edges, so
  the header stays a sand strip and nothing is laid under it. On wide screens the words sit over the
  lower left of the image on a soft local gradient (no full-frame scrim); below 700px the image
  takes the top of the screen and the words sit on sand beneath it.
  Cloudflare Pages serves dist/404.html for unknown paths. noindex.
*/
import Base from '../layouts/Base.astro';
import Media from '../components/media/Media.astro';
import ArrowLink from '../components/base/ArrowLink.astro';
import { cta } from '../data/settings';

const paths = [
  { label: 'Private groups', href: '/private-groups' },
  { label: 'Corporate', href: '/corporate' },
  { label: cta.plan.label, href: `${cta.plan.href}?source=404` },
];
---
<Base title="Page not found" description="This page has moved or is no longer on the La maréa site." noindex>
  <section class="nf" aria-labelledby="nf-title">
    <div class="nf__frame">
      <Media media="notfound-calm" aspect="fill" priority notePosition="top-right" />
      <div class="nf__shade" aria-hidden="true"></div>
    </div>
    <div class="nf__content">
      <h1 class="nf__title" id="nf-title" data-draft>This page has drifted, but the rest of La maréa is here.</h1>
      <ul class="nf__paths" role="list">
        {paths.map((p) => <li><ArrowLink href={p.href} label={p.label} size="large" /></li>)}
      </ul>
    </div>
  </section>
</Base>

<style>
  .nf { display: grid; padding: clamp(0.75rem, 1.5vw, 1.25rem) var(--gutter) var(--section-y); }
  .nf__frame { position: relative; overflow: hidden; background: var(--sand-40); aspect-ratio: 4 / 5; max-height: 62svh; width: 100%; }
  .nf__shade { display: none; }
  .nf__content { padding-top: clamp(1.75rem, 1.4rem + 2vw, 2.5rem); }
  .nf__title { margin: 0; max-width: 15em; font-size: var(--fs-h1); }
  .nf__paths { display: flex; flex-wrap: wrap; gap: 0.25rem clamp(1.5rem, 4vw, 3.5rem); margin: clamp(1.5rem, 1.2rem + 1.5vw, 2.5rem) 0 0; padding: 0; list-style: none; }

  /* Wide screens: the words over the calm lower left of the image. The shared tokens do the colour
     change, so the links stay the site's own ArrowLink. */
  @media (min-width: 700px) {
    .nf { padding-bottom: clamp(0.75rem, 1.5vw, 1.25rem); }
    .nf__frame, .nf__content { grid-area: 1 / 1; }
    .nf__frame { aspect-ratio: auto; max-height: none; height: calc(100svh - var(--header-h) - 2 * clamp(0.75rem, 1.5vw, 1.25rem)); min-height: 30rem; }
    .nf__shade {
      display: block;
      position: absolute;
      inset: auto 0 0 0;
      height: 60%;
      background: linear-gradient(to top, rgb(35 32 14 / 0.3), rgb(35 32 14 / 0));
      pointer-events: none;
    }
    .nf__content {
      position: relative;
      align-self: end;
      padding: 0 clamp(1.5rem, 5vw, 5rem) clamp(2.5rem, 8vh, 5rem);
      --heading: var(--salt-25);
      --focus: var(--focus-on-dark);
    }
    /* While the photograph is still a light placeholder, sage ink and no gradient (QA M3). */
    .nf:has(.media--placeholder) .nf__shade { display: none; }
    .nf:has(.media--placeholder) .nf__content { --heading: var(--sage-100); --focus: var(--sage-80); }
  }
</style>
