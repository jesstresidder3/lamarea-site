---
/*
  Lane L2 rebuild 28-09-2026: a full-bleed opener on emerald water from above, the drafted line over it and the
  three paths beneath, with a slow 20 second drift of about 3 per cent.
  404 (page builder D, plan/11 4.25). One line and three paths, Private groups, Corporate and
  Plan your day, over a calm image slot. The image sits in a frame inset from the page edges, so
  the header stays a sand strip and nothing is laid under it. On wide screens the words sit over the
  lower left of the image on a soft local gradient (no full-frame scrim); below 700px the image
  takes the top of the screen and the words sit on sand beneath it.
  Cloudflare Pages serves dist/404.html for unknown paths. noindex.
*/
import Base from '../layouts/Base.astro';
import ArrowLink from '../components/base/ArrowLink.astro';
import PageOpener from '../components/pages/a/PageOpener.astro';
import { cta } from '../data/settings';

const paths = [
  { label: 'Private groups', href: '/private-groups' },
  { label: 'Corporate', href: '/corporate' },
  { label: cta.plan.label, href: `${cta.plan.href}?source=404` },
];
---
<Base title="Page not found" description="This page has moved or is no longer on the La maréa site." noindex headerTone="immersive">
  <PageOpener
    id="nf"
    media="a-404"
    lines={['This page has drifted,', 'but the rest of La maréa', 'is here.']}
    indents={[0, 0.8, 1.6]}
    titleDraft
    place="bottom-left"
    phonePlace="bottom"
    drift
  >
    <ul class="nf__paths on-media-panel" role="list">
      {paths.map((p) => <li><ArrowLink href={p.href} label={p.label} size="large" /></li>)}
    </ul>
  </PageOpener>
</Base>

<style>
  /* G1: the three paths sit on the shared sand glass panel over the photograph. */
  .nf__paths { display: flex; flex-wrap: wrap; gap: 0.25rem clamp(1.5rem, 4vw, 3.5rem); margin: 0; padding: 0.85rem 1.25rem; list-style: none; }
  :global(#nf-title) { font-size: clamp(2.2rem, 1rem + 3.6vw, 4.25rem); }
</style>
