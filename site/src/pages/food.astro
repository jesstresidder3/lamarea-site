---
/*
  Food and sample menus, /food. Owner: page builder B. UX build 27-09-2026: renamed from "The Table",
  sample menus moved to the second section for returning visitors, the intro line folded into the
  food philosophy, and the chef and producers section cut (the chef is on /team).
  "really touching on our food philosophy around the Mediterranean diet and plant based eating and
  really showing guests... what food looks like on a retreat with us" (BD-84), fine dining and shared
  eating (BD-85), "breakfast to refreshments... to lunches" (BD-86), her heading "Signature culinary
  experiences" (BD-88), local producers (BD-89) and "the flavours of the Fleurieu" (BD-131).

  1 full-bleed food hero, "The flavours of the Fleurieu", with a link to the sample menus
  2 sample menus (Accordion, seasonal and an example) beside dietary needs (live FAQ)
  3 Signature culinary experiences (SignatureTabs; the masterclass carries its open question)
  4 the food philosophy, opening with "At La maréa, food is a central part of the experience."
  5 the day at the table (MealMoments; dinner and dessert are marked placeholders)
  6 fine dining and the shared table
  7 Plan your day
*/
import Base from '../layouts/Base.astro';
import PairOpener from '../components/pages/c/PairOpener.astro';
import OffsetPair from '../components/base/OffsetPair.astro';
import SlideStrip from '../components/base/SlideStrip.astro';
import ClosingTide from '../components/base/ClosingTide.astro';
import MenuCourses from '../components/food/MenuCourses.astro';
import SectionHead from '../components/base/SectionHead.astro';
import NumberedMoments from '../components/base/NumberedMoments.astro';
import ArrowLink from '../components/base/ArrowLink.astro';
import Reveal from '../components/base/Reveal.astro';
import MealStrip from '../components/food/MealStrip.astro';
import SignatureTabs from '../components/food/SignatureTabs.astro';
import Flag from '../components/pages/b/Flag.astro';
import { getMealMoments, signatureItems, getFaqs, peopleById, experiencesById } from '../lib/content';

const moments = await getMealMoments({ publicOnly: true });
const lunch = moments.find((m) => m.data.service === 'lunch');
/* The example menu has its own moment below, so the lunch card shows the meal and not the menu twice. */
const dayAtTable = moments.map((m) => (m.data.service === 'lunch' ? { ...m, data: { ...m.data, courses: [], title_as_published: undefined } } : m));

/* Signature culinary experiences, in Belle's own names for them (BD-88). The masterclass shows Belle's
   own words about one that ran; who runs it for La maréa is the open question (plan/11 Q3). */
const ex = await experiencesById();
const pastaStory = ex.get('pasta-making')?.data.descriptions[3]?.text[0];
const signature = (await signatureItems()).map((it) =>
  it.id === 'mediterranean-table'
    ? { ...it, title: 'Three course Mediterranean chef curated dining' }
    : { ...it, title: 'Pasta making masterclass', paragraphs: pastaStory ? [`${pastaStory}.`] : it.paragraphs.filter((t) => !t.includes('Malissa')) },
);

const faqs = await getFaqs();
const dietary = faqs.find((f) => f.id === 'faq-03');
const people = await peopleById();
const chef = lunch?.data.chef ? people.get(lunch.data.chef) : undefined;
const producers = lunch?.data.producers ?? [];
const producerUse: Record<string, string> = {
  'Peninsula Providore': 'Marinated olives, with house-made hummus and crudité',
  'La Vera': 'Fresh mozzarella, in the baked eggplant parmigiana',
};
const courses = lunch?.data.courses ?? [];
const dishCount = (lunch?.data.courses ?? []).reduce((n, c) => n + c.dishes.length, 0);
---
<Base
  title="Food and sample menus, Mediterranean food on the Fleurieu"
  description="The food on a La maréa retreat on the Fleurieu Peninsula: Mediterranean inspired, plant based and seasonal, with a sample menu, from breakfast to a shared chef curated lunch."
  headerTone="over-media"
>
  <!-- 1. The flavours of the Fleurieu: a two page spread, the long table and the pass -->
  <PairOpener
    media="c-food-opener"
    second="c-food-oil-pour"
    lines={['The flavours', 'of the *Fleurieu*']}
    eyebrow="Food and sample menus"
    sub="Inspired by the elements of a Mediterranean lifestyle; plant based nourishment, connection, community & longevity."
    id="fd-title"
  >
    <ArrowLink slot="after" href="#sample-menus" label="See the sample menus" />
  </PairOpener>

  <!-- 2. Sample menus: a printed menu, each course with a plate sliding in from the right -->
  <section class="section fd-menu" id="sample-menus" aria-labelledby="fd-menu" data-ground="salt">
    <div class="wrap">
      <SectionHead eyebrow="An example menu, seasonal" heading="Sample menus" id="fd-menu" draft={{ heading: true }} />
      <MenuCourses
        courses={courses}
        plates={['c-food-tortelli-lemons', 'c-food-kingfish', 'c-food-grilled-veg']}
        note="Menu items vary depending on seasonality and produce availability."
      />
      <Flag>Belle’s example menu from the Naiko Encounter Bay guide (p.14), {dishCount} dishes across three courses as published (plan/11 counted nine). Whether menus go public is decision 8; the public flag in the menus collection switches it off. The plates beside each course are from the retreat table, not the named dishes.</Flag>
      {dietary && (
        <aside class="fd-menu__diet" aria-labelledby="fd-diet">
          <h3 class="fd-menu__diet-title" id="fd-diet">Dietary needs</h3>
          <div class="fd-menu__diet-body">
            {dietary.data.answer.map((t) => <p>{t}</p>)}
            <ArrowLink href="/faqs" label="More questions and answers" />
          </div>
        </aside>
      )}
    </div>
  </section>

  <!-- 3. Signature culinary experiences -->
  <section class="section fd-signature" aria-labelledby="fd-sig">
    <div class="wrap">
      <SectionHead heading="Signature culinary experiences" id="fd-sig" align="centre" />
      <SignatureTabs items={signature} />
    </div>
  </section>

  <!-- 4. The food philosophy: an editorial pair, the chef at the pass and a finished plate -->
  <section class="section fd-philosophy" aria-labelledby="fd-phil" data-ground="warm">
    <OffsetPair large="c-food-chef-pouring" detail="c-food-chef-oil">
      <p class="fd-eyebrow">Our food philosophy</p>
      <h2 id="fd-phil">Simple, seasonal and shared</h2>
      <p>At La maréa, food is a central part of the experience. It is designed to be nourishing, Mediterranean-inspired, and practical, with a touch of chef-led luxury. You will learn and taste meals that feel enjoyable and realistic to continue at home.</p>
      <p>Our lifestyle wellness retreats are deeply inspired by the Mediterranean way of living, where nourishment is simple, seasonal, and shared.</p>
    </OffsetPair>
    <div class="wrap fd-philosophy__grid">
      <p class="fd-philosophy__long">The Mediterranean dietary pattern is widely recognised as one of the healthiest in the world. It’s built on an abundance of fresh vegetables and fruits, whole grains, legumes, nuts, quality olive oil, herbs, and seafood, along with a naturally relaxed approach to mealtimes. It’s as much about how you eat as what you eat: slowly, socially, and with gratitude.</p>
      <div class="fd-philosophy__rules">
        <p class="label">What to expect</p>
        <NumberedMoments
          slide
          items={[
            { text: 'Fresh, local, and seasonal whole-food meals, thoughtfully prepared using local organic fruit and vegetables.' },
            { text: 'A Mediterranean inspired menu with a strong emphasis on plant based whole foods, plus locally sourced seafood.' },
            { text: 'Meals designed in alignment with Belle’s evidence based approach to nutrition and lifestyle wellness.' },
          ]}
        />
      </div>
    </div>
  </section>

  <!-- 5. The day at the table -->
  <section class="section fd-day" aria-labelledby="fd-day">
    <div class="wrap">
      <SectionHead eyebrow="From breakfast to lunch" heading="The day at the table" id="fd-day" draft={{ heading: true }} />
      <MealStrip moments={dayAtTable} label="The day at the table" />
      <Flag>The lunch words are the Naiko Encounter Bay guide (p.13), where Luca Guiotto cooks; at Beresford the lunch is provided by Beresford, so no time from that day is shown here. Dinner and dessert wait on the menus in Belle’s retreat guide (BD-87); the 8 hour immersive retreat itself has no dinner.</Flag>
    </div>
  </section>

  <!-- 6. Fine dining and the shared table: plates sliding in from the right -->
  <section class="section fd-tables" aria-labelledby="fd-tables">
    <div class="wrap fd-tables__head">
      <SectionHead eyebrow="Fine dining and the shared table" heading="Chef-led plates, one long table" id="fd-tables" size="small" draft={{ heading: true }} />
      <p class="fd-tables__line">Shared dining that encourages connection and unhurried conversation.</p>
    </div>
    <SlideStrip
      label="From the table"
      items={[
        { media: 'c-food-tortelli-lemons', title: 'Tortelli with lemons', ratio: '3 / 4' },
        { media: 'c-food-fish-mussels', title: 'Seafood, shared' },
        { media: 'c-xp-table-wine', title: 'The table, set', ratio: '3 / 2' },
        { media: 'c-food-grilled-veg', title: 'Grilled vegetables' },
        { media: 'c-food-chef-bench', title: 'At the kitchen bench', ratio: '3 / 4' },
        { media: 'c-food-brownies', title: 'Something sweet' },
      ]}
    />
  </section>

  <!-- 7. Plan your day -->
  <ClosingTide
    line="Gather around the table"
    params={{ source: 'food' }}
    media="c-xp-long-table-group"
    lineDraft
  />
</Base>

<style>
  /* 3 */
  .fd-philosophy__grid { display: grid; gap: var(--space-xl); margin-top: clamp(3rem, 7vw, 6rem); }
  .fd-philosophy :global(.moment__text--line) { font-size: clamp(1.2rem, 1.05rem + 0.5vw, 1.5rem); }
  @media (min-width: 900px) {
    .fd-philosophy__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(3rem, 7vw, 7rem); align-items: start; }
    .fd-philosophy__rules { padding-top: 0.5rem; }
  }

  /* 6 */
  .fd-tables__head { display: grid; gap: 1rem 4rem; margin-bottom: clamp(2rem, 4vw, 3.5rem); }
  .fd-tables__line { margin: 0; font-family: var(--font-editorial); font-style: italic; font-size: clamp(1.35rem, 1.1rem + 0.9vw, 1.85rem); line-height: 1.35; color: var(--sage-100); max-width: 20em; }
  @media (min-width: 900px) { .fd-tables__head { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: end; } }
  .fd-tables { padding-inline: 0; }
  .fd-eyebrow { margin: 0 0 1rem; font-family: var(--font-editorial); font-style: italic; font-size: 1.1875rem; color: var(--sage-80); }
  .fd-philosophy h2 { margin: 0 0 1.5rem; }
  .fd-philosophy__long { max-width: 34rem; margin: 0; color: var(--sage-100); }

  /* 6 */
  .fd-signature :global(.section-head) { margin-bottom: clamp(1.5rem, 3vw, 2.5rem); }

  /* 2 */
  .fd-menu :global(.section-head) { margin-bottom: clamp(2rem, 4vw, 3.5rem); }
  .fd-menu__diet { display: grid; gap: 1rem 4rem; margin-top: clamp(3rem, 6vw, 5rem); padding-top: 1.5rem; border-top: 1px solid var(--rule-strong); }
  .fd-menu__diet-title { margin: 0; font-family: var(--font-display); font-size: var(--fs-card); }
  .fd-menu__diet-body p { font-size: var(--fs-small); line-height: 1.65; max-width: 38rem; }
  @media (min-width: 900px) { .fd-menu__diet { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); } }
</style>
