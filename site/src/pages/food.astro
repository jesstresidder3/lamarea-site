---
/*
  The Table, /food. Owner: page builder B.
  "really touching on our food philosophy around the Mediterranean diet and plant based eating and
  really showing guests... what food looks like on a retreat with us" (BD-84), fine dining and shared
  eating (BD-85), "breakfast to refreshments... to lunches" (BD-86), her heading "Signature culinary
  experiences" (BD-88), local producers (BD-89) and "the flavours of the Fleurieu" (BD-131).

  1 full-bleed food hero, "The flavours of the Fleurieu"
  2 "At La maréa, food is a central part of the experience."
  3 the food philosophy: Mediterranean, plant based, seasonal (guide p.12, the live journal intro)
  4 the day at the table (MealMoments; dinner and dessert are marked placeholders)
  5 fine dining and the shared table
  6 Signature culinary experiences (SignatureTabs; the masterclass carries its open question)
  7 the example menu (Accordion, seasonal and an example) beside dietary needs (live FAQ)
  8 the people behind the table: the chef, and the producers named in the menu
  9 Plan your day
*/
import Base from '../layouts/Base.astro';
import MediaBand from '../components/base/MediaBand.astro';
import SectionHead from '../components/base/SectionHead.astro';
import NumberedMoments from '../components/base/NumberedMoments.astro';
import Accordion from '../components/base/Accordion.astro';
import ArrowLink from '../components/base/ArrowLink.astro';
import CtaBand from '../components/base/CtaBand.astro';
import Reveal from '../components/base/Reveal.astro';
import MealMoments from '../components/food/MealMoments.astro';
import SignatureTabs from '../components/food/SignatureTabs.astro';
import Media from '../components/media/Media.astro';
import PersonCard from '../components/pages/b/PersonCard.astro';
import Flag from '../components/pages/b/Flag.astro';
import { getMealMoments, signatureItems, getFaqs, peopleById, experiencesById } from '../lib/content';
import { listHtml } from '../components/pages/b/copy';
import { cta } from '../data/settings';

const moments = await getMealMoments({ publicOnly: true });
const lunch = moments.find((m) => m.data.service === 'lunch');
/* The example menu has its own moment below, so the lunch card shows the meal and not the menu twice. */
const dayAtTable = moments.map((m) => (m.data.service === 'lunch' ? { ...m, data: { ...m.data, courses: [], title_as_published: undefined } } : m));

/* Signature culinary experiences, in Belle's own names for them (BD-88). The masterclass shows Belle's
   own words about one that ran; who runs it for La maréa is the open question (plan/11 Q3). */
const ex = await experiencesById();
const pastaStory = ex.get('pasta-making')?.data.descriptions[3]?.text[0];
const signature = (await signatureItems()).map((it) =>
  it.id === 'mediterranean-table'
    ? { ...it, title: 'Three course Mediterranean chef curated dining' }
    : { ...it, title: 'Pasta making masterclass', paragraphs: pastaStory ? [`${pastaStory}.`] : it.paragraphs.filter((t) => !t.includes('Malissa')) },
);

const faqs = await getFaqs();
const dietary = faqs.find((f) => f.id === 'faq-03');
const people = await peopleById();
const chef = lunch?.data.chef ? people.get(lunch.data.chef) : undefined;
const producers = lunch?.data.producers ?? [];
const producerUse: Record<string, string> = {
  'Peninsula Providore': 'Marinated olives, with house-made hummus and crudité',
  'La Vera': 'Fresh mozzarella, in the baked eggplant parmigiana',
};
const menu = (lunch?.data.courses ?? []).map((c, i) => ({ title: c.course, body: listHtml(c.dishes, 'menu-dishes'), open: i === 0 }));
const dishCount = (lunch?.data.courses ?? []).reduce((n, c) => n + c.dishes.length, 0);
---
<Base
  title="The Table, Mediterranean food on the Fleurieu"
  description="Mediterranean inspired, plant based, seasonal food on La maréa’s Fleurieu retreats, from breakfast to a shared chef curated lunch."
  headerTone="over-media"
>
  <!-- 1. The flavours of the Fleurieu -->
  <div class="fd-hero">
    <MediaBand
      media="food-hero"
      height="tall"
      hero
      parallax={false}
      text="over"
      eyebrow="The Table"
      heading="The flavours of the *Fleurieu*"
      level={1}
      body="Inspired by the elements of a Mediterranean lifestyle; plant based nourishment, connection, community & longevity."
    />
  </div>

  <!-- 2. Food at La maréa -->
  <section class="section fd-intro" aria-labelledby="fd-intro">
    <div class="wrap fd-intro__grid">
      <h2 class="fd-intro__lead" id="fd-intro">At La maréa, food is a central part of the experience.</h2>
      <Reveal class="fd-intro__body">
        <p>It is designed to be nourishing, Mediterranean-inspired, and practical, with a touch of chef-led luxury. You will learn and taste meals that feel enjoyable and realistic to continue at home.</p>
      </Reveal>
    </div>
  </section>

  <!-- 3. The food philosophy -->
  <section class="section band-salt fd-philosophy" aria-labelledby="fd-phil">
    <div class="wrap fd-philosophy__grid">
      <div class="fd-philosophy__text">
        <SectionHead eyebrow="Our food philosophy" heading="Simple, seasonal and shared" id="fd-phil" />
        <p>Our lifestyle wellness retreats are deeply inspired by the Mediterranean way of living, where nourishment is simple, seasonal, and shared.</p>
        <p>The Mediterranean dietary pattern is widely recognised as one of the healthiest in the world. It’s built on an abundance of fresh vegetables and fruits, whole grains, legumes, nuts, quality olive oil, herbs, and seafood, along with a naturally relaxed approach to mealtimes. It’s as much about how you eat as what you eat: slowly, socially, and with gratitude.</p>
      </div>
      <div class="fd-philosophy__rules">
        <p class="label">What to expect</p>
        <NumberedMoments
          slide
          items={[
            { text: 'Fresh, local, and seasonal whole-food meals, thoughtfully prepared using local organic fruit and vegetables.' },
            { text: 'A Mediterranean inspired menu with a strong emphasis on plant based whole foods, plus locally sourced seafood.' },
            { text: 'Meals designed in alignment with Belle’s evidence based approach to nutrition and lifestyle wellness.' },
          ]}
        />
      </div>
    </div>
  </section>

  <!-- 4. The day at the table -->
  <section class="section fd-day" aria-labelledby="fd-day">
    <div class="wrap">
      <SectionHead eyebrow="From breakfast to lunch" heading="The day at the table" id="fd-day" draft={{ heading: true }} />
      <MealMoments moments={dayAtTable} label="The day at the table" />
      <Flag>The lunch words are the Naiko Encounter Bay guide (p.13), where Luca Guiotto cooks; at Beresford the lunch is provided by Beresford, so no time from that day is shown here. Dinner and dessert wait on the menus in Belle’s retreat guide (BD-87); the 8 hour day itself has no dinner.</Flag>
    </div>
  </section>

  <!-- 5. Fine dining and the shared table -->
  <section class="section band-warm fd-tables" aria-labelledby="fd-tables">
    <div class="wrap fd-tables__grid">
      <figure class="fd-tables__fine">
        <div class="fd-tables__frame fd-tables__frame--tall"><Media media="food-fine-dining" aspect="fill" /></div>
        <figcaption>Fine dining</figcaption>
      </figure>
      <div class="fd-tables__text">
        <SectionHead eyebrow="Fine dining and the shared table" heading="Chef-led plates, one long table" id="fd-tables" size="small" draft={{ heading: true }} />
        <p class="fd-tables__line">Shared dining that encourages connection and unhurried conversation.</p>
      </div>
      <figure class="fd-tables__shared">
        <div class="fd-tables__frame fd-tables__frame--wide"><Media media="food-shared-table" aspect="fill" /></div>
        <figcaption>The shared table</figcaption>
      </figure>
    </div>
  </section>

  <!-- 6. Signature culinary experiences -->
  <section class="section fd-signature" aria-labelledby="fd-sig">
    <div class="wrap">
      <SectionHead heading="Signature culinary experiences" id="fd-sig" align="centre" />
      <SignatureTabs items={signature} />
    </div>
  </section>

  <!-- 7. The example menu and dietary needs -->
  <section class="section band-salt fd-menu" aria-labelledby="fd-menu">
    <div class="wrap fd-menu__grid">
      <div class="fd-menu__menu">
        <SectionHead eyebrow="An example menu, seasonal" heading="Lunch, course by course" id="fd-menu" size="small" draft={{ heading: true }} />
        <Accordion items={menu} titleTag="h3" name="example-menu" />
        <p class="fd-menu__note">Menu items vary depending on seasonality and produce availability.</p>
        <Flag>Belle’s example menu from the Naiko Encounter Bay guide (p.14), {dishCount} dishes across three courses as published (plan/11 counted nine). Whether menus go public is decision 8; the public flag in the menus collection switches it off.</Flag>
      </div>
      {dietary && (
        <aside class="fd-menu__diet" aria-labelledby="fd-diet">
          <h3 class="fd-menu__diet-title" id="fd-diet">Dietary needs</h3>
          {dietary.data.answer.map((t) => <p>{t}</p>)}
          <ArrowLink href="/faqs" label="More questions and answers" />
        </aside>
      )}
    </div>
  </section>

  <!-- 8. The people behind the table -->
  <section class="section fd-people" aria-labelledby="fd-people">
    <div class="wrap">
      <SectionHead eyebrow="The people behind the table" heading="Our chef and local producers" id="fd-people" draft={{ heading: true }}>
        <ArrowLink slot="aside" href="/team" label="Meet the team" />
      </SectionHead>
      <div class="fd-people__grid">
        {chef && <PersonCard person={chef} size="feature" />}
        <div class="fd-producers">
          <p class="fd-producers__lead">Partner with local South Australian companies, supporting local Fleurieu Peninsula farmers, producers & communities.</p>
          <ul class="fd-producers__list" role="list">
            {producers.map((name) => (
              <li>
                <span class="fd-producers__name">{name}</span>
                {producerUse[name] && <span class="fd-producers__use" data-draft>{producerUse[name]}</span>}
              </li>
            ))}
          </ul>
          <p class="placeholder-line">More producer names from Belle</p>
          <Flag>Peninsula Providore and La Vera are the two producers named in Belle’s example menu. Neither is yet verified as Fleurieu based, so neither is called that here. The live partners page shows more logos without saying which are on the Fleurieu (research/09 question 10).</Flag>
        </div>
      </div>
    </div>
  </section>

  <!-- 9. Plan your day -->
  <CtaBand
    line="Gather around the table"
    params={{ source: 'food' }}
    note={cta.callNote}
    draft={{ line: true }}
  />
</Base>

<style>
  /* 2 */
  .fd-intro__grid { display: grid; gap: var(--space-m); }
  .fd-intro__lead { margin: 0; max-width: 16em; font-size: var(--fs-h2); }
  .fd-intro :global(.fd-intro__body) p { font-family: var(--font-serif); font-size: var(--fs-lead); line-height: 1.5; color: var(--sage-100); max-width: 30rem; }
  @media (min-width: 900px) {
    .fd-intro__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(3rem, 7vw, 7rem); align-items: end; }
  }

  /* 3 */
  .fd-philosophy__grid { display: grid; gap: var(--space-xl); }
  .fd-philosophy__text > p { max-width: 32rem; }
  .fd-philosophy :global(.moment__text--line) { font-size: clamp(1.2rem, 1.05rem + 0.5vw, 1.5rem); }
  @media (min-width: 900px) {
    .fd-philosophy__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(3rem, 7vw, 7rem); align-items: start; }
    .fd-philosophy__rules { padding-top: 0.5rem; }
  }

  /* 5 */
  .fd-tables__grid { display: grid; gap: var(--space-l); }
  .fd-tables__frame { position: relative; overflow: hidden; background: var(--sand-60); }
  .fd-tables__frame--tall { aspect-ratio: 4 / 5; }
  .fd-tables__frame--wide { aspect-ratio: 3 / 2; }
  .fd-tables figure { margin: 0; }
  .fd-tables figcaption { margin-top: 0.8rem; font-family: var(--font-ui); font-size: var(--fs-label); letter-spacing: var(--track-label); color: var(--muted); }
  .fd-tables__line { margin: 0; font-family: var(--font-serif); font-size: clamp(1.35rem, 1.1rem + 0.9vw, 1.85rem); line-height: 1.35; color: var(--sage-100); max-width: 20em; }
  @media (min-width: 900px) {
    .fd-tables__grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 1fr) minmax(0, 6fr);
      grid-template-areas: 'fine . text' 'fine . shared';
      gap: clamp(1.5rem, 3vw, 3rem) 0;
      align-items: start;
    }
    .fd-tables__fine { grid-area: fine; }
    .fd-tables__text { grid-area: text; padding-top: clamp(1rem, 4vw, 4rem); }
    .fd-tables__shared { grid-area: shared; align-self: end; }
  }

  /* 6 */
  .fd-signature :global(.section-head) { margin-bottom: clamp(1.5rem, 3vw, 2.5rem); }

  /* 7 */
  .fd-menu__grid { display: grid; gap: var(--space-xl); }
  @media (min-width: 900px) { .fd-menu__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: clamp(3rem, 8vw, 8rem); } }
  .fd-menu__note { margin: 1.25rem 0 0; font-size: var(--fs-small); color: var(--sage-80); }
  .fd-menu :global(.menu-dishes) { margin: 0; padding: 0; list-style: none; }
  .fd-menu :global(.menu-dishes li) { padding: 0.6rem 0; border-top: 1px solid var(--sage-20); font-family: var(--font-serif); font-size: 1.1rem; line-height: 1.45; color: var(--sage-100); }
  .fd-menu__diet { padding-top: 1.5rem; border-top: 1px solid var(--rule-strong); }
  @media (min-width: 900px) { .fd-menu__diet { margin-top: 4.5rem; } }
  .fd-menu__diet-title { margin: 0 0 1rem; font-family: var(--font-serif); font-size: var(--fs-card); }
  .fd-menu__diet p { font-size: var(--fs-small); line-height: 1.65; }

  /* 8 */
  .fd-people__grid { display: grid; gap: var(--space-xl); }
  @media (min-width: 1000px) { .fd-people__grid { grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: clamp(3rem, 6vw, 6rem); align-items: end; } }
  .fd-producers__lead { margin: 0 0 1.5rem; font-family: var(--font-serif); font-size: var(--fs-lead); line-height: 1.45; color: var(--sage-100); }
  .fd-producers__list { margin: 0 0 1.25rem; padding: 0; list-style: none; border-top: 1px solid var(--rule); }
  .fd-producers__list li { display: grid; gap: 0.2rem; padding: 0.9rem 0; border-bottom: 1px solid var(--rule); }
  .fd-producers__name { font-family: var(--font-serif); font-size: var(--fs-card); line-height: 1.2; color: var(--heading); }
  .fd-producers__use { font-size: var(--fs-small); color: var(--sage-80); }
</style>
