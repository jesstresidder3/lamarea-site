---
/*
  Corporate (page builder A), plan/11 4.3 with build spec 12. Same layout as /private-groups in
  different language (pages/_parts/AudiencePage.astro, UX build 27-09-2026: five sections, no
  timeline, one "Plan your day").

  Belle's words, verbatim:
  - "A strategic reset for leadership teams and high-performing professionals." and her corporate
    paragraphs, lamarea.com.au/luxury-retreats, Corporate Retreats (dash replaced with a comma)
  - "Guided by our personalisation pillar, each retreat location is carefully matched to the group and
    the retreat intention." lamarea.com.au/accommodation-partners
  - FAQ answers: lamarea.com.au/faqs (faqs collection)
  Drafted, marked: the H1, section headings and the closing line. The guide line went on 28-09-2026 (Jess P3),
  and the small detail photo beside Belle's statement, so the page has fewer things at once (Jess C1).
  Proof is anonymised: reviews show a descriptor and the format, never a name, and no client is named
  anywhere on the page until Belle has written permission (plan/11 item 63).
  Group size: no single number publishes (the live page says up to 20, the guide 10 to 14); sizes vary
  by venue (decision 14). Venues keep the site order, so the first card has a photograph.
*/
import Base from '../layouts/Base.astro';
import AudiencePage from './_parts/AudiencePage.astro';
import { getVenues, getFaqs, getTestimonials } from '../lib/content';
import { faqJsonLd } from '../components/base/schema';
import { site } from '../data/settings';

const venues = await getVenues();
const order = ['faq-06', 'faq-03', 'faq-02', 'faq-08', 'faq-09'];
const faqs = (await getFaqs()).filter((f) => order.includes(f.id)).sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
const reviews = await getTestimonials({ groupType: 'corporate' });

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Corporate wellness retreats',
    serviceType: '8 hour corporate wellness retreat',
    provider: { '@type': 'Organization', name: site.name, url: site.url },
    areaServed: { '@type': 'Place', name: 'Fleurieu Peninsula, South Australia' },
    audience: { '@type': 'BusinessAudience', audienceType: 'Leadership teams and corporate groups' },
  },
  faqJsonLd(faqs.map((f) => ({ question: f.data.question, answer: f.data.answer.join(' ') }))),
];
---
<Base
  title="Corporate wellness retreats, Fleurieu Peninsula"
  description="Corporate wellness retreats on the Fleurieu Peninsula, South Australia: the 8 hour immersive retreat for leadership teams, with transport from your Adelaide office."
  headerTone="immersive"
  jsonLd={jsonLd}
>
  <AudiencePage
    audience="corporate"
    crumb="For corporate teams"
    opener={{
      media: 'a-corporate-opener',
      eyebrow: 'For corporate teams',
      lines: ['Corporate', 'wellness', 'retreats'],
      indents: [0, 1.2, 2.4],
      line: 'A strategic reset for leadership teams and high-performing professionals.',
      place: 'top-right',
      zoom: 1.42,
      who: 'Leadership teams and professionals',
      whoDraft: true,
    }}
    who={{
      statement: 'Corporate retreats are designed for teams who understand that sustainable performance requires recovery, clarity and nervous system regulation, not just output.',
      paragraphs: [
        'Drawing from La maréa’s ten evidence-based pillars each retreat integrates structured movement, restorative wellness practices, Mediterranean-inspired nourishment and practical lifestyle wellness education. The experience is private by design, creating psychological safety and space for meaningful conversation without distraction.',
      ],
      large: 'a-corporate-rest',
      shape: 'frame',
    }}
    includes={[
      'Energising group vinyasa yoga flow or mat pilates',
      'Individual restorative massage therapy',
      'Group lifestyle wellness workshop',
      'Shared private chef curated Mediterranean-inspired lunch',
      'Luxury private transfer, group pickup from work office',
    ]}
    venues={{
      heading: 'Places to Pause for your team',
      intro: 'Guided by our personalisation pillar, each retreat location is carefully matched to the group and the retreat intention.',
      items: venues,
    }}
    proof={{ heading: 'In our guests’ words', items: reviews, media: 'a-quotes-corporate' }}
    questions={{ faqs }}
    close={{ media: 'a-close-emerald', caption: 'The Fleurieu coast' }}
  />
</Base>
