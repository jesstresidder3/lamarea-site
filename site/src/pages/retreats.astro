---
/*
  Retreats, the hub every buyer starts from (UX build 27-09-2026, build/design/
  ux-information-architecture-27-09-2026.md section 5). Five sections:
  1 hero, what the page is and who it is for, 2 who it is for (the two paths), 3 the 8 hour
  immersive retreat in brief (Belle's guide lines and the three facts, "See the full day"),
  4 shorter retreats and weekends (the other formats and the two waitlists), 5 Plan your day.
  One "Plan your day" in the body, in the closing band. The formats tiles ask about a format instead.

  Belle's words, verbatim (dashes replaced, source in brackets):
  - "There are different seasons that call us to pause. Time with friends, time with family, time to
    reconnect as a team." and "La maréa has been designed to meet each of these moments with
    intention." (lamarea.com.au/luxury-retreats intro)
  - "Your luxury retreat includes a curated day program designed around movement, recovery, nourishing
    food, nervous system support, nature immersion, education and connection." (guide p.15)
  - "A completely curated luxury experience where everything is taken care of, venue, meals, wellness
    sessions, experiences, and clean-up, allowing your group to simply arrive, relax, and enjoy quality
    time together." (guide p.24)
  - Retreat time 8am to 4pm, approx. pick up 7am, drop off 5pm (guide p.24)
  - Format lines: formats collection and harvest section 16; Wake Up To Wellness lines from Belle's
    Instagram captions on the live home page, with no client named.
  No dated retreat is current (the March 2026 weekend and day have passed), so none shows; the two
  waitlists live on 24-09-2026 (Sunset Reset, Women's Wellness Weekend) link to /waitlist.
*/
import Base from '../layouts/Base.astro';
import MediaBand from '../components/base/MediaBand.astro';
import Media from '../components/media/Media.astro';
import Eyebrow from '../components/base/Eyebrow.astro';
import ArrowLink from '../components/base/ArrowLink.astro';
import SectionHead from '../components/base/SectionHead.astro';
import ExpandTile from '../components/base/ExpandTile.astro';
import Reveal from '../components/base/Reveal.astro';
import CtaBand from '../components/base/CtaBand.astro';
import Breadcrumbs from '../components/base/Breadcrumbs.astro';
import { getFormats } from '../lib/content';
import { day } from '../data/day';
import { cta, site, flagshipName } from '../data/settings';
import { withParams } from '../components/base/text';

const formats = await getFormats('format');
const byId = new Map(formats.map((f) => [f.id, f]));
const flagship = byId.get('full-day-retreat');

const esc = (v: string) => v.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const who = (t: string) => `<p class="fmt-who" data-draft>${esc(t)}</p>`;
const para = (t: string) => `<p>${esc(t)}</p>`;
const gap = (t: string) => `<p class="placeholder-line">${esc(t)}</p>`;

// One entry per format in the menu, in the collection's order. Durations as published.
const menu: Record<string, { title: string; eyebrow: string; media: string; summary?: string; body: string; link: { label: string; href: string } }> = {
  'half-day-retreat': {
    title: 'Half day retreats',
    eyebrow: '5 hours',
    media: 'retreats-format-half-day',
    body: who('Suits corporate teams') + gap('One line from Belle on the half day retreat'),
    link: { label: 'Ask about a half day', href: withParams(cta.plan.href, { format: 'half-day', source: 'retreats' }) },
  },
  'wake-up-to-wellness': {
    title: 'Wake Up To Wellness',
    eyebrow: '3 hours, a morning',
    media: 'retreats-format-wake-up',
    summary: 'An immersive luxury retreat designed for a high-performing team.',
    body:
      who('Suits corporate teams and private groups of professionals') +
      para('Through yoga, a seasonal healthy breakfast, nervous system regulation practices, breathwork and evidence-based wellbeing education, we explored practical lifestyle wellness strategies to support energy, stress resilience, recovery and sustainable workplace performance.'),
    link: { label: 'Ask about Wake Up To Wellness', href: withParams(cta.plan.href, { format: 'wake-up-to-wellness', source: 'retreats' }) },
  },
  'sunset-reset': {
    title: 'Sunset Reset',
    eyebrow: '3 hours, an evening',
    media: 'retreats-format-sunset',
    summary: 'Designed to help you slow down, reconnect, and restore by the sea.',
    body:
      who('Suits a family member, a friend or a private group') +
      para('Each curated evening brings together gentle movement, breathwork, nourishing food, meaningful connection, and beautiful coastal settings at sunset.'),
    link: { label: 'Join the Sunset Reset waitlist', href: '/waitlist?list=sunset-reset' },
  },
  'personalised-retreats': {
    title: 'Personalised retreats',
    eyebrow: 'Shaped with you',
    media: 'retreats-format-personalised',
    summary: 'Every La maréa experience is built around you, your people, your goals, your pace.',
    body:
      who('Suits corporate teams, family and friends') +
      gap('Length and inclusions of a personalised retreat, from Belle'),
    link: { label: 'Ask about a personalised retreat', href: withParams(cta.plan.href, { format: 'personalised', source: 'retreats' }) },
  },
  'womens-wellness-weekend': {
    title: 'Women’s Wellness Weekend',
    eyebrow: 'A weekend',
    media: 'retreats-format-weekend',
    summary: 'For women seeking space to restore, reconnect and return to rhythm.',
    body:
      who('Suits women, on their own or with a friend') +
      para('Across the weekend, the environment and structure work together. Ocean air, expansive landscape, Mediterranean-inspired meals and evidence-based wellness sessions begin to soften the pace of daily life.') +
      para('Join the waitlist to receive upcoming dates and early access to bookings.'),
    link: { label: 'Join the weekend waitlist', href: '/waitlist?list=womens-wellness-weekend' },
  },
};
const tiles = formats
  .filter((f) => f.id !== 'full-day-retreat' && menu[f.id])
  .map((f) => menu[f.id]);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'La maréa retreats',
  itemListElement: [
    { '@type': 'ListItem', position: 1, item: { '@type': 'Service', name: '8 hour immersive retreat', provider: { '@type': 'Organization', name: site.name }, areaServed: 'Fleurieu Peninsula, South Australia', url: `${site.url}${cta.seeFullDay.href}` } },
    ...tiles.map((t, i) => ({ '@type': 'ListItem', position: i + 2, item: { '@type': 'Service', name: t.title, provider: { '@type': 'Organization', name: site.name }, areaServed: 'Fleurieu Peninsula, South Australia' } })),
  ],
};
---
<Base
  title="Retreats for private groups and corporate teams"
  description="La maréa retreats on the Fleurieu Peninsula, South Australia: the 8 hour immersive retreat for private groups and corporate teams, with transport from Adelaide, plus shorter retreats and weekends."
  headerTone="over-media"
  jsonLd={jsonLd}
>
  <!-- 1. What this page is, and who it is for -->
  <div class="hero-f">
    <MediaBand
      media="retreats-hero"
      height="tall"
      hero
      text="over"
      eyebrow="Retreats"
      heading="Retreat days for private groups and corporate teams"
      level={1}
      body="8 hour immersive retreats on the Fleurieu Peninsula, with transport from Adelaide and everything taken care of."
      draft={{ heading: true, body: true }}
    />
  </div>

  <!-- 2. Who it is for, the two paths -->
  <section class="paths" aria-labelledby="paths-heading">
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Retreats' }]} class="paths__crumbs" />
      <Reveal>
        <SectionHead
          id="paths-heading"
          eyebrow="Who it is for"
          heading="Choose your retreat"
          intro="There are different seasons that call us to pause. Time with friends, time with family, time to reconnect as a team."
          draft={{ heading: true }}
        />
      </Reveal>
      <ul class="paths__list" role="list">
        <li class="paths__card">
          <h3 class="paths__name"><a href="/private-groups">For private groups</a></h3>
          <p>Birthdays, milestone celebrations, sister weekends, family resets or simply time with people who matter.</p>
          <ArrowLink href="/private-groups" label="See private group retreats" />
        </li>
        <li class="paths__card">
          <h3 class="paths__name"><a href="/corporate">For corporate teams</a></h3>
          <p>A strategic reset for leadership teams and high-performing professionals.</p>
          <ArrowLink href="/corporate" label="See corporate retreats" />
        </li>
      </ul>
    </div>
  </section>

  <!-- 3. The 8 hour immersive retreat in brief -->
  <section class="flag" aria-labelledby="flag-heading">
    <div class="wrap flag__grid">
      <Reveal class="flag__media">
        <div class="flag__img"><Media media="retreats-flagship" aspect="fill" /></div>
      </Reveal>
      <Reveal class="flag__text" delay={120}>
        <Eyebrow>8 hours, 7am to 5pm</Eyebrow>
        <h2 class="flag__heading" id="flag-heading">{flagshipName}</h2>
        <p class="flag__lead">Your luxury retreat includes a curated day program designed around movement, recovery, nourishing food, nervous system support, nature immersion, education and connection.</p>
        <p>A completely curated luxury experience where everything is taken care of, venue, meals, wellness sessions, experiences, and clean-up, allowing your group to simply arrive, relax, and enjoy quality time together.</p>
        <dl class="flag__facts">
          <div><dt>At the venue</dt><dd>{day.times.retreat}</dd></div>
          <div><dt>From Adelaide</dt><dd>Pick up about {day.times.pickup}, drop off about {day.times.dropoff}</dd></div>
          <div><dt>For</dt><dd data-draft>Private groups and corporate teams</dd></div>
        </dl>
        <p class="flag__note">{day.note}</p>
        <div class="flag__actions">
          <ArrowLink href={cta.seeFullDay.href} label={cta.seeFullDay.label} size="large" />
        </div>
      </Reveal>
    </div>
  </section>

  <!-- 4. Shorter retreats and weekends. The only place the waitlists sit. -->
  <section class="menu-f" id="shorter" aria-labelledby="formats-heading">
    <div class="wrap">
      <Reveal>
        <SectionHead
          id="formats-heading"
          eyebrow="Shorter retreats and weekends"
          heading="Mornings, evenings and weekends"
          intro="La maréa has been designed to meet each of these moments with intention."
          draft={{ heading: true }}
        />
      </Reveal>
      <ExpandTile items={tiles} height="clamp(24rem, 54vh, 34rem)" class="menu-f__tiles" />
      <div class="menu-f__wait">
        <p>Join our retreat waitlist so you never miss out on retreat releases.</p>
        <ArrowLink href="/waitlist" label="Join the waitlist" />
      </div>
    </div>
  </section>

  <!-- 5. How booking works, and the one Plan your day -->
  <CtaBand
    line="Curate your 8 hour immersive retreat"
    params={{ format: 'full-day', source: 'retreats' }}
    note={cta.callNote}
    tone="warm"
    draft={{ line: true }}
  />
</Base>

<style>
  .paths { padding-block: clamp(1.5rem, 3vw, 2.5rem) var(--section-y); background: var(--salt-25); }
  .paths :global(.paths__crumbs) { margin-bottom: clamp(2rem, 4vw, 3.5rem); }
  .paths__list { display: grid; gap: var(--space-l); margin: clamp(2rem, 4vw, 3rem) 0 0; padding: 0; list-style: none; }
  .paths__card { padding-top: 1.25rem; border-top: 1px solid var(--sage-20); max-width: 34rem; }
  .paths__name { margin: 0 0 0.75rem; font-size: var(--fs-h3, 1.6rem); }
  .paths__name a { color: inherit; text-decoration: none; }
  .paths__card p { margin: 0 0 1.25rem; font-family: var(--font-serif); font-size: var(--fs-lead); line-height: 1.45; color: var(--sage-100); }
  @media (min-width: 900px) { .paths__list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(2.5rem, 6vw, 6rem); } }

  .flag { padding-block: var(--section-y); background: var(--sand-30); }
  .flag__grid { display: grid; gap: var(--space-l); align-items: center; }
  .flag__img { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: var(--sand-40); }
  .flag__heading { margin: 0 0 1.5rem; max-width: 12em; }
  .flag__lead {
    margin: 0 0 1rem;
    font-family: var(--font-serif);
    font-size: var(--fs-lead);
    line-height: 1.45;
    color: var(--sage-80);
  }
  .flag__facts { display: grid; gap: 0; margin: 1.75rem 0 0; max-width: 30rem; border-top: 1px solid var(--sage-20); }
  .flag__facts div {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--sage-20);
    font-size: var(--fs-small);
  }
  .flag__facts dt { font-family: var(--font-ui); font-size: var(--fs-label); letter-spacing: var(--track-label); color: var(--sage-80); padding-top: 0.1rem; }
  .flag__facts dd { margin: 0; color: var(--sage-100); }
  .flag__note { margin: 1.25rem 0 0; font-family: var(--font-serif); font-size: var(--fs-lead); line-height: 1.4; color: var(--sage-80); }
  .flag__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 2.25rem; margin-top: 2rem; }

  @media (min-width: 900px) {
    .flag__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(2.5rem, 5vw, 6rem); }
    .flag__img { aspect-ratio: 5 / 6; }
  }

  .menu-f { padding-block: var(--section-y); background: var(--salt-25); }
  .menu-f :global(.fmt-who) {
    margin: 0 0 0.75rem;
    font-family: var(--font-ui);
    font-size: var(--fs-label);
    letter-spacing: var(--track-label);
    color: var(--sage-80);
  }
  .menu-f__wait {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 2rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--sage-20);
  }
  .menu-f__wait p { margin: 0; font-size: var(--fs-small); }
</style>
