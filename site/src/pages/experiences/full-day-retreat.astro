---
/*
  The 8 hour immersive retreat, /experiences/full-day-retreat (URL kept). Owner: page builder B.
  UX build 27-09-2026: one name everywhere, breadcrumb Home, Retreats, The 8 hour immersive retreat.
  This is the one page that carries the full schedule; every other page links here. Cut for length:
  the guest quote, the unhurried afternoon (it lives on /experiences), the reviews band (no full day
  review exists yet) and the questions band ("What is included" now sits under the schedule).
  The flagship, and the section Belle calls the focus: "what a example sort of full day, eight hour
  immersive wellness retreat with us looks like" (BD-52), shown "through imagery, beautiful imagery,
  um, you know, animations that move" (BD-54).

  Six moments:
   1 the hero, the H1 naming the product, and who it is for
   2 forty words of Belle's guide and the facts a first-time visitor needs
   3 the pinned day in four parts (PinnedDay)
   4 the full hour by hour schedule, open, with "What is included" (the one full version on the site)
   5 the morning rotation (SteppedGallery)
   6 where it can happen (venue cards), then Plan your day (CtaBand, format=full-day)
  No question circles and no eight words on this page. TouristTrip schema (no public price, so no Product or Offer).
*/
import Base from '../../layouts/Base.astro';
import MediaBand from '../../components/base/MediaBand.astro';
import Breadcrumbs from '../../components/base/Breadcrumbs.astro';
import AnswerBlock from '../../components/base/AnswerBlock.astro';
import SectionHead from '../../components/base/SectionHead.astro';
import DataTable from '../../components/base/DataTable.astro';
import CtaBand from '../../components/base/CtaBand.astro';
import ArrowLink from '../../components/base/ArrowLink.astro';
import Reveal from '../../components/base/Reveal.astro';
import PinnedDay from '../../components/day/PinnedDay.astro';
import SteppedGallery from '../../components/venues/SteppedGallery.astro';
import VenueIndex from '../../components/venues/VenueIndex.astro';
import ReelFrame from '../../components/pages/b/ReelFrame.astro';
import AtAGlance from '../../components/pages/b/AtAGlance.astro';
import Flag from '../../components/pages/b/Flag.astro';
import { hourByHour, steps } from '../../data/day';
import { site, cta, flagshipName } from '../../data/settings';
import { getVenues } from '../../lib/content';
import { includedHtml } from '../../components/pages/b/copy';

const venues = await getVenues();
const rotation = steps.find((s) => s.order === 6)!;

/* Moment 2: Belle's framing sentence from her full day retreat guide (p.15), verbatim. */
const answer =
  'Your luxury retreat includes a curated day program designed around movement, recovery, nourishing food, nervous system support, nature immersion, education and connection. All sessions are delivered by qualified health and wellness practitioners in South Australia and can be tailored to suit your groups objectives.';

/* Moment 5: the three stations exactly as Belle's Beresford schedule lists them. */
const stations = [
  {
    name: 'Individual restorative massage therapy',
    text: 'Experience 1 of 3. Each rotation runs 40 minutes, with a 10 minute changeover before the next.',
    media: 'day-rotation-massage',
    pictured: 'Massage therapy',
  },
  {
    name: 'Contrast therapy experience',
    text: 'Experience 2 of 3, 40 minutes. Sauna, breathwork and cold plunge.',
    media: 'day-rotation-contrast',
    pictured: 'Sauna, breathwork and cold plunge',
  },
  {
    name: 'Lifestyle wellness workshop',
    text: 'Experience 3 of 3, 40 minutes. The Foundations of High Performance Wellbeing: Build Lifestyle Habits for Energy, Focus & Burnout Prevention.',
    media: 'day-rotation-workshop',
    pictured: 'The Foundations of High Performance Wellbeing',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  // TouristTrip, not Product: the day is not priced publicly, and Product needs a priced Offer (QA m11).
  '@type': 'TouristTrip',
  name: 'The 8 hour immersive retreat',
  description:
    'A full day, 8 hour immersive wellness retreat on the Fleurieu Peninsula, South Australia, for private groups and corporate teams, with private return transport from Adelaide.',
  touristType: ['Private groups', 'Corporate teams'],
  url: `${site.url}/experiences/full-day-retreat/`,
  provider: { '@type': 'Organization', name: site.name, url: `${site.url}/` },
};
---
<Base
  title="The 8 hour immersive retreat, Fleurieu Peninsula"
  description="The 8 hour immersive retreat on the Fleurieu Peninsula for private groups and corporate teams, hour by hour, with private return transport from Adelaide."
  headerTone="over-media"
  jsonLd={jsonLd}
  class="page-day"
>
  <!-- 1. One video, one line. Wrapped because a direct child of Base would read slot as a slot name. -->
  <div class="day-hero">
  <MediaBand
    media="day-hero"
    height="screen"
    hero
    parallax={false}
    text="over"
    eyebrow="Retreats"
    heading="The 8 hour immersive retreat"
    level={1}
    body="One curated day on the Fleurieu Peninsula for your private or corporate group, 7am to 5pm, door to door from Adelaide."
    draft={{ body: true }}
  />
  </div>

  <!-- 2. What a full day retreat is, and the facts a first-time visitor needs -->
  <section class="section day-intro" aria-labelledby="day-what">
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Retreats', href: '/retreats' }, { label: flagshipName }]} class="day-crumbs" />
      <Reveal>
        <AnswerBlock id="day-what" question="What is the 8 hour immersive retreat?" draft={{ question: true }}>
          <p>{answer}</p>
          <Flag>Verbatim from Belle’s full day retreat guide (p.15), including “groups objectives” without an apostrophe, left for Belle to correct. Her personalisation line sits with the example day just below, so it shows once.</Flag>
        </AnswerBlock>
      </Reveal>
      <Reveal class="day-intro__glance">
        <AtAGlance
          label="The day at a glance"
          items={[
            { value: '8am to 4pm', label: 'At the venue', draft: true },
            { value: '7am to 5pm', label: 'Door to door, private return transport from Adelaide', draft: true },
            { value: 'Private groups and corporate teams', label: 'Who it is for', draft: true },
            { value: 'On the coast or in the vineyards', label: 'Places to Pause', href: '#where', draft: true },
          ]}
        />
      </Reveal>
    </div>
  </section>

  <!-- 3. The pinned example day -->
  <PinnedDay seeFullDay={false} heading="The day in four parts" eyebrow="Arrive, move, nourish, restore" params={{ format: 'full-day', source: 'day-page' }} />

  <!-- 4. The reel beside the full schedule, one moment. The table sits in "See the full schedule" so
       the panels and the reel carry the story and the day is not told three times (CD review 02 item 10). -->
  <section class="section band-salt day-schedule" aria-labelledby="schedule-heading">
    <div class="wrap day-schedule__grid">
      <div class="day-schedule__reel">
        <ReelFrame
          media="day-reel"
          label="Belle’s reel"
          caption="An 8 hour private group day at Beresford Estate, McLaren Vale"
          captionDraft
        />
      </div>
      <div class="day-schedule__table">
        <Reveal><SectionHead heading="A day at *Beresford Estate*" id="schedule-heading" /></Reveal>
        <details class="day-schedule__more" open>
          <summary class="day-schedule__summary">
            <span>See the full schedule</span>
            <svg class="day-schedule__chev" viewBox="0 0 14 8" width="14" height="8" aria-hidden="true" focusable="false"><polyline points="1,1 7,7 13,1" /></svg>
          </summary>
          <DataTable
            caption="Example full day (8 hour) retreat schedule, bespoke luxury corporate wellness day, 12 guests"
            columns={[
              { key: 'time', label: 'Time', nowrap: true },
              { key: 'what', label: 'What happens' },
            ]}
            rows={hourByHour}
          />
        </details>
        <div class="day-included">
          <h3 class="day-included__title" id="included">What is included</h3>
          <div class="day-included__body" set:html={includedHtml()} />
          <ArrowLink href="/faqs" label="Every question and answer" />
        </div>
        <Flag>Belle’s published schedule reads “12 : 20 AM” twice where 12:20pm is meant (the rotations add up to 12:20pm). It shows here as 12:20pm. The reel is a private group day and the schedule a corporate day, both at Beresford Estate.</Flag>
      </div>
    </div>
  </section>

  <!-- 5. The morning rotation -->
  <section class="section day-rotation" aria-labelledby="rotation-heading">
    <div class="wrap">
      <Reveal><SectionHead eyebrow={rotation.range} heading="The morning rotation" id="rotation-heading" intro={rotation.display[0]} /></Reveal>
      <SteppedGallery items={stations} label="Three stations" aria="The morning rotation, three stations" id="rotation" />
    </div>
  </section>

  <!-- 6. Where it can happen -->
  <section class="section band-warm day-where" id="where" aria-labelledby="where-heading">
    <div class="wrap">
      <SectionHead
        eyebrow="Places to Pause"
        heading="On the coast or in the vineyards"
        id="where-heading"
        intro="La maréa retreats are intentionally limited and venue selection is highly considered."
      >
        <ArrowLink slot="aside" href="/places" label="See the venues" />
      </SectionHead>
      <VenueIndex venues={venues} label="Where the 8 hour immersive retreat can happen" />
    </div>
  </section>

  <!-- Plan your day -->
  <CtaBand
    line="Curate your 8 hour immersive retreat"
    params={{ format: 'full-day', source: 'day-page' }}
    note={cta.callNote}
    draft={{ line: true }}
  />
</Base>

<style>
  /* 2 */
  .day-intro { padding-top: clamp(1.5rem, 3vw, 2.5rem); }
  .day-intro :global(.day-crumbs) { margin-bottom: clamp(2.5rem, 5vw, 4.5rem); }
  .day-intro :global(.day-intro__glance) { margin-top: clamp(3rem, 6vw, 5.5rem); }

  /* 4 */
  .day-schedule__grid { display: grid; gap: var(--space-xl); }
  .day-schedule__reel { width: min(100%, 17.5rem); margin-inline: auto; }
  @media (min-width: 900px) {
    .day-schedule__grid { grid-template-columns: minmax(16rem, 22rem) minmax(0, 1fr); gap: clamp(3rem, 8vw, 8rem); align-items: start; }
    .day-schedule__reel { width: 100%; margin: 0; position: sticky; top: calc(var(--header-compact) + 2.5rem); padding-top: 0.5rem; }
  }
  /* Until Belle's reel arrives, visitors see the schedule on its own rather than an empty 9:16 frame
     (design review 27-09-2026). The notes layer keeps the frame for Jess and Belle. */
  :global(html:not([data-media-notes='on'])) .day-schedule__reel:has(.media--placeholder) { display: none; }
  :global(html:not([data-media-notes='on'])) .day-schedule__grid:has(.day-schedule__reel .media--placeholder) { grid-template-columns: minmax(0, 46rem); }

  /* 4, the schedule behind one quiet row */
  .day-schedule__more { border-top: 1px solid var(--sage-40); border-bottom: 1px solid var(--sage-20); }
  .day-schedule__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    padding-block: 0.75rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-serif);
    font-size: var(--fs-card);
    color: var(--heading);
  }
  .day-schedule__summary::-webkit-details-marker { display: none; }
  .day-schedule__chev { flex: none; overflow: visible; }
  .day-schedule__chev polyline { fill: none; stroke: currentColor; stroke-width: 1; vector-effect: non-scaling-stroke; stroke-linecap: round; stroke-linejoin: round; }
  .day-schedule__more[open] .day-schedule__chev { transform: rotate(180deg); }
  .day-schedule__more :global(.dtable) { padding: 0.5rem 0 1.5rem; }
  @media (prefers-reduced-motion: no-preference) {
    .day-schedule__chev { transition: transform var(--dur) var(--ease-soft); }
  }

  /* 5 */
  .day-rotation :global(.section-head) { margin-bottom: clamp(2.5rem, 4vw, 4rem); }

  /* 4, what is included */
  .day-included { margin-top: clamp(2rem, 4vw, 3rem); }
  .day-included__title { margin: 0 0 0.75rem; font-family: var(--font-serif); font-size: var(--fs-card); }
  .day-included :global(.b-groups) { display: grid; gap: 1.5rem 2.5rem; margin: 1.25rem 0 1.5rem; }
  @media (min-width: 700px) { .day-included :global(.b-groups) { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .day-included :global(.b-group__title) { margin: 0 0 0.5rem; font-family: var(--font-ui); font-size: var(--fs-label); letter-spacing: var(--track-label); color: var(--muted); }
  .day-included :global(.b-list) { margin: 0; padding: 0; list-style: none; }
  .day-included :global(.b-list li) { padding: 0.35rem 0; border-top: 1px solid var(--sage-20); font-size: var(--fs-small); line-height: 1.5; }
</style>
