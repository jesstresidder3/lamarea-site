---
/*
  Experiences, /experiences. Owner: page builder B.
  The section Belle calls missing: "one of the key sections at the moment that’s missing on the site
  is the sections that really highlight our experiences" (BD-15), as sliders "that have imagery as
  well as sliders that have videos" (BD-97).

  1 hero (MediaBand, one video)
  2 the ten guided experiences (PaneSlider, video plays on the tile in view)
  3 the six self-led activities (a full-width Slider, a different mechanic on purpose)
  4 the food, one block linking to /food (UX build 27-09-2026: Experiences means what you do on
    the day, so the day summary and the team row came off; the team lives under About)
  5 Plan your day
*/
import Base from '../../layouts/Base.astro';
import MediaBand from '../../components/base/MediaBand.astro';
import Breadcrumbs from '../../components/base/Breadcrumbs.astro';
import SectionHead from '../../components/base/SectionHead.astro';
import TextPair from '../../components/base/TextPair.astro';
import CtaBand from '../../components/base/CtaBand.astro';
import PaneSlider from '../../components/experiences/PaneSlider.astro';
import Media from '../../components/media/Media.astro';
import AfternoonTiles from '../../components/pages/b/AfternoonTiles.astro';
import { getExperiences } from '../../lib/content';
import { day } from '../../data/day';
import { site, cta } from '../../data/settings';

const guided = await getExperiences('guided');
const selfLed = await getExperiences('self_led');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Wellness experiences on the Fleurieu Peninsula',
  itemListElement: [...guided, ...selfLed].map((e, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: e.data.name,
    url: `${site.url}/experiences/${e.id}`,
  })),
};
---
<Base
  title="Wellness experiences and food on the day"
  description="What you do on a La maréa retreat on the Fleurieu Peninsula: sauna, massage, contrast therapy, yoga, pilates, meditation, self-led afternoons and chef curated Mediterranean dining."
  headerTone="over-media"
  jsonLd={jsonLd}
>
  <div class="ex-hero">
    <MediaBand
      media="experiences-hero"
      height="tall"
      hero
      parallax={false}
      text="over"
      eyebrow="Experiences"
      heading="The experiences"
      level={1}
      body="What you do on the day: ten guided experiences, six to enjoy at your own pace, and the food."
      draft={{ body: true }}
    />
  </div>

  <div class="wrap ex-crumbs">
    <Breadcrumbs items={[{ label: 'Experiences' }]} />
  </div>

  <PaneSlider
    id="experiences"
    items={guided}
    eyebrow="Ten guided experiences"
    heading="Your retreat, your rhythm, your routine"
    intro="Luxury South Australian wellness experiences, curated to form La maréa."
    note={day.note}
    linkBase="/experiences/"
    class="ex-guided"
  />

  <section class="section band-warm ex-self" aria-labelledby="self-heading">
    <div class="wrap">
      <SectionHead
        eyebrow="Self-led, in the afternoon"
        heading="The unhurried afternoon"
        id="self-heading"
        intro="There is space to rest, journal, explore the coastline, or simply unwind."
      />
    </div>
    <AfternoonTiles items={selfLed} id="self-led" />
  </section>

  <section class="section ex-food" aria-labelledby="food-heading">
    <div class="wrap">
      <TextPair eyebrow="Food and sample menus" heading="Signature culinary experiences" headingId="food-heading" mediaSide="left" split="wide" link={{ label: 'See the food and sample menus', href: '/food' }}>
        <div slot="media" class="ex-food__media"><Media media="food-fine-dining" aspect="3 / 2" /></div>
        <p>Inspired by the elements of a Mediterranean lifestyle; plant based nourishment, connection, community & longevity.</p>
        <p class="ex-food__small">A three course Mediterranean chef curated dining experience and a pasta making masterclass.</p>
      </TextPair>
    </div>
  </section>

  <CtaBand
    line="Curate your 8 hour immersive retreat"
    params={{ source: 'experiences' }}
    note={cta.callNote}
    draft={{ line: true }}
  />
</Base>

<style>
  .ex-crumbs { padding-top: clamp(1rem, 2vw, 1.5rem); }
  :global(.pane-slider.ex-guided) { padding-top: clamp(2rem, 4vw, 3.5rem); }
  .ex-self :global(.section-head) { margin-bottom: clamp(2.5rem, 4vw, 3.5rem); }
  .ex-food__media { width: 100%; }
  .ex-food__small { margin-top: 1.25rem; font-size: var(--fs-small); color: var(--sage-80); }
</style>
