---
/*
  The two audience pages, /private-groups and /corporate (lane L2 rebuild, 28-09-2026).
  Each carries on from its world in the home opening: private groups open inside the arch on the left
  and widen to full bleed, corporate teams inside the frame on the right. After that each page tells
  its own story for its buyer, in the order a buyer needs it:

  1 PageOpener: the photograph, the title, Belle's audience line, and the plain facts on the lower edge
    (hours, door to door, group size, setting, who it is for). Group size links to the example day
    until Belle answers Q12, Q40 and Q41.
  2 Who it is for: two photographs offset (OffsetPair) beside Belle's statement and what the day includes.
  3 Guests' words beside one retreat photograph (GuestQuotes). Corporate quotes on the corporate page.
  4 Places to Pause as a row of tall panels that comes in from the right (PanelTrack). Venues without
    a photograph yet show their name on sand instead of an empty frame.
  5 Questions this group asks, with the guide as one line.
  6 ClosingTide: the page ends on the coast with "Plan your day".

  The underscore keeps this file out of routing. The page passes every word. Belle's verbatim lines
  carry no marker; drafted lines set draft flags.
*/
import PageOpener from '../../components/pages/a/PageOpener.astro';
import OffsetPair from '../../components/pages/a/OffsetPair.astro';
import GuestQuotes from '../../components/pages/a/GuestQuotes.astro';
import PanelTrack from '../../components/pages/a/PanelTrack.astro';
import ClosingTide from '../../components/base/ClosingTide.astro';
import Eyebrow from '../../components/base/Eyebrow.astro';
import ArrowLink from '../../components/base/ArrowLink.astro';
import SectionHead from '../../components/base/SectionHead.astro';
import Reveal from '../../components/base/Reveal.astro';
import Accordion from '../../components/base/Accordion.astro';
import Breadcrumbs from '../../components/base/Breadcrumbs.astro';
import { day } from '../../data/day';
import { cta, flagshipName } from '../../data/settings';
import type { Venue, Faq, Testimonial } from '../../lib/content';

interface Props {
  audience: 'private' | 'corporate';
  crumb: string;
  opener: {
    media: string;
    mobileMedia?: string;
    eyebrow: string;
    lines: string[];
    indents: number[];
    line: string;
    place: 'top-left' | 'top-right' | 'bottom-left';
    phonePlace?: 'top' | 'bottom';
    shade?: 'soft' | 'strong';
    zoom?: number;
    who: string;
    whoDraft?: boolean;
    caption?: string;
  };
  who: { statement: string; paragraphs: string[]; large: string; detail: string; shape: 'arch' | 'frame'; aside?: { text: string; label: string; href: string } };
  includes: string[];
  venues: { heading: string; intro: string; items: Venue[] };
  proof: { heading: string; items: Testimonial[]; media: string; caption?: string };
  questions: { heading: string; faqs: Faq[]; after?: { label: string; href: string } };
  guide: { title: string; slug: string };
  close: { media: string; caption?: string };
}
const { audience, crumb, opener, who, includes, venues, proof, questions, guide, close } = Astro.props;
const source = audience === 'private' ? 'private-groups' : 'corporate';

const venuePanels = venues.items.map((v) => ({
  media: v.data.card_media ?? `venue-${v.id}-card`,
  name: v.data.name,
  eyebrow: v.data.location_label ?? v.data.locality,
  html: v.data.intro?.text ? `<p>${v.data.intro.text.replace(/&/g, '&amp;').replace(/</g, '&lt;')}</p>` : undefined,
  link: { label: `About ${v.data.name}`, href: `/places/${v.id}` },
}));
---
<PageOpener
  id={`${source}-opener`}
  media={opener.media}
  mobileMedia={opener.mobileMedia}
  eyebrow={opener.eyebrow}
  lines={opener.lines}
  indents={opener.indents}
  line={opener.line}
  titleDraft
  place={opener.place}
  phonePlace={opener.phonePlace}
  shade={opener.shade}
  shape={audience === 'private' ? 'arch' : 'frame'}
  zoom={opener.zoom}
  caption={opener.caption}
  facts={[
    { label: 'At the venue', value: day.times.retreat },
    { label: 'Door to door', value: `${day.times.pickup} to ${day.times.dropoff}, from ${audience === 'corporate' ? 'your office' : 'Adelaide'}`, draft: true },
    { label: 'Group size', value: '12 guests in our example day', href: `${cta.seeFullDay.href}#schedule`, draft: true },
    { label: 'Setting', value: 'The coast or the vineyards', draft: true },
    { label: 'For', value: opener.who, draft: opener.whoDraft },
  ]}
/>

<section class="who" aria-labelledby="who-heading">
  <div class="wrap">
    <Breadcrumbs items={[{ label: 'Retreats', href: '/retreats' }, { label: crumb }]} class="who__crumbs" />
    <OffsetPair large={who.large} detail={who.detail} shape={who.shape} side={audience === 'private' ? 'left' : 'right'}>
      <Eyebrow>Who it is for</Eyebrow>
      <h2 class="who__statement" id="who-heading" data-no-split>{who.statement}</h2>
      <div class="who__body">
        {who.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <h3 class="who__inc-title">{flagshipName}, what the day includes</h3>
      <ul class="who__facts" role="list">
        {includes.map((line) => <li>{line}</li>)}
      </ul>
      <ArrowLink href={cta.seeFullDay.href} label={cta.seeFullDay.label} class="who__day" />
      {who.aside && (
        <p class="who__aside" data-draft>{who.aside.text} <a class="text-link" href={who.aside.href}>{who.aside.label}</a></p>
      )}
    </OffsetPair>
  </div>
</section>

<GuestQuotes
  id={`${source}-reviews`}
  heading={proof.heading}
  items={proof.items}
  media={proof.media}
  caption={proof.caption}
  side={audience === 'private' ? 'right' : 'left'}
/>

<section class="venues-p" aria-labelledby="venues-heading">
  <div class="wrap">
    <Reveal>
      <SectionHead id="venues-heading" eyebrow="Places to Pause" heading={venues.heading} intro={venues.intro} draft={{ heading: true }}>
        <ArrowLink slot="aside" href="/places" label="See the venues" />
      </SectionHead>
    </Reveal>
  </div>
  <PanelTrack items={venuePanels} size="card" label={venues.heading} id={`${source}-venues`} />
</section>

<section class="qs" aria-labelledby="questions-heading">
  <div class="wrap qs__grid">
    <div class="qs__side">
      <SectionHead id="questions-heading" eyebrow="Questions" heading={questions.heading} size="small" draft={{ heading: true }} />
      <p class="qs__guide" data-draft>{guide.title} is being finished. <a class="text-link" href={`/guides/${guide.slug}`}>Ask for a copy</a></p>
    </div>
    <div class="qs__list">
      <Accordion items={questions.faqs.map((f) => ({ title: f.data.question, paragraphs: f.data.answer }))} titleTag="h3" />
      <div class="qs__links">
        <ArrowLink href="/faqs" label="All questions" />
        {questions.after && <ArrowLink href={questions.after.href} label={questions.after.label} />}
      </div>
    </div>
  </div>
</section>

<ClosingTide
  media={close.media}
  line="Curate your 8 hour immersive retreat"
  lineDraft
  params={{ audience, source }}
/>

<style>
  .who { padding-block: clamp(1.5rem, 3vw, 2.5rem) var(--section-y); background: var(--sand-30); overflow-x: clip; }
  .who :global(.who__crumbs) { margin-bottom: clamp(2.5rem, 6vw, 5rem); }
  .who__statement {
    margin: 1rem 0 0;
    max-width: 20em;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.5rem);
    line-height: 1.18;
    color: var(--sage-80);
    text-wrap: balance;
  }
  .who__body { margin-top: clamp(1.25rem, 2.5vw, 1.75rem); max-width: 34rem; }
  .who__body p { margin: 0 0 1em; }
  .who__inc-title {
    margin: clamp(1.75rem, 3.5vw, 2.5rem) 0 0.6rem;
    font-family: var(--font-ui);
    font-size: var(--fs-label);
    letter-spacing: var(--track-label);
    font-weight: 400;
    color: var(--sage-80);
  }
  .who__facts { margin: 0; padding: 0; list-style: none; max-width: 34rem; border-top: 1px solid var(--sage-20); font-size: var(--fs-small); color: var(--sage-100); }
  .who__facts li { display: flex; align-items: center; min-height: 2.9rem; padding-block: 0.35rem; border-bottom: 1px solid var(--sage-20); }
  .who :global(.who__day) { margin-top: 1.5rem; }
  .who__aside { margin: 1.5rem 0 0; font-size: var(--fs-small); color: var(--sage-80); max-width: 30rem; }

  .venues-p { padding-block: var(--section-y); background: var(--sand-30); overflow-x: clip; }
  .venues-p :global(.section-head) { margin-bottom: clamp(2rem, 4vw, 3rem); }

  .qs { padding-block: var(--section-y); background: var(--sand-40); }
  .qs__grid { display: grid; gap: var(--space-l); align-items: start; }
  .qs__guide { margin: 1.25rem 0 0; font-size: var(--fs-small); color: var(--sage-80); max-width: 22rem; }
  .qs__links { display: flex; flex-wrap: wrap; gap: 0.5rem 2.5rem; margin-top: 1.75rem; }
  @media (min-width: 900px) {
    .qs__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr); gap: var(--space-xl) var(--space-l); }
  }
</style>
