---
/*
  The two audience pages, /private-groups and /corporate, in the order the UX build set on 27-09-2026
  (build/design/ux-information-architecture-27-09-2026.md section 5, "Key pages, five sections at most").
  The underscore keeps this file out of routing. It replaces components/pages/a/PathPage.astro for these
  two pages only, so each page carries what is specific to its buyer and nothing from the other one.

  1 Hero: who the page is for, in Belle's line
  2 Who it is for and what the day includes: Belle's statement, five lines from her "What is included"
    (guide p.23), the retreat times, one link to the full day. No timeline here: the full schedule
    lives on /experiences/full-day-retreat only.
  3 Venues that suit your group (VenueIndex)
  4 Reviews from this kind of group
  5 Questions this group asks, with the group guide capture, then the one "Plan your day" (CtaBand)

  The page passes every word. Belle's verbatim lines carry no marker; drafted lines set draft flags.
*/
import MediaBand from '../../components/base/MediaBand.astro';
import Eyebrow from '../../components/base/Eyebrow.astro';
import ArrowLink from '../../components/base/ArrowLink.astro';
import SectionHead from '../../components/base/SectionHead.astro';
import Reveal from '../../components/base/Reveal.astro';
import Accordion from '../../components/base/Accordion.astro';
import LeadCapture from '../../components/base/LeadCapture.astro';
import CtaBand from '../../components/base/CtaBand.astro';
import Breadcrumbs from '../../components/base/Breadcrumbs.astro';
import VenueIndex from '../../components/venues/VenueIndex.astro';
import Testimonials from '../../components/testimonials/Testimonials.astro';
import { day } from '../../data/day';
import { cta, flagshipName } from '../../data/settings';
import type { Venue, Faq, Testimonial } from '../../lib/content';

interface Props {
  audience: 'private' | 'corporate';
  crumb: string;
  hero: { slot: string; eyebrow: string; heading: string; body: string };
  who: { statement: string; paragraphs: string[] };
  includes: string[];
  venues: { heading: string; intro: string; items: Venue[]; filters: boolean };
  proof: { heading: string; items: Testimonial[]; placeholder?: string };
  questions: { heading: string; faqs: Faq[] };
  guide: { title: string; list: string };
}
const { audience, crumb, hero, who, includes, venues, proof, questions, guide } = Astro.props;
const source = audience === 'private' ? 'private-groups' : 'corporate';
---
<MediaBand
  media={hero.slot}
  height="tall"
  hero
  text="over"
  eyebrow={hero.eyebrow}
  heading={hero.heading}
  level={1}
  body={hero.body}
  draft={{ heading: true }}
/>

<section class="who" aria-labelledby="who-heading">
  <div class="wrap">
    <Breadcrumbs items={[{ label: 'Retreats', href: '/retreats' }, { label: crumb }]} class="who__crumbs" />
  </div>
  <div class="wrap who__grid">
    <Reveal class="who__label">
      <Eyebrow>Who it is for</Eyebrow>
    </Reveal>
    <Reveal class="who__main" delay={100}>
      <h2 class="who__statement" id="who-heading">{who.statement}</h2>
      <div class="who__body">
        {who.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <h3 class="who__inc-title">{flagshipName}, what the day includes</h3>
      <ul class="who__facts" role="list">
        {includes.map((line) => <li>{line}</li>)}
        <li>At the venue {day.times.retreat}, pick up about {day.times.pickup}, drop off about {day.times.dropoff}</li>
        <li><span data-draft>Group sizes vary by venue.</span></li>
      </ul>
      <ArrowLink href={cta.seeFullDay.href} label={cta.seeFullDay.label} class="who__day" />
    </Reveal>
  </div>
</section>

<section class="venues-p" aria-labelledby="venues-heading">
  <div class="wrap">
    <Reveal>
      <SectionHead id="venues-heading" eyebrow="Places to Pause" heading={venues.heading} intro={venues.intro} draft={{ heading: true }}>
        <ArrowLink slot="aside" href="/places" label="See the venues" />
      </SectionHead>
    </Reveal>
    <VenueIndex venues={venues.items} filters={venues.filters} label={venues.heading} />
  </div>
</section>

<section class="proof-p" aria-labelledby="proof-p-heading">
  <div class="wrap">
    <Reveal>
      <SectionHead id="proof-p-heading" heading={proof.heading} draft={{ heading: true }} />
    </Reveal>
  </div>
  <Testimonials items={proof.items} filters={false} label={proof.heading} id={`${source}-reviews`} />
  {proof.placeholder && (
    <div class="wrap" data-notes-only><p class="placeholder-line proof-p__gap">{proof.placeholder}</p></div>
  )}
</section>

<section class="qs" aria-labelledby="questions-heading">
  <div class="wrap qs__grid">
    <div class="qs__side">
      <SectionHead id="questions-heading" eyebrow="Questions" heading={questions.heading} size="small" draft={{ heading: true }} />
      <div class="qs__guide">
        <p class="qs__chip">Guide coming</p>
        <LeadCapture
          list={guide.list as 'newsletter'}
          heading={guide.title}
          intro="The guide is being finished now. Leave your email and we will send it the day it is ready."
          introDraft
          submitLabel="Send me the guide"
          successMessage="Thank you. We will send the guide as soon as it is ready."
          layout="stacked"
        />
        <p class="qs__notice" data-draft>We use your email to send you this guide, and send La maréa news only if you tick the box. <a class="text-link" href="/privacy-policy">Privacy policy</a></p>
      </div>
    </div>
    <div class="qs__list">
      <Accordion items={questions.faqs.map((f) => ({ title: f.data.question, paragraphs: f.data.answer }))} titleTag="h3" />
      <ArrowLink href="/faqs" label="All questions" class="qs__all" />
    </div>
  </div>
</section>

<CtaBand
  line="Curate your 8 hour immersive retreat"
  params={{ audience, source }}
  note={cta.callNote}
  tone="warm"
  draft={{ line: true }}
/>

<style>
  .who { padding-block: clamp(1.5rem, 3vw, 2.5rem) var(--section-y); background: var(--sand-30); }
  .who :global(.who__crumbs) { margin-bottom: clamp(2rem, 4vw, 3.5rem); }
  .who__grid { display: grid; gap: 1rem var(--space-l); }
  .who__statement {
    margin: 0;
    max-width: 22em;
    font-family: var(--font-serif);
    font-size: clamp(1.55rem, 1.25rem + 1.2vw, 2.3rem);
    line-height: 1.28;
    letter-spacing: 0.003em;
    color: var(--sage-80);
    text-wrap: balance;
  }
  .who__body { margin-top: clamp(1.5rem, 3vw, 2.25rem); max-width: 34rem; }
  .who__body p { margin: 0 0 1em; }
  .who__inc-title {
    margin: clamp(2rem, 4vw, 3rem) 0 0.75rem;
    font-family: var(--font-ui);
    font-size: var(--fs-label);
    letter-spacing: var(--track-label);
    font-weight: 400;
    color: var(--sage-80);
  }
  .who__facts {
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 34rem;
    border-top: 1px solid var(--sage-20);
    font-size: var(--fs-small);
    color: var(--sage-100);
  }
  .who__facts li {
    display: flex;
    align-items: center;
    min-height: 3rem;
    padding-block: 0.35rem;
    border-bottom: 1px solid var(--sage-20);
  }
  .who :global(.who__day) { margin-top: 1.5rem; }
  @media (min-width: 900px) {
    .who__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); }
    .who :global(.who__label) { padding-top: 0.6rem; }
  }

  .venues-p { padding-block: var(--section-y); background: var(--sand-30); }

  .proof-p { padding-block: var(--section-y); background: var(--salt-25); }
  .proof-p__gap { margin-top: 1.75rem; }

  .qs { padding-block: var(--section-y); background: var(--sand-40); }
  .qs__grid { display: grid; gap: var(--space-xl) var(--space-l); align-items: start; }
  .qs__guide {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    background: var(--salt-25);
    outline: 1px solid var(--sage-20);
    outline-offset: -1px;
    max-width: 26rem;
  }
  .qs__chip {
    display: inline-block;
    margin: 0 0 0.9rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--sage-40);
    font-family: var(--font-ui);
    font-size: var(--fs-label);
    letter-spacing: var(--track-label);
    color: var(--sage-80);
  }
  .qs__guide :global(.capture__heading) { font-size: var(--fs-card); }
  .qs__notice { margin: 0.5rem 0 0; font-size: var(--fs-label); line-height: 1.55; letter-spacing: 0.02em; color: var(--sage-80); }
  .qs :global(.qs__all) { margin-top: 1.75rem; }
  @media (min-width: 900px) {
    .qs__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr); }
  }
</style>
