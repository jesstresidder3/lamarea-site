---
/*
  /gift-cards (page builder D). A holding page until Belle decides how gift cards sold on Wix are
  honoured and whether new ones sell (decision 16, plan/11 4.25). It carries the gift card terms
  exactly as published (lamarea.com.au/gift-cards, "Read more" opened, captured 24-09-2026) and her
  own contact line for existing card holders. No buy button, no price. noindex until Belle decides.
  Dash note: the live note reads "* Please note - Gift cards are..."; the spaced hyphen is set as a
  comma ("Please note, gift cards are...") and the leading asterisk dropped. Nothing else changed.
  Conflict for Belle: cards are valid for 2 years; terms clause 3.2 says credits last 12 months.
*/
import Base from '../layouts/Base.astro';
import PageIntro from '../components/pages/d/PageIntro.astro';
import ReviewNote from '../components/pages/d/ReviewNote.astro';
import CtaBand from '../components/base/CtaBand.astro';

const terms = [
  'These versatile gift cards have no restrictions and can be used for our retreats, experiences or wellness days. Redeemable for up to 2 years.',
  'Gift card expires 24 months after purchase.',
  'Please note, gift cards are non-refundable, non-transferrable and only valid for 2 years from the purchase date. If our retreats or experiences are fully booked the recipient will need to wait until our next available retreat date.',
];
---
<Base
  title="Gift cards for Fleurieu wellness retreats"
  description="Information for holders of La maréa gift cards: the gift card terms as published, and how to ask about retreat availability on the Fleurieu Peninsula."
  noindex
>
  <PageIntro
    size="compact"
    eyebrow="Gift cards"
    heading="La maréa gift cards"
    lead="If you hold a La maréa gift card, the terms it was sold under are below, with how to arrange your retreat."
    leadDraft
    media="giftcards-intro"
  />

  <section class="section section--flush-top wrap">
    <div class="gc">
      <div class="gc__head">
        <h2 class="gc__title">Gift card terms</h2>
        <p class="gc__source">As published for the La maréa eGift Card</p>
      </div>
      <div class="gc__body">
        <ol class="gc__terms" role="list">
          {terms.map((t, i) => (
            <li><span class="gc__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><p>{t}</p></li>
          ))}
        </ol>
        <div class="gc__contact">
          <h2 class="gc__contact-title">Using your card</h2>
          <p>Please contact us to inquire about retreat availability if needed <a class="text-link" href="mailto:info@lamarea.com.au">info@lamarea.com.au</a></p>
        </div>
        <ReviewNote>Holding page until decision 16: how gift cards sold on Wix are honoured, and whether new cards sell on this site. Cards say 2 years; terms clause 3.2 says credits last 12 months.</ReviewNote>
      </div>
    </div>
  </section>

  <CtaBand line="Put your card toward a day on the *Fleurieu*" params={{ source: 'gift-card' }} tone="salt" draft={{ line: true }} />
</Base>

<style>
  .gc { display: grid; gap: var(--space-l); padding-top: clamp(1.5rem, 3vw, 3rem); border-top: 1px solid var(--sage-20); }
  .gc__title { margin: 0; font-size: var(--fs-h2); }
  .gc__source { margin: 0.75rem 0 0; font-family: var(--font-ui); font-size: var(--fs-label); letter-spacing: var(--track-label); color: var(--sage-80); }
  .gc__body { max-width: 38rem; }
  .gc__terms { margin: 0; padding: 0; list-style: none; }
  .gc__terms li {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    align-items: baseline;
    padding-block: 1.25rem;
    border-top: 1px solid var(--sage-20);
  }
  .gc__terms li:last-child { border-bottom: 1px solid var(--sage-20); }
  .gc__terms p { margin: 0; line-height: 1.7; }
  .gc__num { font-family: var(--font-ui); font-size: var(--fs-label); letter-spacing: 0.08em; color: var(--sage-80); }
  .gc__contact { margin-top: clamp(2rem, 1.5rem + 2vw, 3rem); }
  .gc__contact-title { margin: 0 0 0.75rem; font-family: var(--font-serif); font-size: var(--fs-h4); line-height: 1.25; }
  .gc__contact p { margin: 0 0 0.5rem; }
  @media (min-width: 900px) {
    .gc { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2.5rem, 5vw, 6.5rem); }
  }
</style>
