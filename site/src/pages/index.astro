---
/*
  Home, rebuilt round 1 (28-09-2026): one story that unfolds, each section handing over to the next
  rather than stacking as rectangles. The ground drifts from morning salt at the top to dusk sand at
  the bottom (Base dayTone).

  1 Opening: one full-bleed scene with Belle's line that parts into the two worlds (kept as built)
  2 The story begins: Belle's "La maréa was created as an invitation to pause." over her drone footage
    of the Fleurieu coast, opening to full bleed and settling as it passes (StoryBegins)
  3 The 8 hour day: its heading rises over the coast footage (P4 handover), then the sticky split with
    a full-height photograph that slides in from the right for each part (PinnedDay overlap)
  4 The experiences: the pinned strip in the five-beat rhythm, the heading holding still at the left
  5 The food: plates that slide in from the right (P6 SlideStrip), to /food
  6 Places to Pause: the arch, the venue list and the map behind them
  7 Our difference: Belle's five on a panel overlapping the hidden cove (P2), then the pillar drift
  8 In our guests' words: one review at a time, each with a photograph of that kind of day
  9 The invitation: Restore. Reconnect. Realign. over the coastline pulling away (P5 ClosingTide),
    and the footer follows on sand

  Every word is Belle's or already on the site; drafted lines keep their data-draft marker.
*/
import Base from '../layouts/Base.astro';
import Opening from '../components/hero/Opening.astro';
import StoryBegins from '../components/home/StoryBegins.astro';
import PinnedDay from '../components/day/PinnedDay.astro';
import ExperienceGallery from '../components/experiences/ExperienceGallery.astro';
import FoodStrip from '../components/home/FoodStrip.astro';
import PlacesArches from '../components/venues/PlacesArches.astro';
import Difference from '../components/home/Difference.astro';
import PillarDrift from '../components/home/PillarDrift.astro';
import GuestWords from '../components/home/GuestWords.astro';
import ClosingTide from '../components/base/ClosingTide.astro';
import { getExperiences, getVenues, getTestimonials } from '../lib/content';
import { differences, site } from '../data/settings';

const guided = await getExperiences('guided');
const selfLed = await getExperiences('self_led');
const venues = await getVenues();
// Reviews alternate between corporate teams and private groups, so neither reads as the whole story.
const allReviews = await getTestimonials();
const corp = allReviews.filter((t) => t.data.group_type === 'corporate');
const rest = allReviews.filter((t) => t.data.group_type !== 'corporate');
const reviews = Array.from({ length: Math.max(corp.length, rest.length) }, (_, i) => [rest[i], corp[i]]).flat().filter((t): t is (typeof allReviews)[number] => Boolean(t));

// Each difference links to its proof (as before). Difference 4 goes to the team, where the local
// businesses behind the day are named.
const proof: Record<string, { href: string; label: string }> = {
  'difference-01': { href: '/fleurieu-peninsula-retreats', label: 'The Fleurieu Peninsula' },
  'difference-02': { href: '/philosophy', label: 'Our philosophy' },
  'difference-03': { href: '/team', label: 'Meet the team' },
  'difference-04': { href: '/team', label: 'The local businesses behind the day' },
  'difference-05': { href: '/our-story', label: 'Our story' },
};
const rows = differences.map((d, i) => ({
  text: d.display,
  href: proof[d.id]?.href ?? d.href,
  linkLabel: proof[d.id]?.label,
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  alternateName: ['La Marea', 'Lamarea'],
  url: `${site.url}/`,
  description: site.defaultDescription,
  inLanguage: 'en-AU',
  publisher: { '@type': 'Organization', name: site.name, url: `${site.url}/` },
};
---
<Base
  title="Luxury wellness retreats, Fleurieu Peninsula"
  description="8 hour luxury wellness retreats for private groups and corporate teams on the Fleurieu Peninsula, south of Adelaide, South Australia."
  headerTone="immersive"
  dayTone
  jsonLd={jsonLd}
>
  <Opening />

  <StoryBegins />

  <PinnedDay params={{ format: 'full-day', source: 'home' }} plan={false} overlap />

  <ExperienceGallery
    items={[...guided, ...selfLed]}
    eyebrow="The experiences"
    heading="Your retreat, your rhythm, your routine"
    intro="Luxury South Australian wellness experiences, curated to form La maréa."
    link={{ href: '/experiences', label: 'See every experience' }}
    lead="home-experiences-lead"
  />

  <FoodStrip />

  <PlacesArches
    venues={venues}
    intro="La maréa retreats are intentionally limited and venue selection is highly considered."
  />

  <Difference items={rows} />
  <PillarDrift />

  <GuestWords items={reviews} max={6} />

  <ClosingTide
    line="Restore. Reconnect. Realign."
    params={{ source: 'home' }}
    id="home-close"
  />
</Base>
