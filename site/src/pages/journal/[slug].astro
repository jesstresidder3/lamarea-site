---
/*
  /journal/<slug>, one page per post (plan/11 4.19, page builder C).
  Hero with the title over the photograph (J3, O14), then the category, date, read time and author
  linked to their team page, then the body: a research post as an article with its references in
  small type beneath, a recipe set as a recipe (serves and times, ingredients, method) with Recipe
  schema. Related stories with arrows, then Plan your day. Words are Belle's posts as migrated in
  src/content/journal, unchanged; only heading levels step down under the page's H1.
*/
import Base from '../../layouts/Base.astro';
import PageOpener from '../../components/base/PageOpener.astro';
import ClosingTide from '../../components/base/ClosingTide.astro';
import Breadcrumbs from '../../components/base/Breadcrumbs.astro';
import SectionHead from '../../components/base/SectionHead.astro';
import Media from '../../components/media/Media.astro';
import JournalCards from '../../components/journal/JournalCards.astro';
import RecipeBlock from '../../components/pages/c/RecipeBlock.astro';
import References from '../../components/pages/c/References.astro';
import { renderMarkdown, headingsOf } from '../../components/pages/c/lib/markdown';
import { parseRecipe, recipeJsonLd } from '../../components/pages/c/lib/recipe';
import { authorOf, minutesOf } from '../../components/pages/c/lib/journal';
import { getJournal, peopleById, type Post } from '../../lib/content';
import { formatDate, plain } from '../../lib/text';
import { site } from '../../data/settings';

export async function getStaticPaths() {
  const posts = await getJournal();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props { post: Post }
const { post } = Astro.props;
const d = post.data;
const people = await peopleById();
const author = authorOf(post, people);
const authorPerson = d.author ? people.get(d.author) : undefined;
const minutes = minutesOf(post);
const rawBody = post.body ?? '';
// J2: a research post carries its reference list in the body as well as in d.references, so the list
// printed twice. The body stops at its "## References" heading and <References> sets the list once.
// Belle's closing "About the Author" paragraph (after the list in her post) moves beneath it, verbatim.
let body = rawBody;
let aboutAuthor = '';
if (d.references.length) {
  const ri = rawBody.search(/^##\s+References\s*$/m);
  if (ri >= 0) {
    const tail = rawBody.slice(ri);
    const ai = tail.search(/^\*\*About the Author\*\*\s*$/m);
    if (ai >= 0) aboutAuthor = tail.slice(ai).replace(/^\*\*About the Author\*\*\s*/, '').trim();
    body = rawBody.slice(0, ri).trimEnd();
  }
}
const url = new URL(`/journal/${post.id}`, site.url).href;

// A recipe post renders as a recipe when it reads as one; anything else is an article.
const recipe = d.category === 'Recipes' ? parseRecipe(body) : null;

// The sleep post credits a photograph mid-article ("Image Credit: Naiko Retreat, Deep Creek").
// The photograph goes back in at that point as a figure with its credit.
const INLINE: Record<string, string> = { 'the-importance-of-sleep': 'journal-sleep-bath' };
const creditMatch = body.match(/^\*Image Credit:\s*(.+?)\*\s*$/m);
let parts: string[] = [body];
let credit: string | null = null;
if (!recipe && creditMatch) {
  credit = creditMatch[1].trim();
  parts = [body.slice(0, creditMatch.index), body.slice((creditMatch.index ?? 0) + creditMatch[0].length)];
}
const ids = new Set<string>();
const html = parts.map((p) => renderMarkdown(p, { demote: 1, ids }));
// A long article gets its contents in the side column; a short one does not need them
const contents = recipe ? [] : html.flatMap(headingsOf).filter((h) => h.level === 3 || h.level === 2);
const showContents = contents.length >= 4;
const introHtml = recipe ? renderMarkdown(recipe.intro.join('\n\n'), { demote: 1 }) : '';

// Related: the same category first, then the newest of the rest
const others = (await getJournal()).filter((p) => p.id !== post.id);
const related = [...others.filter((p) => p.data.category === d.category), ...others.filter((p) => p.data.category !== d.category)].slice(0, 6);

const CTA: Record<string, string> = {
  Recipes: 'Share a Mediterranean table on the *Fleurieu*',
  'Sleep and recovery': 'Rest and recovery, built into a day on the *Fleurieu*',
};
const shortTitle = plain(d.title).split(':')[0];
// Title tags stay under 60 characters with the site name: a long title keeps its first clause
const title = shortTitle.length <= 48 ? shortTitle : shortTitle.slice(0, shortTitle.lastIndexOf(',', 48) > 20 ? shortTitle.lastIndexOf(',', 48) : shortTitle.lastIndexOf(' ', 48));

// The opener sets the title in two lines: before and after its colon, or split near the middle.
const full = plain(d.title);
const openerLines = (() => {
  const c = full.indexOf(':');
  if (c > 0) return [full.slice(0, c).trim(), full.slice(c + 1).trim()];
  // A short title (the recipes) stays on one line rather than leaving one word alone on the second
  if (full.length <= 34) return [full];
  const w = full.split(' ');
  if (w.length < 3) return [full];
  const mid = Math.ceil(w.length / 2);
  return [w.slice(0, mid).join(' '), w.slice(mid).join(' ')];
})();

const jsonLd = recipe
  ? recipeJsonLd({
      name: plain(d.title),
      description: d.excerpt,
      url,
      datePublished: d.date.toISOString().slice(0, 10),
      author: author.href ? { name: author.name, url: new URL(author.href, site.url).href } : null,
      recipe,
      category: 'Main course',
    })
  : {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: plain(d.title),
      description: d.excerpt,
      url,
      datePublished: d.date.toISOString().slice(0, 10),
      ...(d.date_modified ? { dateModified: d.date_modified.toISOString().slice(0, 10) } : {}),
      author: author.href
        ? { '@type': 'Person', name: author.name, jobTitle: author.role, url: new URL(author.href, site.url).href }
        : { '@type': 'Organization', name: 'La maréa' },
      publisher: { '@type': 'Organization', name: 'La maréa', url: site.url },
      articleSection: d.category,
      wordCount: body.split(/\s+/).length,
      ...(d.references.length ? { citation: d.references.flatMap((g) => g.entries) } : {}),
    };
---
<Base title={title} description={d.excerpt.length <= 155 ? d.excerpt : `${d.excerpt.slice(0, d.excerpt.lastIndexOf(' ', 150))}…`} headerTone="over-media" ogType="article" jsonLd={jsonLd}>
  <PageOpener media={d.hero} lines={openerLines} eyebrow={d.category} caption={`${formatDate(d.date)}, ${minutes} minute read`} shadeAt="bottom-left" height="tall" class="post-opener" />

  <article class="post">
    <div class="wrap post__grid">
      <aside class="post__aside" aria-label="About this story">
        <Breadcrumbs items={[{ label: 'Journal and recipes', href: '/journal' }, { label: shortTitle }]} class="post__crumbs" />
        <dl class="post__meta">
          <div><dt>Published</dt><dd><time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date)}</time></dd></div>
          <div><dt>Reading time</dt><dd>{minutes} minute{minutes === 1 ? '' : 's'}</dd></div>
          <div>
            <dt>Written by</dt>
            <dd>
              {author.href ? <a class="text-link" href={author.href}>{author.name}</a> : author.name}
              {d.byline && <span class="post__role">{d.byline.role}</span>}
              {d.byline && <span class="post__role">{d.byline.credentials}</span>}
              {!d.byline && authorPerson && <span class="post__role">{authorPerson.data.role_long ?? authorPerson.data.role}</span>}
            </dd>
          </div>
        </dl>
        {showContents && (
          <details class="post__toc" data-post-toc>
            <summary>
              <span class="post__toc-title">In this story</span>
              <span class="post__toc-now" data-toc-now>{contents[0].text.replace(/\.$/, '')}</span>
            </summary>
            <ol role="list">
              {contents.map((h) => <li class:list={[h.level === 2 && 'post__toc-major']}><a href={`#${h.id}`} data-toc-link={h.id}>{h.text.replace(/\.$/, '')}</a></li>)}
            </ol>
          </details>
        )}
      </aside>

      <div class="post__main">
        {recipe ? (
          <>
            <div class="prose prose--intro" set:html={introHtml} />
            <RecipeBlock recipe={recipe} />
          </>
        ) : (
          <>
            <div class="prose" set:html={html[0]} />
            {html.length > 1 && credit && (
              <>
                <figure class="post__figure">
                  <div><Media media={INLINE[post.id] ?? d.hero} aspect="21 / 9" sizes="(max-width: 999px) 100vw, 90vw" /></div>
                  <figcaption>Image credit: {credit}</figcaption>
                </figure>
                <div class="prose" set:html={html[1]} />
              </>
            )}
          </>
        )}

        {d.references.length > 0 && <References groups={d.references} />}
        {aboutAuthor && (
          <section class="post__author" aria-labelledby="about-author">
            <h2 id="about-author" class="post__author-title">About the Author</h2>
            <div class="post__author-body" set:html={renderMarkdown(aboutAuthor, { demote: 1 })} />
          </section>
        )}
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section band-salt" aria-labelledby="related-heading">
      <div class="wrap">
        <SectionHead id="related-heading" eyebrow="Keep reading" heading="More from the journal" />
      </div>
      <JournalCards posts={related} variant="slider" label="More from the journal" id="related-stories" />
    </section>
  )}

  <ClosingTide line={CTA[d.category] ?? 'Plan a day on the *Fleurieu*'} lineDraft params={{ source: `journal-${post.id}` }} />
</Base>

<script>
  // "In this story" shows only the heading being read; the full list opens beneath it.
  document.querySelectorAll<HTMLDetailsElement>('[data-post-toc]').forEach((toc) => {
    const now = toc.querySelector<HTMLElement>('[data-toc-now]');
    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    const heads = links.map((a) => document.getElementById(a.dataset.tocLink ?? '')).filter((h): h is HTMLElement => Boolean(h));
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const a = links.find((l) => l.dataset.tocLink === e.target.id);
        if (!a || !now) return;
        now.textContent = a.textContent;
        links.forEach((l) => l.toggleAttribute('aria-current', l === a));
      });
    }, { rootMargin: '0px 0px -70% 0px' });
    heads.forEach((h) => io.observe(h));
    links.forEach((l) => l.addEventListener('click', () => (toc.open = false)));
  });
</script>

<style>
  /* J2: a story title is long, so it sets smaller than a page title and its second clause smaller again,
     each line on its own sand glass panel from PageOpener (G1). */
  :global(.post-opener .po__title) { font-size: clamp(1.85rem, 0.9rem + 2.3vw, 3.1rem); line-height: 1.08; max-width: 22em; }
  :global(.post-opener .po__line--2) { font-size: 0.62em; padding-left: 0.6em; margin-top: 0.35em; }
  @media (max-width: 699px) { :global(.post-opener .po__title) { font-size: clamp(1.7rem, 1rem + 3.6vw, 2.1rem); } }
  /* A story title wraps, and an inline-block panel then spans the whole column. Set inline and cloned,
     each wrapped row gets its own panel fitted to its words, with enough line height that rows never overlap.
     An inline box blurs its whole bounding rectangle, so these panels drop the blur and are a little more opaque. */
  :global(.post-opener .po__line-in) { display: inline; -webkit-box-decoration-break: clone; box-decoration-break: clone; line-height: 1.52; padding: 0.04em 0.3em 0.1em; --panel-a: 0.86; -webkit-backdrop-filter: none; backdrop-filter: none; }

  .post__author { margin-top: clamp(2.5rem, 5vw, 3.5rem); padding: clamp(1.5rem, 3vw, 2.25rem); background: var(--salt-25); max-width: 40rem; }
  .post__author-title { margin: 0 0 0.75rem; font-family: var(--font-ui); font-size: var(--fs-label); letter-spacing: var(--track-label); line-height: var(--lh-label); font-weight: 400; color: var(--muted); }
  .post__author-body :global(p) { margin: 0; font-size: var(--fs-small); line-height: 1.65; color: var(--sage-100); }

  /* Recipe facts on a phone: serves, prep and cook in one row of three, not two plus one */
  @media (max-width: 599px) {
    .post :global(.recipe__facts) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .post :global(.recipe__facts > div) { margin: 0; padding: 0.9rem 0.75rem 1rem; }
    .post :global(.recipe__facts > div:first-child) { padding-left: 0; }
    .post :global(.recipe__facts dd) { font-size: 1.05rem; white-space: nowrap; }
  }

  .post { padding: clamp(1.5rem, 3vw, 2.5rem) 0 var(--section-y); }
  .post__grid { display: grid; gap: var(--space-l) clamp(2rem, 6vw, 7rem); align-items: start; }
  .post :global(.post__crumbs) { margin-bottom: 1.25rem; }
  .post__meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: 1rem 1.5rem; margin: 0; padding-top: 1.1rem; border-top: 1px solid var(--rule); }
  .post__meta dt { margin-bottom: 0.35rem; font-family: var(--font-ui); font-size: var(--fs-label); letter-spacing: var(--track-label); color: var(--muted); }
  .post__meta dd { margin: 0; font-size: var(--fs-small); line-height: 1.5; color: var(--sage-100); }
  .post__role { display: block; margin-top: 0.3rem; font-size: 0.78rem; color: var(--sage-80); }

  .post__toc { margin-top: 1.75rem; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .post__toc summary { display: grid; gap: 0.3rem; padding: 0.9rem 0; cursor: pointer; list-style: none; }
  .post__toc summary::-webkit-details-marker { display: none; }
  .post__toc-title { font-family: var(--font-ui); font-size: var(--fs-label); letter-spacing: var(--track-label); color: var(--muted); }
  .post__toc-now { font-family: var(--font-editorial); font-style: italic; font-size: 1.125rem; line-height: 1.35; color: var(--heading); }
  .post__toc ol { margin: 0; padding: 0 0 0.75rem; list-style: none; }
  .post__toc a { display: block; padding: 0.35rem 0; font-size: 0.8125rem; line-height: 1.4; color: var(--sage-80); text-decoration: none; }
  .post__toc a[aria-current] { color: var(--heading); }
  .post__toc-major a { color: var(--heading); padding-top: 0.55rem; }
  @media (hover: hover) { .post__toc a:hover { color: var(--sage-100); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.25em; } }
  @media (max-width: 999px) { .post__toc { display: none; } }

  @media (min-width: 1000px) {
    .post__grid { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); }
    .post__aside { position: sticky; top: calc(var(--header-compact) + 1.5rem); max-height: calc(100svh - var(--header-compact) - 3rem); overflow-y: auto; scrollbar-width: thin; padding-right: 0.5rem; }
    .post__meta { grid-template-columns: minmax(0, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) { .post__toc a { transition: none; } }

  /* The body: Belle's words at reading width, headings stepped down under the title */
  .prose { max-width: 40rem; color: var(--sage-100); }
  .prose :global(p) { max-width: none; margin: 0 0 1.15em; }
  .prose--intro :global(p:first-child), .prose:first-child :global(> p:first-child) { font-family: var(--font-serif); font-size: var(--fs-lead); line-height: 1.5; }
  .prose :global(h2) { margin: 2.2em 0 0.7em; font-size: max(1.75rem, var(--fs-h3)); line-height: 1.2; }
  .prose :global(h3) { margin: 2em 0 0.6em; font-family: var(--font-serif); font-size: clamp(1.4rem, 1.25rem + 0.5vw, 1.7rem); line-height: 1.25; letter-spacing: 0.005em; color: var(--heading); }
  .prose :global(h4) { margin: 1.6em 0 0.5em; font-family: var(--font-serif); font-size: 1.25rem; line-height: 1.3; color: var(--heading); }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1.2em; padding-left: 1.2rem; }
  .prose :global(li) { margin-bottom: 0.4em; }
  .prose :global(li::marker) { color: var(--sage-60); }
  .prose :global(a) { color: var(--heading); text-decoration-color: color-mix(in srgb, currentColor 40%, transparent); }
  .prose :global(strong) { color: var(--sage-100); }

  .post__figure { margin: clamp(2.5rem, 6vw, 5rem) 0; }
  @media (min-width: 1000px) {
    /* One image per story breaks out of the reading column and bleeds off the right edge of the page. */
    .post__figure { width: calc(100% + max(var(--gutter), (100vw - var(--wrap-max)) / 2 + var(--gutter))); }
    .post__figure figcaption { padding-right: var(--gutter); }
  }
  .post__figure figcaption { margin-top: 0.8rem; font-family: var(--font-ui); font-size: var(--fs-label); letter-spacing: 0.06em; color: var(--muted); }
</style>
