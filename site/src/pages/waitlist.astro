---
/*
  /waitlist (page builder D). On-domain waitlists replacing the two off-domain Jotforms
  (plan/11 4.25, register P13): 261441165546860 ("Join 2026 Waitlist", home page, Sunset Reset) and
  253041258182856 ("Join The Waitlist", the contact page and the Women's Wellness Weekend).
  Only the waitlists the live site shows as open are offered, each with Belle's own waitlist line
  verbatim. Which stay is decision 22. A waitlist join is not an enquiry and never starts the funnel.
  Preselect a list with ?list=sunset-reset, womens-wellness-weekend or retreat-releases.
  noindex: a utility page reached from links, not search.
*/
import Base from '../layouts/Base.astro';
import PageIntro from '../components/pages/d/PageIntro.astro';
import ListCapture from '../components/pages/d/ListCapture.astro';
import ReviewNote from '../components/pages/d/ReviewNote.astro';
import ArrowLink from '../components/base/ArrowLink.astro';

const choices = [
  {
    value: 'sunset-reset',
    label: 'Sunset Reset',
    meta: 'An evening by the sea, 3 hours',
    draft: true,
    description: 'Place your name on our waitlist to be the first to hear about upcoming exclusive Sunset Reset experiences, and future La maréa experience offerings.',
  },
  {
    value: 'womens-wellness-weekend',
    label: 'Women’s Wellness Weekend',
    meta: 'For women seeking space to restore, reconnect and return to rhythm.',
    description: 'Join the waitlist to receive upcoming dates and early access to bookings.',
  },
  {
    value: 'retreat-releases',
    label: 'Retreat releases',
    description: 'Join our retreat waitlist so you never miss out on retreat releases!',
  },
];
const count = ['No', 'One', 'Two', 'Three', 'Four', 'Five'][choices.length] ?? String(choices.length);
---
<Base
  title="Retreat waitlists, Fleurieu Peninsula"
  description="Join a La maréa waitlist to hear first about Sunset Reset evenings, the Women’s Wellness Weekend and new retreat releases."
  noindex
>
  <PageIntro
    size="compact"
    eyebrow="Waitlists"
    heading="Join a waitlist"
    lead="Choose a waitlist and leave your email. We will write when dates are released."
    leadDraft
    media="waitlist-intro"
  />

  <section class="section section--flush-top wrap">
    <div class="wl">
      <div class="wl__aside">
        <h2 class="wl__title">{count} waitlists</h2>
        <p class="small wl__alt" data-draft>For a private group or a corporate team, planning a day starts with a few questions instead.</p>
        <ArrowLink href="/enquire?source=waitlist" label="Plan your day" />
      </div>
      <div class="wl__form">
        <ListCapture
          list="waitlist"
          choices={choices}
          choiceLegend="Which waitlist"
          firstName
          layout="stacked"
          submitLabel="Join the waitlist"
          successMessage="Thank you. You are on the waitlist, and we will write when dates are released."
        />
        <ReviewNote>These are the waitlists the live site shows as open: Sunset Reset (home page), the Women’s Wellness Weekend (retreats page) and the retreat waitlist (contact page). Which stay is decision 22. They replace Jotforms 261441165546860 and 253041258182856; Belle swaps those links in her Instagram bio and emails.</ReviewNote>
      </div>
    </div>
  </section>
</Base>

<style>
  .wl { display: grid; gap: var(--space-l); padding-top: clamp(1rem, 2vw, 2rem); border-top: 1px solid var(--sage-20); }
  .wl__title { margin: 0; font-size: var(--fs-h2); }
  .wl__alt { margin: 1.25rem 0 0.5rem; max-width: 22rem; color: var(--sage-100); }
  .wl__form { max-width: 34rem; }
  @media (min-width: 900px) {
    .wl { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2.5rem, 5vw, 6.5rem); padding-top: clamp(2rem, 3vw, 3rem); }
  }
</style>
