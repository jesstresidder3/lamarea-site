---
/*
  /rising-tides-collective (page builder D). plan/11 4.21 with the pre-build review applied (D7:
  no "member access opens in 2027" and no login reference anywhere).
  Sources: the one live sentence (lamarea.com.au/luxury-retreats, verbatim) and Belle's transcript
  (BD-49, BD-50): members get "first release retreats... recipes, resources"; "You can't just choose
  to... come into this", "attend a wellness retreat, and then you automatically... come into this
  private collective". One line per benefit is drafted and marked (plan/11 item 69).
  The page reads correctly whether members end up in a site area or the app (K5, Belle decides).
*/
import Base from '../layouts/Base.astro';
import PageOpener from '../components/base/PageOpener.astro';
import OffsetPair from '../components/base/OffsetPair.astro';
import ClosingTide from '../components/base/ClosingTide.astro';
import ArrowLink from '../components/base/ArrowLink.astro';
import Eyebrow from '../components/base/Eyebrow.astro';
import SectionHead from '../components/base/SectionHead.astro';
import NumberedMoments from '../components/base/NumberedMoments.astro';
import Reveal from '../components/base/Reveal.astro';
import Media from '../components/media/Media.astro';
import Statement from '../components/pages/d/Statement.astro';
import ReviewNote from '../components/pages/d/ReviewNote.astro';

const benefits = [
  {
    title: 'First release retreats',
    text: 'Members hear about new La maréa retreats before they are released to everyone else.',
    draft: true,
  },
  {
    title: 'Recipes',
    text: 'Seasonal, plant-based Mediterranean recipes to cook at home between retreats.',
    draft: true,
  },
  {
    title: 'Resources',
    text: 'Lifestyle wellness resources from the La maréa team, to keep the habits from your retreat going.',
    draft: true,
  },
];
---
<Base
  title="Rising Tides Collective"
  description="The Rising Tides Collective is La maréa’s private space for past guests of its Fleurieu Peninsula retreats. Membership comes with attending a retreat."
>
  <PageOpener
    media="collective-opener"
    lines={['The Rising', 'Tides', 'Collective']}
    eyebrow="A private collective"
    shadeAt="top-left"
    caption="Fleurieu Peninsula"
  />

  <section class="section wrap" aria-labelledby="collective-what">
    <Reveal>
      <Statement
        id="collective-what"
        label="What it is"
        text="A private space for those who’ve already experienced La maréa, through one of our retreats or experiences, and looking to stay close between them."
      />
    </Reveal>
  </section>

  <section class="section band-salt">
    <div class="wrap receive">
      <SectionHead eyebrow="For members" heading="What members receive" class="receive__head" />
      <NumberedMoments items={benefits} slide />
    </div>
  </section>

  <section class="section collective-join" aria-labelledby="join-heading">
    <OffsetPair large="collective-join" detail="collective-recipes" side="right" caption="The shared table">
      <Eyebrow>Membership</Eyebrow>
      <h2 id="join-heading">How you join</h2>
      <p data-draft>Membership cannot be bought or chosen. You join by attending a La maréa retreat or experience, and every guest becomes a member automatically afterwards.</p>
      <ReviewNote>Where members find the recipes and resources, a site area or the app, is Belle’s decision (K5). This page reads the same either way and names no login and no dates.</ReviewNote>
      <ArrowLink href="/app" label="The La maréa app" />
    </OffsetPair>
  </section>

  <ClosingTide line="Begin with a day on the *Fleurieu*" lineDraft params={{ source: 'collective' }} />
</Base>

<style>
  .receive { display: grid; gap: var(--space-l); }
  .receive :global(.receive__head) { margin-bottom: 0; }
  @media (min-width: 900px) {
    .receive { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: clamp(2rem, 6vw, 7.5rem); align-items: start; }
    .receive :global(.receive__head) { position: sticky; top: calc(var(--header-compact) + 2.5rem); }
  }
  .collective-join :global(.opair__text p) { color: var(--sage-100); max-width: 30rem; }
  .collective-join :global(.opair__text h2) { margin: 0.5rem 0 1.25rem; }
</style>
