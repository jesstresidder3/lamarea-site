---
/*
  /places/<slug>, one page per published venue (plan/11 4.10, build spec 12 and 7, page builder C).
  Built from the venues collection, so a venue Belle adds is a new page with no code change. Hidden
  venues (The Vineyard Retreat) generate no page.

  Order: hero (Naiko Deep Creek opens on the bath shot, BD-111), the venue at a glance, about the
  place, within the venue (SteppedGallery), what is around it, a day here, proof from this venue when
  a review names it, the other Places to Pause, then "Plan your day" prefilled with the venue.
  No mini map (build spec 12: the map lives on home, /places and the Fleurieu page).

  voice-verbatim-source: the `about`, `features` and `nearby` text in src/content/venues/*.json
  (La maréa's accommodation partners page, the Encounter Bay guide, the venues' own sites), and
  src/components/pages/c/venue-extras.ts for each venue's day. Drafted lines carry data-draft.
*/
import Base from '../../layouts/Base.astro';
import PageOpener from '../../components/base/PageOpener.astro';
import Handover from '../../components/base/Handover.astro';
import ClosingTide from '../../components/base/ClosingTide.astro';
import FrameSlider from '../../components/pages/c/FrameSlider.astro';
import FactLine from '../../components/pages/c/FactLine.astro';
import { venueMedia } from '../../components/pages/c/venue-media';
import { media as getMedia } from '../../data/media';
import Breadcrumbs from '../../components/base/Breadcrumbs.astro';
import Eyebrow from '../../components/base/Eyebrow.astro';
import ArrowLink from '../../components/base/ArrowLink.astro';
import Reveal from '../../components/base/Reveal.astro';
import SteppedGallery from '../../components/venues/SteppedGallery.astro';
import Testimonials from '../../components/testimonials/Testimonials.astro';
import VenueAround from '../../components/pages/c/VenueAround.astro';
import VenueDay from '../../components/pages/c/VenueDay.astro';
import NoteFlag from '../../components/pages/c/NoteFlag.astro';
import { extrasFor } from '../../components/pages/c/venue-extras';
import { emphasis } from '../../components/base/text';
import { getVenues, getTestimonials, type Venue } from '../../lib/content';
import { regionLabel, sleepsLabel } from '../../lib/text';
import slots from '../../data/media';
import { site, cta } from '../../data/settings';

export async function getStaticPaths() {
  const venues = await getVenues();
  return venues.map((venue) => ({ params: { slug: venue.id }, props: { venue } }));
}

interface Props { venue: Venue }
const { venue } = Astro.props;
const d = venue.data;
const extra = extrasFor(venue.id, d.name, d.location_label);
const hasSlot = (id: string) => slots.some((s) => s.id === id);

const heroSlot = hasSlot(`venue-hero-${venue.id}`) ? `venue-hero-${venue.id}` : d.card_media;
const aroundSlot = hasSlot(`venue-around-${venue.id}`) ? `venue-around-${venue.id}` : d.map_media;

// What is around it: the venue's surroundings, plus the features that sit outside the house.
// A feature shown here leaves the gallery, and nothing with the same words appears twice.
const KIND: Record<string, string> = { park: 'Parks', trail: 'Walking', wildlife: 'Wildlife', cellar_door: 'Cellar door on the estate', dining: 'Dining on the estate', town: 'Town' };
const kindOf = (name: string, kind?: string) =>
  (kind && KIND[kind]) ||
  (/beach/i.test(name) ? 'The beach' : /trail|walk/i.test(name) ? 'Walking' : /vineyard/i.test(name) ? 'The vines' : /bluff|coast/i.test(name) ? 'The coast' : 'On the estate');
const moved = d.features.filter((f) => extra.aroundFromFeatures?.includes(f.name));
const around: { name: string; kind: string; text: string | null }[] = [];
for (const n of d.nearby) {
  const replace = moved.find((f) => f.text === n.text);
  const name = replace?.name ?? n.name;
  // "Tasting Pavilion ... Open 7 days" keeps only the part after the name; a bare name keeps no text.
  let text: string | null = n.text.replace(/^.*?\.\.\.\s*/, '');
  if (text.trim() === n.name.trim()) text = null;
  around.push({ name, kind: kindOf(name, n.kind), text });
}
for (const f of moved) if (!around.some((a) => a.text === f.text)) around.push({ name: f.name, kind: kindOf(f.name), text: f.text });

const nearbyTexts = new Set(d.nearby.map((n) => n.text));
const hasPhoto = (id?: string) => { if (!id) return false; const m = getMedia(id); return Boolean(m.src || m.poster); };
// P7: a feature without a photograph leaves the gallery (its words stay in the venue's own facts).
const gallery = d.features.filter((f) => !extra.aroundFromFeatures?.includes(f.name) && !nearbyTexts.has(f.text) && hasPhoto(f.media));

/* L3 rebuild 28-09-2026: the opener, the rooms slider, the handover frame and the facts as one line. */
const vm = venueMedia[venue.id];
const openerSlot = vm && hasPhoto(vm.opener) ? vm.opener : heroSlot;
const rooms = (vm?.rooms ?? []).filter((r) => hasPhoto(r.media) && !gallery.some((g) => g.media === r.media));
// Setting and the drive first, then the day capacity, the place, and sleeps last and quieter: the
// product is a day, so an overnight number should not lead (audience review).
const facts = [
  { k: 'Setting', v: regionLabel(d.region) },
  ...(d.drive_from_adelaide ? [{ k: 'From Adelaide', v: d.drive_from_adelaide.text.replace(/ from Adelaide$/, '') }] : []),
  ...(d.day_capacity && d.day_capacity.min && d.day_capacity.max ? [{ k: 'Day retreats', v: `${d.day_capacity.min} to ${d.day_capacity.max} guests` }] : []),
  { k: 'Location', v: d.location_label },
  { k: 'Partner', v: d.partner_label },
  ...(d.sleeps.display ? [{ k: 'Sleeps', v: d.sleeps.display, quiet: true }] : []),
];

const reviews = (await getTestimonials()).filter((t) => t.data.venue === venue.id);
const others = (await getVenues()).filter((v) => v.id !== venue.id);

// The first paragraph opens as a lead. A long one gives the lead its first sentence only and carries
// on at body size, so the lead stays a lead (the words are unchanged).
const paras = d.about.map((a) => a.text);
let lead = paras[0] ?? null;
const restAbout = paras.slice(1);
if (lead && lead.split(/\s+/).length > 30) {
  const cut = lead.search(/\.\s/);
  if (cut > 0) {
    restAbout.unshift(lead.slice(cut + 2));
    lead = lead.slice(0, cut + 1);
  }
}
const area = (d.location_label.split(',').pop() ?? '').replace(' Peninsula', '').trim();
const description = d.intro
  ? d.intro.text.length < 100
    ? `${d.intro.text} ${sleepsLabel(d.sleeps.display)}, ${d.location_label}.`
    : d.intro.text
  : `${d.name}, ${d.location_label}. A La maréa partner venue.`;

const url = new URL(`/places/${venue.id}`, site.url).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: d.name_as_published_by_venue ?? d.name,
  alternateName: d.name,
  url,
  description,
  ...(d.address ? { address: { '@type': 'PostalAddress', streetAddress: d.address, addressRegion: 'SA', addressCountry: 'AU' } } : {}),
  ...(d.coordinates ? { geo: { '@type': 'GeoCoordinates', latitude: d.coordinates.lat, longitude: d.coordinates.lng } } : {}),
  containedInPlace: { '@type': 'Place', name: d.location_label },
};

const flags = [
  ...(d.partner_approved ? [] : ['Partner approval pending: shown in the prototype only (open decision 8).']),
  ...(d.sleeps.conflict ? [d.sleeps.conflict] : []),
  ...(extra.flags ?? []),
];
---
<Base title={`${d.name}, ${area} retreat venue`} description={description} headerTone="over-media" jsonLd={jsonLd}>
  <PageOpener media={openerSlot} lines={d.name.startsWith('Naiko ') ? ['Naiko', `*${d.name.slice(6)}*`] : [d.name]} eyebrow={regionLabel(d.region)} caption={vm?.openerCaption} shadeAt={vm?.shadeAt ?? 'top-left'} id="venue-title" />

  <section class="section venue-top">
    <div class="wrap">
      <Breadcrumbs items={[{ label: 'Venues', href: '/places' }, { label: d.name }]} class="venue-crumbs" />
      <FactLine items={facts} label={`${d.name} at a glance`} />
    </div>
  </section>

  <section class="section section--flush-top venue-about" aria-labelledby="about-heading">
    <div class="wrap about">
      <div class="about__head">
        <Eyebrow>About the place</Eyebrow>
        <h2 class="about__heading" id="about-heading" set:html={emphasis(extra.aboutHeading)} />
      </div>
      <Reveal class="about__body">
        {lead && <p class="about__lead">{lead}</p>}
        {restAbout.map((p) => <p>{p}</p>)}
        {extra.aboutDraft?.map((p) => <p data-draft>{p.text}</p>)}
        <NoteFlag items={flags} />
      </Reveal>
    </div>
  </section>

  {rooms.length >= 2 && (
    <section class="section section--flush-top venue-rooms" aria-label={`Inside ${d.name}`}>
      <FrameSlider items={rooms.map((r) => ({ media: r.media, title: r.title }))} label={`Inside ${d.name}`} heading={`Inside ${d.name}`} />
    </section>
  )}

  {gallery.length > 0 && (
    <section class="section band-salt venue-within" aria-label={`Within ${d.name}`}>
      <div class="wrap">
        <SteppedGallery items={gallery} label="Within the venue" sublabel={d.name} aria={`${d.name}, within the venue`} id={`within-${venue.id}`} />
      </div>
    </section>
  )}

  {vm?.handover && hasPhoto(vm.handover.media) && (
    <Handover media={vm.handover.media} caption={vm.handover.caption} height="band" ground="sand" />
  )}

  {around.length > 0 && (
    <VenueAround heading={`Around *${extra.aroundPlace}*`} media={aroundSlot} items={around} id="around" />
  )}

  <div class="band-warm">
    <VenueDay day={extra.day} id="venue-day" />
  </div>

  {reviews.length > 0 && (
    <section class="section" aria-label={`From retreats at ${d.name}`}>
      <div class="wrap"><Eyebrow>From retreats here</Eyebrow></div>
      <Testimonials items={reviews} filters={false} label={`Reviews from ${d.name}`} />
    </section>
  )}

  {others.length > 0 && (
    <nav class="section section--tight others" aria-labelledby="others-heading">
      <div class="wrap others__grid">
        <p class="others__label" id="others-heading">Other Places to Pause</p>
        <ul class="others__list" role="list">
          {others.map((o) => (
            <li>
              <a class="others__link" href={`/places/${o.id}`}>
                <span class="others__name">{o.data.name}</span>
                <span class="others__meta">{regionLabel(o.data.region)}{o.data.drive_from_adelaide ? `, ${o.data.drive_from_adelaide.text.charAt(0).toLowerCase()}${o.data.drive_from_adelaide.text.slice(1)}` : ''}</span>
                <svg width="28" height="10" viewBox="0 0 28 10" aria-hidden="true" focusable="false"><line x1="0.5" y1="5" x2="27.25" y2="5" /><polyline points="22.25,0.5 27.25,5 22.25,9.5" /></svg>
              </a>
            </li>
          ))}
        </ul>
        <ArrowLink href="/places" label="All venues" class="others__all" />
      </div>
    </nav>
  )}

  <ClosingTide
    line={`Bring your group to *${extra.ctaPlace}*`}
    lead="Plan your day here"
    params={{ venue: venue.id, source: 'venue' }}
    lineDraft
    leadDraft
    media={vm?.closing ?? 'closing-tide'}
  />
</Base>

<style>
  .venue-top { padding-top: clamp(1.5rem, 3vw, 2.5rem); padding-bottom: var(--space-2xl); }
  .venue-rooms { padding-bottom: var(--section-y); }
  .venue-top :global(.venue-crumbs) { margin-bottom: clamp(1rem, 2vw, 1.75rem); }

  .about { display: grid; gap: var(--space-m) clamp(2rem, 6vw, 7.5rem); }
  .about__heading { margin: 0; max-width: 11em; }
  .about__lead { font-family: var(--font-serif); font-size: clamp(1.3rem, 1.1rem + 0.7vw, 1.75rem); line-height: 1.4; color: var(--sage-100); max-width: 34rem; margin-bottom: 1.5rem; }
  .venue-about :global(.about__body) p:not(.about__lead) { color: var(--sage-100); }
  @media (min-width: 900px) {
    .about { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); }
    .venue-about :global(.about__body) { padding-top: calc(var(--fs-label) * var(--lh-label) + 1.25rem); }
  }

  .others { border-top: 1px solid var(--rule); }
  .others__grid { display: grid; gap: 1.25rem clamp(2rem, 6vw, 7.5rem); align-items: start; }
  .others__label { margin: 0; font-family: var(--font-ui); font-size: var(--fs-label); letter-spacing: var(--track-label); color: var(--muted); padding-top: 1rem; }
  .others__list { margin: 0; padding: 0; list-style: none; }
  .others__link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'name arrow' 'meta arrow';
    align-items: center;
    gap: 0.2rem 1.5rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
    color: var(--heading);
    text-decoration: none;
  }
  .others__name { grid-area: name; font-family: var(--font-display); font-size: var(--fs-card); line-height: 1.2; }
  .others__meta { grid-area: meta; font-family: var(--font-ui); font-size: var(--fs-label); letter-spacing: 0.06em; color: var(--muted); }
  .others__link svg { grid-area: arrow; overflow: visible; }
  .others__link :is(line, polyline) { fill: none; stroke: currentColor; stroke-width: 1; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; transition: transform var(--dur-fast) var(--ease-soft); }
  @media (hover: hover) { .others__link:hover polyline { transform: translateX(6px); } }
  .others__link:focus-visible polyline, .others__link:active polyline { transform: translateX(6px); }
  .others :global(.others__all) { margin-top: 0.5rem; }
  @media (min-width: 900px) {
    .others__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); }
    .others :global(.others__all) { grid-column: 2; }
  }
  @media (prefers-reduced-motion: reduce) { .others__link :is(line, polyline) { transition: none; } }
</style>
