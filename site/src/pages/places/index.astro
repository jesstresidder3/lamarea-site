---
/*
  /places, Places to Pause (plan/11 4.9 with build spec 12, page builder C).
  voice-verbatim-source: lamarea.com.au/accommodation-partners (captured 24-09-2026): the intro,
  "La maréa retreats are intentionally limited and venue selection is highly considered.", the
  "Curated partnerships" heading and the "Where aligned in values..." lines, and the personalisation
  line. Belle, transcript: "I'm going to be adding accommodation venues over time" (BD-21).
  Drafted lines carry data-draft. No venue count anywhere (build spec 12): the page reads the
  collection, so a venue Belle adds appears in the cards, the filter and the map with no code change.
*/
import Base from '../../layouts/Base.astro';
import PageOpener from '../../components/base/PageOpener.astro';
import OffsetPair from '../../components/base/OffsetPair.astro';
import ClosingTide from '../../components/base/ClosingTide.astro';
import ArrowLink from '../../components/base/ArrowLink.astro';
import SectionHead from '../../components/base/SectionHead.astro';
import Reveal from '../../components/base/Reveal.astro';
import VenueIndex from '../../components/venues/VenueIndex.astro';
import FleurieuMap from '../../components/map/FleurieuMap.astro';
import Statement from '../../components/pages/c/Statement.astro';
import { getVenues } from '../../lib/content';
import { site } from '../../data/settings';

const venues = await getVenues();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Places to Pause, La maréa partner venues',
  itemListElement: venues.map((v, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: v.data.name,
    url: new URL(`/places/${v.id}`, site.url).href,
  })),
};
---
<Base
  title="Venues, Places to Pause on the Fleurieu"
  description="The partner venues for La maréa's 8 hour immersive retreat, on the coast at Deep Creek and Encounter Bay and among the vineyards of McLaren Vale."
  headerTone="over-media"
  jsonLd={jsonLd}
>
  <PageOpener
    media="c-places-opener"
    lines={['Places', 'to Pause']}
    sub="Our partner venues for the 8 hour immersive retreat, on the coast and in the vineyards of the Fleurieu Peninsula."
    subDraft
    caption="The Fleurieu Peninsula, South Australia"
    id="places-title"
  />

  <section class="section places-intro">
    <div class="wrap">
      <Statement
        label="Our accommodation partners"
        text="We collaborate with a select collection of exceptional luxury South Australian properties, each chosen for privacy, architectural integrity and deep connection to landscape."
        after="La maréa retreats are intentionally limited and venue selection is highly considered."
      />
    </div>
  </section>

  <section class="section section--flush-top" id="venues" aria-labelledby="venues-heading">
    <div class="wrap">
      <Reveal>
        <SectionHead id="venues-heading" eyebrow="Partner venues" heading="On the coast and in the vineyards" draft={{ heading: true }} />
      </Reveal>
      <VenueIndex venues={venues} id="places-index" />
    </div>
  </section>

  <section class="section places-map" aria-labelledby="map-heading">
    <div class="wrap">
      <Reveal>
        <SectionHead id="map-heading" eyebrow="Where they are" heading="Between the vines and the sea, south of *Adelaide*" draft={{ heading: true }} />
      </Reveal>
    </div>
    <FleurieuMap venues={venues} id="places-map" class="fmap--wide" />
    <div class="wrap places-map__more">
      <ArrowLink href="/fleurieu-peninsula-retreats" label="Where is the Fleurieu Peninsula?" />
    </div>
  </section>

  <section class="section places-curated" aria-labelledby="curated-heading" data-ground="warm">
    <OffsetPair large="c-be-yoga" detail="c-eb-walk" largeAspect="4 / 5" caption="Beresford Estate, McLaren Vale" detailCaption="Encounter Bay">
      <h2 id="curated-heading">Curated partnerships</h2>
      <p data-draft>More places will join the collection over time, each one chosen the same way.</p>
      <p>Where aligned in values and guest experience, we are open to curating retreats at other luxury venues upon request. If you have a setting in mind, we welcome the conversation to explore suitability.</p>
    </OffsetPair>
  </section>

  <ClosingTide
    line="Tell us who is coming, and we will suggest the place"
    lead="Guided by our personalisation pillar, each retreat location is carefully matched to the group and the retreat intention."
    params={{ source: 'places' }}
    media="c-dc-open-sea"
    lineDraft
  />
</Base>

<style>
  .places-intro { padding-bottom: calc(var(--section-y) * 0.75); }
  .places-map { padding-bottom: var(--section-y); }
  .places-map__more { margin-top: clamp(1.5rem, 3vw, 2.5rem); }
  .places-curated h2 { margin: 0 0 1.5rem; }
</style>
